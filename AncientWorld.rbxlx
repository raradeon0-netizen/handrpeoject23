<Item class="ModuleScript" referent="RBXSTEP50002">
<Properties>
<string name="Name">BlockLibrary</string>
<string name="Source"><![CDATA[--!strict
-- BlockLibrary: геометрия составных античных блоков (Prefabs).
-- Каждый префаб описан как список деталей (Part / WedgePart / CornerWedgePart / цилиндр)
-- со смещениями ОТНОСИТЕЛЬНО ЦЕНТРА габаритной коробки формы (BuildConfig.Shapes[id].size).
-- Модуль общий: сервер (BlockFactory) строит из него настоящие модели,
-- клиент (GhostPreview) — призрак той же формы, BuildGrid — коробки для проверки пересечений.
--
-- Роли деталей задают материал из палитры фракции (BuildConfig.FactionPalettes):
--   Main — основной камень, Trim — окантовка/второй камень,
--   Accent — золото (бронза), Detail — цветная вставка (бирюза Египта, порфир Рима, синь Греции).

local BuildConfig = require(script.Parent.BuildConfig)

export type Role = "Main" | "Trim" | "Accent" | "Detail"
export type PieceKind = "Block" | "Wedge" | "CornerWedge" | "Cylinder"

export type Piece = {
	kind: PieceKind,
	role: Role,
	size: Vector3, -- размер самой детали (для цилиндра ось — X)
	cframe: CFrame, -- положение относительно центра формы
	shade: number?, -- множитель яркости цвета роли (оттенки отдельных камней)
	material: Enum.Material?, -- свой материал вместо материала роли
	color: Color3?, -- свой цвет вместо цвета роли
}

export type Box = {
	cframe: CFrame, -- относительно центра формы
	size: Vector3,
}

type Builder = (factionId: string?) -> { Piece }
type Collision = "bounds" | "pieces"

type Prefab = {
	build: Builder,
	-- Чем проверять пересечения при установке: целой габаритной коробкой или
	-- коробками деталей (тогда под аркой/рядом со ступенями остаётся свободное место).
	collision: Collision,
}

local BlockLibrary = {}

-- ===== Калибровка клиньев =====
-- Чтобы пирамиды и скаты собирались правильно независимо от того, как движок
-- ориентирует WedgePart и CornerWedgePart, один раз «прощупываем» их лучами
-- и узнаём, где у клина высокая сторона, а у углового клина — вершина.

type Calibration = { wedgeHighZ: number, cornerX: number, cornerZ: number }

local PROBE_HEIGHT = 5000
local calibration: Calibration? = nil

local function probeHeights(className: string, points: { Vector2 }): { number }
	local probe = Instance.new(className :: any) :: BasePart
	probe.Anchored = true
	probe.CanCollide = false
	probe.CanTouch = false
	probe.CastShadow = false
	probe.Transparency = 1
	probe.Size = Vector3.new(4, 4, 4)
	probe.CFrame = CFrame.new(0, PROBE_HEIGHT, 0)
	probe.Parent = workspace

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { probe }

	local heights: { number } = {}
	for index, point in points do
		local origin = Vector3.new(point.X, PROBE_HEIGHT + 10, point.Y)
		local hit = workspace:Raycast(origin, Vector3.new(0, -20, 0), params)
		heights[index] = if hit then hit.Position.Y else -math.huge
	end
	probe:Destroy()
	return heights
end

local function calibrate(): Calibration
	local existing = calibration
	if existing then
		return existing
	end

	-- Клин: какая сторона по Z выше.
	local wedgeHighZ = 1
	local w = probeHeights("WedgePart", { Vector2.new(0, -1.6), Vector2.new(0, 1.6) })
	if w[1] > w[2] then
		wedgeHighZ = -1
	end

	-- Угловой клин: над каким углом основания вершина.
	local corners = { Vector2.new(-1, -1), Vector2.new(-1, 1), Vector2.new(1, -1), Vector2.new(1, 1) }
	local points: { Vector2 } = {}
	for index, c in corners do
		points[index] = c * 1.6
	end
	local heights = probeHeights("CornerWedgePart", points)
	local best, bestHeight = corners[3], -math.huge
	for index, h in heights do
		if h > bestHeight then
			best, bestHeight = corners[index], h
		end
	end

	local result: Calibration = { wedgeHighZ = wedgeHighZ, cornerX = best.X, cornerZ = best.Y }
	calibration = result
	return result
end

-- ===== Помощники построения =====

local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- ось цилиндра X -> вертикаль

local function add(list: { Piece }, kind: PieceKind, role: Role, size: Vector3, cframe: CFrame)
	table.insert(list, { kind = kind, role = role, size = size, cframe = cframe })
end

local function block(list: { Piece }, role: Role, sx: number, sy: number, sz: number, x: number, y: number, z: number)
	add(list, "Block", role, Vector3.new(sx, sy, sz), CFrame.new(x, y, z))
end

-- Камень кладки: бокс со своим оттенком и, при необходимости, своим материалом и цветом.
local function stone(
	list: { Piece },
	role: Role,
	size: Vector3,
	cframe: CFrame,
	shade: number?,
	material: Enum.Material?,
	color: Color3?
)
	table.insert(list, { kind = "Block", role = role, size = size, cframe = cframe, shade = shade, material = material, color = color })
end

-- Вертикальный цилиндр (диаметр, высота) с центром в (x, y, z).
local function cylinder(list: { Piece }, role: Role, diameter: number, height: number, x: number, y: number, z: number)
	add(list, "Cylinder", role, Vector3.new(height, diameter, diameter), CFrame.new(x, y, z) * VERTICAL)
end

-- Клин, высокая сторона которого смотрит в highToward (+1 = +Z, -1 = -Z) в осях cframe.
local function wedge(list: { Piece }, role: Role, size: Vector3, cframe: CFrame, highToward: number)
	local cal = calibrate()
	local flip = if cal.wedgeHighZ == highToward then CFrame.identity else CFrame.Angles(0, math.pi, 0)
	add(list, "Wedge", role, size, cframe * flip)
end

-- Угловой клин с основанием footprint (X, высота, Z) и вершиной над углом (apexX, apexZ).
local function cornerWedge(list: { Piece }, role: Role, footprint: Vector3, position: Vector3, apexX: number, apexZ: number)
	local cal = calibrate()
	for k = 0, 3 do
		local rotation = CFrame.Angles(0, k * math.pi / 2, 0)
		local v = rotation:VectorToWorldSpace(Vector3.new(cal.cornerX, 0, cal.cornerZ))
		if math.round(v.X) == apexX and math.round(v.Z) == apexZ then
			local size = if k % 2 == 1 then Vector3.new(footprint.Z, footprint.Y, footprint.X) else footprint
			add(list, "CornerWedge", role, size, CFrame.new(position) * rotation)
			return
		end
	end
end

-- Четырёхгранная пирамида из 4 угловых клиньев (вершины клиньев сходятся в центре).
-- inflate чуть расширяет основание — для «облицовки» поверх другой пирамиды без мерцания.
local function pyramid(list: { Piece }, role: Role, halfX: number, halfZ: number, height: number, baseY: number, inflate: number)
	local hx, hz = halfX + inflate, halfZ + inflate
	local cy = baseY + height / 2
	for _, qx in { -1, 1 } do
		for _, qz in { -1, 1 } do
			cornerWedge(list, role, Vector3.new(hx, height, hz), Vector3.new(qx * hx / 2, cy, qz * hz / 2), -qx, -qz)
		end
	end
end

-- ===== Префабы =====

-- Резная колонна: квадратная база, рифлёный (или составной) ствол и капитель.
-- Капитель зависит от фракции: Египет — лотос и пучок папируса, Греция — дорическая,
-- Рим — коринфская с золотыми листьями аканта.
local function column(height: number): Builder
	return function(factionId: string?): { Piece }
		local list: { Piece } = {}
		local y0 = -height / 2
		local top = height / 2

		-- База: квадратный плинт + торус + тонкое кольцо.
		block(list, "Trim", 4, 1, 4, 0, y0 + 0.5, 0)
		cylinder(list, "Main", 3.6, 0.5, 0, y0 + 1.25, 0)
		cylinder(list, "Trim", 3.1, 0.3, 0, y0 + 1.65, 0)

		local shaftBottom = y0 + 1.8
		local shaftTop = top - 2.2
		local shaftH = shaftTop - shaftBottom
		local shaftY = (shaftTop + shaftBottom) / 2

		if factionId == "Egypt" then
			-- Ствол — пучок стеблей папируса, перехваченный бирюзовыми лентами.
			cylinder(list, "Main", 2.0, shaftH, 0, shaftY, 0)
			for i = 0, 7 do
				local a = i * math.pi / 4
				cylinder(list, "Main", 0.9, shaftH, math.cos(a) * 0.95, shaftY, math.sin(a) * 0.95)
			end
			cylinder(list, "Detail", 2.95, 0.22, 0, shaftBottom + 0.3, 0)
			for k = 0, 2 do
				cylinder(list, "Detail", 2.95, 0.22, 0, shaftTop - 0.25 - k * 0.45, 0)
			end
			-- Капитель — раскрытый лотос с золотым поясом.
			cylinder(list, "Main", 2.8, 0.5, 0, shaftTop + 0.25, 0)
			cylinder(list, "Accent", 3.3, 0.6, 0, shaftTop + 0.8, 0)
			cylinder(list, "Main", 3.8, 0.6, 0, shaftTop + 1.4, 0)
			block(list, "Trim", 3, 0.5, 3, 0, top - 0.25, 0)
		elseif factionId == "Greece" then
			-- Дорический ордер: 12 каннелюр, эхин и квадратная абака.
			cylinder(list, "Main", 2.6, shaftH, 0, shaftY, 0)
			for i = 0, 11 do
				local cf = CFrame.new(0, shaftY, 0) * CFrame.Angles(0, i * math.pi / 6, 0) * CFrame.new(0, 0, 1.3)
				add(list, "Block", "Main", Vector3.new(0.34, shaftH, 0.34), cf)
			end
			cylinder(list, "Accent", 2.85, 0.3, 0, shaftTop + 0.15, 0)
			cylinder(list, "Main", 3.0, 0.3, 0, shaftTop + 0.45, 0)
			cylinder(list, "Main", 3.6, 0.6, 0, shaftTop + 0.9, 0)
			block(list, "Trim", 4, 1.0, 4, 0, top - 0.5, 0)
		else
			-- Рим (и по умолчанию): коринфский ордер — 16 каннелюр, колокол капители
			-- в два яруса золотых листьев аканта.
			cylinder(list, "Main", 2.6, shaftH, 0, shaftY, 0)
			for i = 0, 15 do
				local cf = CFrame.new(0, shaftY, 0) * CFrame.Angles(0, i * math.pi / 8, 0) * CFrame.new(0, 0, 1.3)
				add(list, "Block", "Trim", Vector3.new(0.26, shaftH, 0.26), cf)
			end
			cylinder(list, "Accent", 2.85, 0.2, 0, shaftTop + 0.1, 0)
			cylinder(list, "Main", 2.9, 1.2, 0, shaftTop + 0.8, 0)
			for tier = 0, 1 do
				for i = 0, 7 do
					local a = (i + tier * 0.5) * math.pi / 4
					local cf = CFrame.new(0, shaftTop + 0.55 + tier * 0.55, 0)
						* CFrame.Angles(0, a, 0)
						* CFrame.new(0, 0, 1.45)
						* CFrame.Angles(math.rad(15), 0, 0)
					add(list, "Block", "Accent", Vector3.new(0.6, 0.7, 0.25), cf)
				end
			end
			block(list, "Trim", 4, 0.8, 4, 0, top - 0.4, 0)
		end
		return list
	end
end

-- Обелиск 4x16x4: сужающийся ствол и золотой пирамидион из угловых клиньев.
local function obelisk(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 4, 1, 4, 0, -7.5, 0)
	block(list, "Detail", 3.4, 0.6, 3.4, 0, -6.7, 0)
	local segments = 6
	local bottom, topY = -6.4, 6
	local h = (topY - bottom) / segments
	for i = 0, segments - 1 do
		local width = 3.0 - (i + 0.5) / segments
		block(list, "Main", width, h, width, 0, bottom + h * (i + 0.5), 0)
	end
	pyramid(list, "Accent", 1.05, 1.05, 2, topY, 0)
	return list
end

-- Опоры арок (общие для круглой и ступенчатой).
local function archPiers(list: { Piece }, impostRole: Role)
	for _, sx in { -1, 1 } do
		block(list, "Trim", 3, 0.8, 4, sx * 4.5, -5.6, 0) -- база опоры
		block(list, "Main", 3, 5.8, 4, sx * 4.5, -2.3, 0) -- опора
		block(list, impostRole, 3, 0.4, 4, sx * 4.5, 0.8, 0) -- импост (пята свода)
	end
end

-- Античная арка 12x12x4: полукруглый свод из 9 клинчатых камней с золотым замковым камнем.
local function archRound(_factionId: string?): { Piece }
	local list: { Piece } = {}
	archPiers(list, "Accent")

	local cy, r, outer = 1.0, 3.0, 4.4 -- центр свода, внутренний и внешний радиусы
	local count = 9
	local mid = (r + outer) / 2
	local length = 2 * outer * math.sin(math.pi / (2 * count)) + 0.05
	for i = 0, count - 1 do
		local t = math.pi * (i + 0.5) / count
		local isKey = i == (count - 1) / 2
		local cf = CFrame.new(mid * math.cos(t), cy + mid * math.sin(t), 0) * CFrame.Angles(0, 0, t - math.pi / 2)
		add(list, "Block", if isKey then "Accent" else "Trim", Vector3.new(length, outer - r, 4), cf)
	end

	-- Пазухи свода: ступенчатое заполнение до карниза (утоплено на 0.1 за кольцо свода).
	local cornice = 5.4
	local band = 0.55
	for _, sx in { -1, 1 } do
		local x1 = 0
		while x1 < outer - 1e-6 do
			local x2 = math.min(x1 + band, outer)
			local bottomY = cy + math.sqrt(math.max(outer * outer - x2 * x2, 0))
			local h = cornice - bottomY
			if h > 0.01 then
				block(list, "Main", x2 - x1, h, 3.8, sx * (x1 + x2) / 2, bottomY + h / 2, 0)
			end
			x1 = x2
		end
		block(list, "Main", 6 - outer, cornice - cy, 3.8, sx * (outer + 6) / 2, (cy + cornice) / 2, 0)
	end
	block(list, "Trim", 12, 0.6, 4, 0, 5.7, 0) -- карниз
	return list
end

-- Ступенчатая (ложная) арка 12x12x4: свод из нависающих рядов камня, как в Египте.
local function archStepped(_factionId: string?): { Piece }
	local list: { Piece } = {}
	archPiers(list, "Detail")
	local rows = { { inner = 2.2, y = 1.0 }, { inner = 1.4, y = 2.2 }, { inner = 0.6, y = 3.4 } }
	for _, row in rows do
		for _, sx in { -1, 1 } do
			block(list, "Main", 6 - row.inner, 1.2, 4, sx * (row.inner + 6) / 2, row.y + 0.6, 0)
		end
	end
	block(list, "Trim", 12, 0.8, 4, 0, 5.0, 0) -- перемычка
	block(list, "Accent", 12, 0.6, 4, 0, 5.7, 0) -- золотой карниз
	return list
end

-- Лестница 8x4x8: 4 ступени, подъём к +Z (вращайте R), с кантом на каждой ступени.
local function stairs(_factionId: string?): { Piece }
	local list: { Piece } = {}
	for i = 1, 4 do
		local zFront = -4 + 2 * (i - 1)
		block(list, "Main", 8, i, 2, 0, -2 + i / 2, zFront + 1)
		block(list, "Trim", 7.9, 0.16, 0.32, 0, -2 + i - 0.07, zFront + 0.15)
	end
	return list
end

-- Пандус 8x4x8: плавный подъём (WedgePart) с бортиками.
local function ramp(_factionId: string?): { Piece }
	local list: { Piece } = {}
	wedge(list, "Main", Vector3.new(7, 4, 8), CFrame.identity, 1)
	wedge(list, "Trim", Vector3.new(0.5, 4, 8), CFrame.new(-3.75, 0, 0), 1)
	wedge(list, "Trim", Vector3.new(0.5, 4, 8), CFrame.new(3.75, 0, 0), 1)
	return list
end

-- Подиум храма (крепидома) 12x3x12: три ступени-основания.
local function crepidoma(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 12, 1, 12, 0, -1, 0)
	block(list, "Trim", 10, 1, 10, 0, 0, 0)
	block(list, "Main", 8, 1, 8, 0, 1, 0)
	return list
end

-- Пирамида 12x8x12: плинт, 4 угловых клина и золотое навершие.
local function pyramidPrefab(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 12, 0.5, 12, 0, -3.75, 0)
	pyramid(list, "Main", 6, 6, 7.5, -3.5, 0)
	-- Навершие — верхние 1.5 студа той же пирамиды, чуть шире, чтобы лечь поверх.
	pyramid(list, "Accent", 1.2, 1.2, 1.5, 2.5, 0.06)
	return list
end

-- Ступенчатая пирамида 12x8x12 (как пирамида Джосера) с золотой вершиной.
local function stepPyramid(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Main", 12, 2, 12, 0, -3, 0)
	block(list, "Trim", 9, 2, 9, 0, -1, 0)
	block(list, "Main", 6, 2, 6, 0, 1, 0)
	block(list, "Accent", 3, 2, 3, 0, 3, 0)
	return list
end

-- Фронтон / двускатная крыша 12x4x8: два клина, карниз, конёк и акротерии.
local function gableRoof(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 12, 0.6, 8, 0, -1.7, 0) -- карниз
	wedge(list, "Main", Vector3.new(12, 3.4, 4), CFrame.new(0, 0.3, -2), 1)
	wedge(list, "Main", Vector3.new(12, 3.4, 4), CFrame.new(0, 0.3, 2), -1)
	block(list, "Accent", 12, 0.3, 0.5, 0, 1.85, 0) -- конёк
	for _, sx in { -1, 1 } do
		block(list, "Accent", 0.5, 0.5, 0.5, sx * 5.75, 1.75, 0) -- акротерий на вершине
		for _, sz in { -1, 1 } do
			block(list, "Accent", 0.5, 0.4, 0.5, sx * 5.75, -1.2, sz * 3.75) -- угловые акротерии
		end
	end
	return list
end

-- Скат крыши 8x4x4: один клин (собирайте из них крыши и грани пирамид).
local function roofSlope(_factionId: string?): { Piece }
	local list: { Piece } = {}
	wedge(list, "Main", Vector3.new(8, 4, 4), CFrame.identity, 1)
	return list
end

-- Угол ската 4x4x4: угловой клин для углов пирамид и вальмовых крыш.
local function roofCorner(_factionId: string?): { Piece }
	local list: { Piece } = {}
	cornerWedge(list, "Main", Vector3.new(4, 4, 4), Vector3.zero, -1, 1)
	return list
end

-- Алтарь 8x4x4: пилястры по углам, цветные панели в золотой раме и золотой пояс.
local function altar(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 8, 0.6, 4, 0, -1.7, 0)
	block(list, "Main", 7, 2.6, 3, 0, -0.1, 0)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			block(list, "Trim", 0.6, 2.6, 0.6, sx * 3.45, -0.1, sz * 1.45)
		end
	end
	for _, sz in { -1, 1 } do
		block(list, "Detail", 4.4, 1.4, 0.1, 0, -0.1, sz * 1.53)
		block(list, "Accent", 4.8, 0.15, 0.14, 0, 0.675, sz * 1.55)
		block(list, "Accent", 4.8, 0.15, 0.14, 0, -0.875, sz * 1.55)
		block(list, "Accent", 0.15, 1.7, 0.14, -2.35, -0.1, sz * 1.55)
		block(list, "Accent", 0.15, 1.7, 0.14, 2.35, -0.1, sz * 1.55)
	end
	block(list, "Accent", 7.4, 0.3, 3.4, 0, 1.35, 0) -- золотой пояс
	block(list, "Main", 8, 0.5, 4, 0, 1.75, 0) -- столешница
	return list
end

-- Пьедестал 4x6x4: золотые рёбра, цветные панели и профилированный карниз.
local function pedestal(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 4, 0.8, 4, 0, -2.6, 0)
	block(list, "Main", 3.6, 0.4, 3.6, 0, -2.0, 0)
	block(list, "Main", 3, 3.6, 3, 0, 0, 0)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			block(list, "Accent", 0.25, 3.6, 0.25, sx * 1.45, 0, sz * 1.45)
		end
		block(list, "Detail", 1.8, 2.4, 0.08, 0, 0, sx * 1.52)
		block(list, "Detail", 0.08, 2.4, 1.8, sx * 1.52, 0, 0)
	end
	block(list, "Accent", 3.4, 0.3, 3.4, 0, 1.95, 0)
	block(list, "Main", 3.8, 0.5, 3.8, 0, 2.35, 0)
	block(list, "Trim", 4, 0.4, 4, 0, 2.8, 0)
	return list
end

-- ===== Резные (богато украшенные) варианты базовых блоков =====

-- Дорога 8x1x8 (вдоль Z): основание, брусчатка «вперевязку» и приподнятые резные бордюры по бокам.
-- Четыре ряда камней повторяют рисунок, поэтому плитки стыкуются друг с другом без шва.
local function ornateRoad(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 6.4, 0.5, 8, 0, -0.25, 0) -- основание под камнями

	local laneWidth, rows, perRow = 6.4, 4, 3
	local depth = 8 / rows
	local width = laneWidth / perRow
	local gap = 0.1
	for row = 0, rows - 1 do
		local z = -4 + depth * (row + 0.5)
		local shifted = row % 2 == 1
		-- Сдвинутый ряд: половинки по краям и целые камни между ними.
		local edges: { number } = {}
		if shifted then
			edges = { -laneWidth / 2, -laneWidth / 2 + width / 2 }
			for i = 1, perRow - 1 do
				table.insert(edges, -laneWidth / 2 + width / 2 + width * i)
			end
			table.insert(edges, laneWidth / 2)
		else
			for i = 0, perRow do
				table.insert(edges, -laneWidth / 2 + width * i)
			end
		end
		for i = 1, #edges - 1 do
			local left, right = edges[i], edges[i + 1]
			-- Камни чуть разной высоты и двух оттенков: живая, неровная кладка.
			local tall = (row + i) % 2 == 0
			local height = if tall then 0.3 else 0.24
			block(
				list,
				if tall then "Main" else "Trim",
				right - left - gap,
				height,
				depth - gap,
				(left + right) / 2,
				height / 2,
				z
			)
		end
	end

	for _, sx in { -1, 1 } do
		block(list, "Main", 0.8, 0.8, 8, sx * 3.6, -0.1, 0) -- бордюр
		for _, sz in { -1, 1 } do
			block(list, "Trim", 0.8, 0.2, 3.8, sx * 3.6, 0.4, sz * 2) -- резной верх бордюра
		end
		block(list, "Accent", 0.12, 0.12, 8, sx * 3.14, 0.36, 0) -- металлическая кромка у камней
	end
	return list
end

-- Резная стена 12x8x4: цоколь с профилем, рельефные пояса, утопленные панели между пилястрами
-- и золотая отделка. Обе стороны одинаковые.
local function ornateWall(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Trim", 12, 1, 4, 0, -3.5, 0) -- цоколь
	block(list, "Trim", 11.6, 0.4, 3.8, 0, -2.8, 0) -- профиль цоколя
	block(list, "Main", 11.2, 5.6, 3.2, 0, 0.2, 0) -- тело стены
	block(list, "Accent", 11.4, 0.25, 3.4, 0, 3.125, 0) -- золотой пояс под карнизом
	block(list, "Trim", 12, 0.75, 4, 0, 3.625, 0) -- карниз

	local pilasters = { -5.2, -1.7333, 1.7333, 5.2 }
	local panels = { -3.4667, 0, 3.4667 }
	for _, sz in { -1, 1 } do
		block(list, "Trim", 11.4, 0.3, 0.2, 0, -2.2, sz * 1.7) -- нижний рельефный пояс
		block(list, "Trim", 11.4, 0.3, 0.2, 0, 2.5, sz * 1.7) -- верхний рельефный пояс
		for _, x in pilasters do
			block(list, "Main", 0.8, 4.4, 0.4, x, 0.15, sz * 1.8)
		end
		-- Панели лежат глубже пилястр: получается ниша с цветной вставкой в золотой раме.
		for _, x in panels do
			block(list, "Detail", 2.3, 3.4, 0.1, x, 0.15, sz * 1.65)
			block(list, "Accent", 2.5, 0.12, 0.12, x, 1.97, sz * 1.72)
			block(list, "Accent", 2.5, 0.12, 0.12, x, -1.67, sz * 1.72)
		end
	end
	return list
end

-- Орнаментный блок 4x4x4: плинт и карниз, угловые столбики и трёхслойный рельеф
-- на каждой боковой грани (каменная плита, металлическая рамка, цветная вставка).
local function ornateCube(_factionId: string?): { Piece }
	local list: { Piece } = {}
	block(list, "Main", 3.4, 3.4, 3.4, 0, 0, 0)
	block(list, "Trim", 4, 0.4, 4, 0, -1.8, 0)
	block(list, "Trim", 4, 0.4, 4, 0, 1.8, 0)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			block(list, "Trim", 0.6, 3.2, 0.6, sx * 1.7, 0, sz * 1.7)
		end
	end
	for _, side in { -1, 1 } do
		block(list, "Main", 2.4, 2.4, 0.15, 0, 0, side * 1.775)
		block(list, "Accent", 2, 2, 0.08, 0, 0, side * 1.89)
		block(list, "Detail", 1.6, 1.6, 0.07, 0, 0, side * 1.965)
		block(list, "Main", 0.15, 2.4, 2.4, side * 1.775, 0, 0)
		block(list, "Accent", 0.08, 2, 2, side * 1.89, 0, 0)
		block(list, "Detail", 0.07, 1.6, 1.6, side * 1.965, 0, 0)
	end
	return list
end

-- ===== Каменная кладка: стены и дороги =====
-- Геометрию этих префабов проверяет tools/masonry.py check (границы формы и совпадающие грани).

local BRICK_SHADES = { 1, 0.93, 1.05, 0.97 }

-- Кирпичная кладка 12x8x4: ряды кирпичей «вперевязку», утопленный раствор между ними
-- и резной каменный карниз. Кирпичи проходят стену насквозь, поэтому обе стороны одинаковые.
local function brickWall(_factionId: string?): { Piece }
	local list: { Piece } = {}
	stone(list, "Trim", Vector3.new(11.8, 7.2, 3.8), CFrame.new(0, -0.4, 0), 0.8) -- раствор

	local courses, courseHeight, gap = 8, 0.9, 0.1
	for course = 0, courses - 1 do
		local y = -4 + courseHeight * (course + 0.5)
		local edges = if course % 2 == 0 then { -6, -3, 0, 3, 6 } else { -6, -4.5, -1.5, 1.5, 4.5, 6 }
		for i = 1, #edges - 1 do
			local left, right = edges[i], edges[i + 1]
			-- Соседние кирпичи всегда чуть разного оттенка.
			local shade = BRICK_SHADES[(course * 3 + i * 5) % #BRICK_SHADES + 1]
			stone(
				list,
				"Main",
				Vector3.new(right - left - gap, courseHeight - gap, 4),
				CFrame.new((left + right) / 2, y, 0),
				shade
			)
		end
	end

	block(list, "Main", 11.6, 0.3, 3.6, 0, 3.35, 0) -- выкружка под карнизом
	block(list, "Trim", 12, 0.5, 4, 0, 3.75, 0) -- карниз
	return list
end

-- x, y, z, длина, высота, ширина, поворот°, наклон X°, наклон Z°, порода (1 / 2), оттенок
local COBBLES: { { number } } = {
	{ -3.1, 0.08, -3.07, 1.28, 0.42, 1.22, -34.7, 4.9, -3.2, 2, 0.99 },
	{ -3.03, 0, -0.99, 1.35, 0.47, 1.48, -19.9, 4.6, -3.2, 1, 0.96 },
	{ -3.08, 0.01, 0.99, 1.35, 0.47, 1.53, 12.7, 3.3, 3.9, 2, 0.91 },
	{ -3.08, -0.01, 2.88, 1.2, 0.54, 1.27, 19.5, 4.2, 1.7, 2, 1.07 },
	{ -1.06, 0.02, -2.95, 1.34, 0.47, 1.28, -22.3, 4.4, -2.4, 2, 1.02 },
	{ -1.11, 0.12, -1.07, 1.2, 0.54, 1.35, 29.8, -2.6, 2.6, 2, 0.88 },
	{ -0.87, -0.02, 1.12, 1.4, 0.59, 1.5, 0.2, -3.9, 2.6, 2, 0.98 },
	{ -0.78, 0.06, 2.99, 1.22, 0.52, 1.59, 9.9, 1.6, -2, 2, 1.05 },
	{ 0.99, 0.09, -3.03, 1.41, 0.53, 1.57, 13.7, -4.6, -1.8, 1, 0.87 },
	{ 1.05, 0.03, -1.02, 1.65, 0.54, 1.46, -3.5, -4.5, 2.9, 1, 1.02 },
	{ 0.75, 0.11, 0.88, 1.25, 0.5, 1.28, 6.7, 2.5, -4.7, 1, 1.04 },
	{ 1.12, -0.01, 2.86, 1.51, 0.56, 1.4, 0, -4.9, 3.8, 2, 0.92 },
	{ 3.04, 0.08, -3, 1.25, 0.58, 1.22, -28.7, 4.3, -2.4, 1, 1.04 },
	{ 2.98, 0.08, -0.92, 1.31, 0.47, 1.2, -18.2, 3, -1.8, 1, 1.04 },
	{ 3.02, 0.08, 0.83, 1.6, 0.45, 1.29, 7.9, -4.8, 2.5, 1, 1.01 },
	{ 3.01, 0.03, 3.08, 1.38, 0.5, 1.21, 32, 2.5, -4.2, 1, 1.02 },
	{ -2.01, 0, -2.01, 0.66, 0.39, 0.49, -28.4, -6.1, -3.5, 2, 0.97 },
	{ -2.02, -0.01, 0.06, 0.64, 0.44, 0.45, 22.7, -3.7, -2.5, 1, 1.02 },
	{ -1.94, 0.04, 2.05, 0.55, 0.39, 0.7, -7.2, 4.9, -6.2, 1, 1 },
	{ 0.04, 0.01, -2.03, 0.62, 0.35, 0.69, 20, 4.1, 2.9, 2, 0.94 },
	{ -0.03, 0.03, -0.01, 0.58, 0.37, 0.62, 11.1, 3.7, -6.3, 1, 0.99 },
	{ -0.02, -0.01, 1.99, 0.64, 0.43, 0.62, -24.2, -2.8, 2.8, 1, 1 },
	{ 2.03, -0.01, -1.9, 0.61, 0.45, 0.55, -2.1, -2.6, -6.9, 1, 0.88 },
	{ 2.05, 0, -0.04, 0.67, 0.36, 0.56, 13, 4.3, 2.1, 2, 0.99 },
	{ 2.06, -0.02, 1.98, 0.52, 0.45, 0.5, 17.2, -6.9, 2.6, 2, 1.05 },
}

local EARTH_COLOR = Color3.fromRGB(150, 122, 88)

-- Дикий булыжник 8x1x8: неровные, слегка наклонённые камни разной высоты в земляном основании.
-- Бордюров нет: плитки стыкуются с любой стороны.
local function cobbleRoad(_factionId: string?): { Piece }
	local list: { Piece } = {}
	stone(list, "Trim", Vector3.new(8, 0.6, 8), CFrame.new(0, -0.2, 0), nil, Enum.Material.Sand, EARTH_COLOR)
	for _, s in COBBLES do
		local slate = s[10] == 1
		stone(
			list,
			if slate then "Main" else "Trim",
			Vector3.new(s[4], s[5], s[6]),
			CFrame.new(s[1], s[2], s[3])
				* CFrame.Angles(0, math.rad(s[7]), 0)
				* CFrame.Angles(math.rad(s[8]), 0, math.rad(s[9])),
			s[11],
			if slate then Enum.Material.Slate else Enum.Material.Cobblestone
		)
	end
	return list
end

-- Римская мозаика 8x1x8 (вдоль Z): крупные гладкие плиты, по бокам — кайма из цветной полосы
-- с золотыми ромбами и золотой нитью, ступенчатый бордюр и медальон в центре.
local function mosaicRoad(_factionId: string?): { Piece }
	local list: { Piece } = {}
	local diamond = CFrame.Angles(0, math.rad(45), 0)
	block(list, "Trim", 8, 0.5, 8, 0, -0.25, 0)
	for _, sx in { -1, 1 } do
		block(list, "Trim", 0.4, 0.2, 8, sx * 3.8, 0.1, 0) -- нижняя ступень бордюра
		block(list, "Main", 0.4, 0.5, 8, sx * 3.4, 0.25, 0) -- верхняя ступень бордюра
		block(list, "Accent", 0.3, 0.3, 8, sx * 3.05, 0.15, 0) -- золотая нить
		block(list, "Detail", 0.4, 0.26, 8, sx * 2.7, 0.13, 0) -- цветная полоса каймы
		for k = 0, 3 do
			add(list, "Block", "Accent", Vector3.new(0.26, 0.27, 0.26), CFrame.new(sx * 2.7, 0.185, -3 + 2 * k) * diamond)
		end
		for _, sz in { -1, 1 } do
			-- Плиты в шахматном порядке чуть отличаются тоном.
			stone(
				list,
				"Main",
				Vector3.new(2.44, 0.3, 3.94),
				CFrame.new(sx * 1.25, 0.15, sz * 2),
				if sx * sz > 0 then 1 else 0.94
			)
		end
	end
	add(list, "Block", "Accent", Vector3.new(1.7, 0.28, 1.7), CFrame.new(0, 0.19, 0) * diamond)
	add(list, "Block", "Detail", Vector3.new(1.3, 0.26, 1.3), CFrame.new(0, 0.23, 0) * diamond)
	return list
end

-- x, y, длина, высота, глубина, оттенок
local RUIN_STONES: { { number } } = {
	{ -3.795, -2.88, 4.41, 2.24, 3.7, 0.84 },
	{ 0, -2.88, 2.82, 2.24, 4, 0.83 },
	{ 3.795, -2.88, 4.41, 2.24, 4, 0.92 },
	{ -4.795, -0.78, 2.41, 1.64, 4, 0.84 },
	{ -2, -0.78, 2.82, 1.64, 4, 0.96 },
	{ 1.25, -0.78, 3.32, 1.64, 3.7, 0.89 },
	{ 4.545, -0.78, 2.91, 1.64, 4, 1 },
	{ -3.795, 1.22, 4.41, 2.04, 4, 0.91 },
	{ 0.5, 1.22, 3.82, 2.04, 3.85, 0.99 },
	{ 4.295, 1.22, 3.41, 2.04, 4, 0.99 },
	{ -4.045, 3, 3.91, 1.2, 3.85, 1.03 },
	{ -0.25, 3.2, 3.32, 1.6, 3.85, 0.87 },
	{ 3.795, 3.2, 4.41, 1.6, 3.7, 0.99 },
}

-- Древняя кладка 12x8x4: крупные грубо отёсанные блоки разного размера и глубины
-- (циклопическая кладка) с глубокими швами; один камень верхнего ряда выщерблен.
local function ruinWall(_factionId: string?): { Piece }
	local list: { Piece } = {}
	stone(list, "Trim", Vector3.new(11.6, 7.4, 3), CFrame.new(0, -0.2, 0), 0.55) -- тёмная глубина швов
	for _, s in RUIN_STONES do
		stone(list, "Main", Vector3.new(s[3], s[4], s[5]), CFrame.new(s[1], s[2], 0), s[6], Enum.Material.Slate)
	end
	return list
end

local PREFABS: { [string]: Prefab } = {
	BrickWall = { build = brickWall, collision = "bounds" },
	CobbleRoad = { build = cobbleRoad, collision = "bounds" },
	MosaicRoad = { build = mosaicRoad, collision = "bounds" },
	RuinWall = { build = ruinWall, collision = "bounds" },
	OrnateRoad = { build = ornateRoad, collision = "bounds" },
	OrnateWall = { build = ornateWall, collision = "bounds" },
	OrnateCube = { build = ornateCube, collision = "bounds" },
	CarvedColumn = { build = column(16), collision = "bounds" },
	CarvedColumnShort = { build = column(8), collision = "bounds" },
	Arch = { build = archRound, collision = "pieces" },
	ArchStepped = { build = archStepped, collision = "pieces" },
	Stairs = { build = stairs, collision = "pieces" },
	Ramp = { build = ramp, collision = "bounds" },
	Crepidoma = { build = crepidoma, collision = "pieces" },
	Pyramid = { build = pyramidPrefab, collision = "bounds" },
	StepPyramid = { build = stepPyramid, collision = "pieces" },
	Obelisk = { build = obelisk, collision = "bounds" },
	GableRoof = { build = gableRoof, collision = "bounds" },
	RoofSlope = { build = roofSlope, collision = "bounds" },
	RoofCorner = { build = roofCorner, collision = "bounds" },
	Altar = { build = altar, collision = "bounds" },
	Pedestal = { build = pedestal, collision = "bounds" },
}

-- ===== Публичный API =====

function BlockLibrary.isPrefab(shapeId: string): boolean
	return PREFABS[shapeId] ~= nil
end

local pieceCache: { [string]: { Piece } } = {}

-- Детали формы. Для простых форм (Блок, Стена, ...) — одна коробка размера формы.
function BlockLibrary.getPieces(shapeId: string, factionId: string?): { Piece }
	local key = shapeId .. "|" .. (factionId or "")
	local cached = pieceCache[key]
	if cached then
		return cached
	end

	local pieces: { Piece }
	local prefab = PREFABS[shapeId]
	local shape = BuildConfig.Shapes[shapeId]
	if prefab then
		pieces = prefab.build(factionId)
	elseif shape then
		pieces = { { kind = "Block", role = "Main", size = shape.size, cframe = CFrame.identity } }
	else
		pieces = {}
	end
	pieceCache[key] = pieces
	return pieces
end

local collisionCache: { [string]: { Box } } = {}

-- Коробки для проверки пересечений при установке (относительно центра формы).
function BlockLibrary.getCollisionBoxes(shapeId: string): { Box }
	local cached = collisionCache[shapeId]
	if cached then
		return cached
	end
	local shape = BuildConfig.Shapes[shapeId]
	if not shape then
		return {}
	end

	local boxes: { Box } = {}
	local prefab = PREFABS[shapeId]
	if prefab and prefab.collision == "pieces" then
		for _, piece in BlockLibrary.getPieces(shapeId, nil) do
			table.insert(boxes, { cframe = piece.cframe, size = piece.size })
		end
	else
		boxes = { { cframe = CFrame.identity, size = shape.size } }
	end
	collisionCache[shapeId] = boxes
	return boxes
end

-- Создаёт деталь нужного класса (без материала и положения).
function BlockLibrary.makePart(piece: Piece): BasePart
	local part: BasePart
	if piece.kind == "Wedge" then
		part = Instance.new("WedgePart")
	elseif piece.kind == "CornerWedge" then
		part = Instance.new("CornerWedgePart")
	else
		local p = Instance.new("Part")
		if piece.kind == "Cylinder" then
			p.Shape = Enum.PartType.Cylinder
		end
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		part = p
	end
	part.Name = piece.role
	part.Size = piece.size
	return part
end

-- Палитра фракции (материал и цвет для каждой роли).
function BlockLibrary.getPalette(factionId: string?): BuildConfig.Palette
	return (if factionId then BuildConfig.FactionPalettes[factionId] else nil) or BuildConfig.DefaultPalette
end

-- Собирает закреплённую модель префаба в мире: центр формы = cframe.
function BlockLibrary.buildModel(shapeId: string, factionId: string?, cframe: CFrame): Model?
	local pieces = BlockLibrary.getPieces(shapeId, factionId)
	if #pieces == 0 then
		return nil
	end
	local palette = BlockLibrary.getPalette(factionId)

	local model = Instance.new("Model")
	model.Name = shapeId
	for _, piece in pieces do
		local part = BlockLibrary.makePart(piece)
		local look = palette[piece.role]
		local color = piece.color or look.color
		local shade = piece.shade
		if shade then
			color = Color3.new(
				math.clamp(color.R * shade, 0, 1),
				math.clamp(color.G * shade, 0, 1),
				math.clamp(color.B * shade, 0, 1)
			)
		end
		part.Material = piece.material or look.material
		part.Color = color
		part.Anchored = true
		part.CanCollide = true
		part.CFrame = cframe * piece.cframe
		part.Parent = model
	end
	model.WorldPivot = cframe -- PivotTo/GetPivot работают от центра формы
	return model
end

return BlockLibrary
]]></string>
</Properties>
</Item>

<Item class="ModuleScript" referent="RBXSTEP50001">
<Properties>
<string name="Name">BlockCatalog</string>
<string name="Source"><![CDATA[--!strict
-- BlockCatalog: список форм для панели «Блоки» (названия, подписи, категории).
-- Размеры — в BuildConfig.Shapes, геометрия составных блоков — в BlockLibrary.
-- Чтобы добавить новый блок: размер в BuildConfig.Shapes, строитель в BlockLibrary, строка здесь.

export type Category = {
	id: string,
	label: string,
}

export type Entry = {
	id: string, -- ключ BuildConfig.Shapes
	displayName: string,
	description: string,
	category: string,
	featured: { string }?, -- фракции, для которых блок «родной» (звёздочка в каталоге)
}

local BlockCatalog = {}

BlockCatalog.AllCategoryId = "All"

-- Вкладки каталога (в порядке показа). Первая — «Все».
BlockCatalog.Categories = {
	{ id = "All", label = "Все" },
	{ id = "Basic", label = "Базовые" },
	{ id = "Ornate", label = "Резные" },
	{ id = "Columns", label = "Колонны" },
	{ id = "Arches", label = "Арки" },
	{ id = "Stairs", label = "Ступени" },
	{ id = "Roofs", label = "Крыши" },
	{ id = "Decor", label = "Декор" },
} :: { Category }

BlockCatalog.List = {
	-- Базовые (один Part, работают и как форма резака)
	{ id = "Block", displayName = "Блок", description = "Куб 4×4×4", category = "Basic" },
	{ id = "Wall", displayName = "Стена", description = "16×12×4", category = "Basic" },
	{ id = "Column", displayName = "Опора", description = "Простая колонна", category = "Basic" },
	{ id = "Slab", displayName = "Плита", description = "Полы и перекрытия", category = "Basic" },

	-- Резные: составные варианты базовых блоков с отделкой
	{
		id = "OrnateRoad",
		displayName = "Дорога (Брусчатка)",
		description = "Камни и бордюры 8×1×8",
		category = "Ornate",
	},
	{
		id = "OrnateWall",
		displayName = "Резная стена",
		description = "Панели и пояса 12×8×4",
		category = "Ornate",
	},
	{
		id = "OrnateCube",
		displayName = "Орнаментный блок",
		description = "Столбики и вставки 4×4×4",
		category = "Ornate",
	},
	{
		id = "BrickWall",
		displayName = "Кирпичная кладка",
		description = "Ряды вперевязку 12×8×4",
		category = "Ornate",
	},
	{
		id = "RuinWall",
		displayName = "Древняя кладка",
		description = "Грубые глыбы 12×8×4",
		category = "Ornate",
	},
	{
		id = "CobbleRoad",
		displayName = "Дикий булыжник",
		description = "Неровная тропа 8×1×8",
		category = "Ornate",
	},
	{
		id = "MosaicRoad",
		displayName = "Римская мозаика",
		description = "Плиты и кайма 8×1×8",
		category = "Ornate",
		featured = { "Rome" },
	},

	-- Колонны
	{
		id = "CarvedColumn",
		displayName = "Резная колонна",
		description = "База, рифлёный ствол, капитель",
		category = "Columns",
		featured = { "Rome", "Greece", "Egypt" },
	},
	{
		id = "CarvedColumnShort",
		displayName = "Малая колонна",
		description = "Портики и галереи",
		category = "Columns",
	},

	-- Арки
	{
		id = "Arch",
		displayName = "Античная арка",
		description = "Полукруглый свод, замковый камень",
		category = "Arches",
		featured = { "Rome" },
	},
	{
		id = "ArchStepped",
		displayName = "Ступенчатая арка",
		description = "Ложный свод из рядов камня",
		category = "Arches",
		featured = { "Egypt", "Greece" },
	},

	-- Ступени
	{ id = "Stairs", displayName = "Лестница", description = "4 ступени с кантом", category = "Stairs" },
	{ id = "Ramp", displayName = "Пандус", description = "Плавный подъём", category = "Stairs" },
	{
		id = "Crepidoma",
		displayName = "Подиум храма",
		description = "Трёхступенчатое основание",
		category = "Stairs",
		featured = { "Greece", "Rome" },
	},

	-- Пирамиды и крыши
	{
		id = "Pyramid",
		displayName = "Пирамида",
		description = "Золотое навершие",
		category = "Roofs",
		featured = { "Egypt" },
	},
	{
		id = "StepPyramid",
		displayName = "Ступенчатая пирамида",
		description = "Четыре яруса",
		category = "Roofs",
		featured = { "Egypt" },
	},
	{
		id = "GableRoof",
		displayName = "Фронтон",
		description = "Двускатная крыша храма",
		category = "Roofs",
		featured = { "Greece", "Rome" },
	},
	{ id = "RoofSlope", displayName = "Скат", description = "Клин 8×4×4", category = "Roofs" },
	{ id = "RoofCorner", displayName = "Угол ската", description = "Угловой клин 4×4×4", category = "Roofs" },

	-- Декор
	{
		id = "Altar",
		displayName = "Алтарь",
		description = "Золотая окантовка",
		category = "Decor",
		featured = { "Greece" },
	},
	{
		id = "Pedestal",
		displayName = "Пьедестал",
		description = "Для статуй и чаш",
		category = "Decor",
		featured = { "Rome" },
	},
	{
		id = "Obelisk",
		displayName = "Обелиск",
		description = "Золотой пирамидион",
		category = "Decor",
		featured = { "Egypt" },
	},
} :: { Entry }

BlockCatalog.ById = {} :: { [string]: Entry }
for _, entry in BlockCatalog.List do
	BlockCatalog.ById[entry.id] = entry
end

function BlockCatalog.displayName(shapeId: string?): string
	local entry = if shapeId then BlockCatalog.ById[shapeId] else nil
	return if entry then entry.displayName else (shapeId or "")
end

function BlockCatalog.isFeatured(entry: Entry, factionId: string?): boolean
	if not factionId or not entry.featured then
		return false
	end
	return table.find(entry.featured, factionId) ~= nil
end

return BlockCatalog
]]></string>
</Properties>
</Item>

      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">FactionConfig</string>
          <string name="Source"><![CDATA[--!strict
-- FactionConfig: единый источник данных о фракциях.
-- Используется и клиентом (меню), и в будущем сервером (спавн, бонусы фракций).

export type Faction = {
	id: string, -- внутренний идентификатор
	displayName: string, -- название на кнопке
	description: string, -- подпись под названием
	platformName: string, -- имя Part в Workspace.Platforms
	fallbackPosition: Vector3, -- куда телепортировать, если платформы нет
	buttonColor: Color3, -- основной цвет кнопки
	accentColor: Color3, -- цвет обводки
}

local FactionConfig = {}

-- Порядок в массиве = порядок кнопок в меню.
FactionConfig.List = {
	{
		id = "Rome",
		displayName = "Рим",
		description = "Легионы, акведуки и форумы",
		platformName = "RomePlatform",
		fallbackPosition = Vector3.new(-200, 5, 0),
		buttonColor = Color3.fromRGB(140, 30, 35),
		accentColor = Color3.fromRGB(220, 180, 90),
	},
	{
		id = "Greece",
		displayName = "Греция",
		description = "Полисы, философы и мраморные храмы",
		platformName = "GreecePlatform",
		fallbackPosition = Vector3.new(0, 5, -200),
		buttonColor = Color3.fromRGB(35, 75, 140),
		accentColor = Color3.fromRGB(235, 235, 225),
	},
	{
		id = "Egypt",
		displayName = "Египет",
		description = "Пирамиды, Нил и пески пустыни",
		platformName = "EgyptPlatform",
		fallbackPosition = Vector3.new(200, 5, 0),
		buttonColor = Color3.fromRGB(190, 140, 50),
		accentColor = Color3.fromRGB(40, 110, 120),
	},
} :: { Faction }

-- Быстрый поиск по id: FactionConfig.ById.Rome
FactionConfig.ById = {} :: { [string]: Faction }
for _, faction in FactionConfig.List do
	FactionConfig.ById[faction.id] = faction
end

return FactionConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">PlotConfig</string>
          <string name="Source"><![CDATA[--!strict
-- PlotConfig: все настройки персональных строительных участков (Plot).
-- Лежит в ReplicatedStorage.Shared, чтобы и сервер, и клиент (меню, будущая
-- система строительства, подсказки) брали числа из одного места.

export type PlotStyle = {
	material: Enum.Material, -- материал поверхности участка
	color: Color3, -- цвет поверхности участка
	borderMaterial: Enum.Material, -- материал бордюра по краю
	borderColor: Color3, -- цвет бордюра
	cornerKind: "Column" | "Block", -- что стоит по углам: колонна или массивный блок
	cornerMaterial: Enum.Material, -- материал угловых элементов
	cornerColor: Color3, -- цвет угловых элементов
	capColor: Color3?, -- цвет «шапки» углового блока (только для Block)
}

local PlotConfig = {}

-- Имя RemoteFunction, через которую меню сообщает серверу о выбранной фракции.
-- Сервер создаёт её сам при старте (см. PlotService).
PlotConfig.RemoteName = "SelectFaction"

-- Размер участка: 200x200 studs, толщина 2 (как у платформ в Workspace.Platforms).
PlotConfig.PlotSize = 200
PlotConfig.PlotThickness = 2

-- Сетка участков. Начало сетки далеко от лобби (0,0,0) и от стартовых платформ
-- (±200). Шаг 400 при размере 200 даёт 200 studs пустоты между соседями.
PlotConfig.GridOrigin = Vector3.new(1000, 1, 1000) -- центр участка №0 (верх участка на Y = 2)
PlotConfig.GridSpacing = 400
PlotConfig.GridColumns = 10 -- сколько участков в ряду

-- Максимальная высота постройки над поверхностью участка (для проверки прав).
PlotConfig.BuildHeight = 300

-- Имя папки в Workspace, где живут все участки.
PlotConfig.FolderName = "Plots"

-- Бордюр по краям: ширина (внутрь участка) и высота над поверхностью.
PlotConfig.BorderWidth = 4
PlotConfig.BorderHeight = 3

-- Угловые элементы (колонны/блоки): сторона основания и общая высота.
PlotConfig.CornerBaseSize = 8
PlotConfig.CornerHeight = 20

-- Строительная сетка: стандартная текстура сетки из шаблона Baseplate.
-- Хотите другой шаг сетки: меняйте StudsPerTile (или Texture на свой ассет).
PlotConfig.GridTexture = "rbxassetid://6372755229"
PlotConfig.GridStudsPerTile = 4
PlotConfig.GridTransparency = 0.85 -- чем ближе к 1, тем незаметнее сетка
PlotConfig.GridColor = Color3.fromRGB(0, 0, 0)

-- Имена атрибутов, которыми помечается Part участка.
PlotConfig.Attributes = {
	OwnerUserId = "OwnerUserId",
	FactionId = "FactionId",
	SlotIndex = "SlotIndex",
}

-- Внешний вид участка по id фракции из FactionConfig.
PlotConfig.Styles = {
	-- Египет: песок, золотой бордюр и массивные песчаные блоки с золотыми шапками по углам.
	Egypt = {
		material = Enum.Material.Sand,
		color = Color3.fromRGB(226, 189, 121),
		borderMaterial = Enum.Material.Metal,
		borderColor = Color3.fromRGB(212, 175, 55),
		cornerKind = "Block",
		cornerMaterial = Enum.Material.Sand,
		cornerColor = Color3.fromRGB(205, 165, 100),
		capColor = Color3.fromRGB(212, 175, 55),
	},
	-- Рим: белый/серый мрамор, серый бордюр форума, белые колонны по углам.
	Rome = {
		material = Enum.Material.Marble,
		color = Color3.fromRGB(196, 198, 204),
		borderMaterial = Enum.Material.Marble,
		borderColor = Color3.fromRGB(150, 152, 160),
		cornerKind = "Column",
		cornerMaterial = Enum.Material.Marble,
		cornerColor = Color3.fromRGB(232, 232, 236),
	},
	-- Греция: светло-бежевый мрамор, тёплые колонны по углам.
	Greece = {
		material = Enum.Material.Marble,
		color = Color3.fromRGB(238, 226, 198),
		borderMaterial = Enum.Material.Marble,
		borderColor = Color3.fromRGB(214, 198, 164),
		cornerKind = "Column",
		cornerMaterial = Enum.Material.Marble,
		cornerColor = Color3.fromRGB(248, 240, 222),
	},
} :: { [string]: PlotStyle }

-- Запасной стиль на случай новой фракции, для которой стиль ещё не описан.
PlotConfig.DefaultStyle = {
	material = Enum.Material.SmoothPlastic,
	color = Color3.fromRGB(180, 180, 180),
	borderMaterial = Enum.Material.SmoothPlastic,
	borderColor = Color3.fromRGB(120, 120, 120),
	cornerKind = "Block",
	cornerMaterial = Enum.Material.SmoothPlastic,
	cornerColor = Color3.fromRGB(150, 150, 150),
} :: PlotStyle

return PlotConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">BuildSlots</string>
          <string name="Source"><![CDATA[--!strict
-- BuildSlots: единый источник данных о слотах строительной панели.
-- Как и FactionConfig, лежит в Shared: клиент (BuildController) и сервер ссылаются
-- на одни и те же id слотов. Сами формы теперь выбираются в каталоге «Блоки»
-- (BlockCatalog), а на панели остаются кнопка каталога и инструменты.

export type Slot = {
	id: string, -- внутренний идентификатор
	displayName: string, -- название на кнопке
	description: string, -- подпись под названием
	kind: "Catalog" | "Tool", -- кнопка каталога форм или инструмент (стоит отдельно справа)
	wide: boolean?, -- широкая кнопка (для длинного названия)
}

local BuildSlots = {}

-- Порядок в массиве = порядок кнопок на панели слева направо.
BuildSlots.List = {
	{ id = "Blocks", displayName = "Блоки", description = "Каталог · B", kind = "Catalog", wide = true },
	{ id = "Carve", displayName = "Вырезать", description = "Проёмы и окна", kind = "Tool" },
	{ id = "Move", displayName = "Двигать", description = "Стрелки X / Y / Z", kind = "Tool" },
	{ id = "Delete", displayName = "Снос", description = "ЛКМ или X", kind = "Tool" },
	{ id = "Paint", displayName = "Покраска / Скрижали", description = "Материалы и надписи", kind = "Tool", wide = true },
} :: { Slot }

-- Быстрый поиск по id: BuildSlots.ById.Carve
BuildSlots.ById = {} :: { [string]: Slot }
for _, slot in BuildSlots.List do
	BuildSlots.ById[slot.id] = slot
end

return BuildSlots
]]></string>
        </Properties>
      </Item>
    <Item class="ModuleScript" referent="32"><Properties><string name="Name">BuildConfig</string><string name="Source"><![CDATA[--!strict
-- BuildConfig: все настройки строительного редактора (Placement System).
-- Лежит в ReplicatedStorage.Shared: клиент (призрак, панель «Точность») и сервер
-- (проверка, спавн, вырезание) берут формы, шаги сетки/поворота и материалы из одного места.

export type Shape = {
	id: string, -- совпадает с id в BlockCatalog
	size: Vector3, -- габарит без поворота (X = длина, Y = высота, Z = толщина)
	prefab: boolean?, -- true = составная модель из BlockLibrary (резаком не используется)
}

export type FactionMaterial = {
	material: Enum.Material,
	color: Color3,
}

-- Палитра составных блоков: материал для каждой роли детали (см. BlockLibrary).
export type Palette = {
	Main: FactionMaterial, -- основной камень
	Trim: FactionMaterial, -- окантовка, базы, карнизы
	Accent: FactionMaterial, -- золото / бронза
	Detail: FactionMaterial, -- цветные вставки
}

export type GridOption = {
	step: number, -- шаг сетки в студах; 0 = свободное перемещение без сетки
	label: string, -- надпись на кнопке панели
	hint: string, -- пояснение в заголовке секции
}

local BuildConfig = {}

-- Имена RemoteEvent'ов (их создаёт сервер в ReplicatedStorage.Shared, см. BuildService).
BuildConfig.PlaceRemoteName = "PlaceBlock"
BuildConfig.RemoveRemoteName = "RemoveBlock"
BuildConfig.CarveRemoteName = "CarveBlock"
BuildConfig.MoveRemoteName = "MoveBlock"
BuildConfig.PaintRemoteName = "PaintBlock"
BuildConfig.TabletRemoteName = "PlaceTablet"
BuildConfig.EraseTabletRemoteName = "EraseTablet"
BuildConfig.NoticeRemoteName = "BuildNotice" -- сервер -> клиент: короткие сообщения для панели

-- Папки внутри Part участка. Лежат внутри участка, поэтому удаляются вместе с ним.
BuildConfig.BlocksFolderName = "Blocks" -- постройки игрока
BuildConfig.DecorFolderName = "Decor" -- бордюр и углы участка (см. PlotBuilder)

-- ===== Точность (переключается на панели «Точность» справа) =====

-- Шаг сетки. Сетка начинается от угла плиты, поэтому блоки ложатся ровно по её текстуре.
BuildConfig.GridOptions = {
	{ step = 4, label = "4", hint = "крупный" },
	{ step = 1, label = "1", hint = "средний" },
	{ step = 0.25, label = "0.25", hint = "ювелирный" },
	{ step = 0, label = "0", hint = "без сетки" },
} :: { GridOption }
BuildConfig.DefaultGridIndex = 1

-- Шаг поворота в градусах.
BuildConfig.RotationSteps = { 90, 45, 15, 5 } :: { number }
BuildConfig.DefaultRotationIndex = 1
-- Сервер принимает только углы, кратные этому значению (наименьший шаг из списка выше).
BuildConfig.MinRotationStep = 5

-- Отступ от края плиты 200x200, внутри которого строить нельзя (там бордюр).
-- Поставьте 0, если хотите строить вплотную к краю.
BuildConfig.EdgeInset = 4

-- Id слотов-инструментов на нижней панели (см. BuildSlots).
BuildConfig.CarveSlotId = "Carve"
BuildConfig.DeleteSlotId = "Delete"
BuildConfig.MoveSlotId = "Move" -- перенос блока 3D-стрелками
BuildConfig.PaintSlotId = "Paint" -- меню «Покраска / Скрижали»
BuildConfig.CatalogSlotId = "Blocks" -- кнопка «Блоки»: открывает каталог форм

-- Горячие клавиши редактора (ПКМ не используется — она только вращает камеру).
BuildConfig.Keys = {
	RotateY = Enum.KeyCode.R, -- вращение вокруг вертикальной оси Y
	TiltX = Enum.KeyCode.T, -- наклон вперёд/назад (ось X)
	TiltZ = Enum.KeyCode.Y, -- наклон вбок (ось Z)
	QuickDelete = Enum.KeyCode.X, -- удалить свой блок под курсором
	OpenCatalog = Enum.KeyCode.B, -- открыть/закрыть каталог блоков
}

-- Защита сервера от спама и лимиты.
BuildConfig.PlaceCooldown = 0.08 -- секунд между установками
BuildConfig.RemoveCooldown = 0.05 -- секунд между удалениями
BuildConfig.CarveCooldown = 0.35 -- CSG — дорогая операция
BuildConfig.MaxBlocksPerPlayer = 2000
BuildConfig.MaxCarveTargets = 8 -- сколько блоков максимум прорезает один клик
BuildConfig.MoveCooldown = 0.1 -- секунд между переносами
BuildConfig.PaintCooldown = 0.05 -- секунд между покрасками
BuildConfig.TabletCooldown = 0.3 -- секунд между скрижалями
BuildConfig.MaxTabletsPerPlayer = 60

-- Скрижаль: полный размер плиты (ширина, высота, толщина); на узкой грани она уменьшается.
BuildConfig.TabletSize = Vector3.new(6, 4, 0.2)
BuildConfig.TabletMinWidth = 1.5

-- Пользовательский размер базовых блоков и резака (панель «Точность»).
BuildConfig.MinBlockSize = 0.25
BuildConfig.MaxBlockSize = 64
BuildConfig.FreeSizeStep = 0.05 -- шаг кнопок −/+ при сетке «0»

-- Формы резака: «куб» — выбранная базовая форма, «полоса» — тонкая пластина.
BuildConfig.BladeThickness = 0.2
BuildConfig.BladeDefaultSize = Vector3.new(8, 8, BuildConfig.BladeThickness)
BuildConfig.CutterCubeId = "Cube"
BuildConfig.CutterBladeId = "Blade"
BuildConfig.CutterShapes = {
	{ id = BuildConfig.CutterCubeId, label = "Куб" },
	{ id = BuildConfig.CutterBladeId, label = "Полоса / Лезвие" },
} :: { { id: string, label: string } }

-- Допуски.
BuildConfig.OverlapTolerance = 0.02 -- касание гранями не считается пересечением
BuildConfig.CutterInflate = 0.02 -- резак чуть больше призрака: без «плёнок» на совпадающих гранях

-- Формы для постройки. Ключи = id из BlockCatalog.
-- Базовые формы — один Part (их же использует резак). Составные (prefab = true) —
-- модели из нескольких деталей, геометрия в BlockLibrary; size = их габаритная коробка,
-- по ней работают сетка, поворот и прилипание к граням.
BuildConfig.Shapes = {
	-- Базовые
	Block = { id = "Block", size = Vector3.new(4, 4, 4) }, -- простой куб
	Wall = { id = "Wall", size = Vector3.new(16, 12, 4) }, -- длинная стена
	Column = { id = "Column", size = Vector3.new(4, 16, 4) }, -- высокая опора
	Slab = { id = "Slab", size = Vector3.new(12, 2, 12) }, -- плита пола/перекрытия

	-- Колонны
	CarvedColumn = { id = "CarvedColumn", size = Vector3.new(4, 16, 4), prefab = true },
	CarvedColumnShort = { id = "CarvedColumnShort", size = Vector3.new(4, 8, 4), prefab = true },
	-- Арки
	Arch = { id = "Arch", size = Vector3.new(12, 12, 4), prefab = true },
	ArchStepped = { id = "ArchStepped", size = Vector3.new(12, 12, 4), prefab = true },
	-- Ступени
	Stairs = { id = "Stairs", size = Vector3.new(8, 4, 8), prefab = true },
	Ramp = { id = "Ramp", size = Vector3.new(8, 4, 8), prefab = true },
	Crepidoma = { id = "Crepidoma", size = Vector3.new(12, 3, 12), prefab = true },
	-- Пирамиды и крыши
	Pyramid = { id = "Pyramid", size = Vector3.new(12, 8, 12), prefab = true },
	StepPyramid = { id = "StepPyramid", size = Vector3.new(12, 8, 12), prefab = true },
	GableRoof = { id = "GableRoof", size = Vector3.new(12, 4, 8), prefab = true },
	RoofSlope = { id = "RoofSlope", size = Vector3.new(8, 4, 4), prefab = true },
	RoofCorner = { id = "RoofCorner", size = Vector3.new(4, 4, 4), prefab = true },
	-- Декор
	Altar = { id = "Altar", size = Vector3.new(8, 4, 4), prefab = true },
	Pedestal = { id = "Pedestal", size = Vector3.new(4, 6, 4), prefab = true },
	Obelisk = { id = "Obelisk", size = Vector3.new(4, 16, 4), prefab = true },

	-- Резные варианты базовых блоков
	OrnateRoad = { id = "OrnateRoad", size = Vector3.new(8, 1, 8), prefab = true },
	OrnateWall = { id = "OrnateWall", size = Vector3.new(12, 8, 4), prefab = true },
	OrnateCube = { id = "OrnateCube", size = Vector3.new(4, 4, 4), prefab = true },

	-- Каменная кладка: стены и дороги
	BrickWall = { id = "BrickWall", size = Vector3.new(12, 8, 4), prefab = true },
	RuinWall = { id = "RuinWall", size = Vector3.new(12, 8, 4), prefab = true },
	CobbleRoad = { id = "CobbleRoad", size = Vector3.new(8, 1, 8), prefab = true },
	MosaicRoad = { id = "MosaicRoad", size = Vector3.new(8, 1, 8), prefab = true },
} :: { [string]: Shape }

-- Базовый материал блоков по фракции: песчаник для Египта, мрамор для Рима и Греции.
BuildConfig.FactionMaterials = {
	Egypt = { material = Enum.Material.Sandstone, color = Color3.fromRGB(214, 180, 120) },
	Rome = { material = Enum.Material.Marble, color = Color3.fromRGB(225, 225, 230) },
	Greece = { material = Enum.Material.Marble, color = Color3.fromRGB(242, 234, 214) },
} :: { [string]: FactionMaterial }

BuildConfig.DefaultMaterial = {
	material = Enum.Material.SmoothPlastic,
	color = Color3.fromRGB(200, 200, 200),
} :: FactionMaterial

local GOLD = { material = Enum.Material.Foil, color = Color3.fromRGB(212, 175, 55) } :: FactionMaterial

-- Палитры составных блоков по фракциям (Main = базовый материал фракции).
BuildConfig.FactionPalettes = {
	Egypt = {
		Main = BuildConfig.FactionMaterials.Egypt,
		Trim = { material = Enum.Material.Sandstone, color = Color3.fromRGB(184, 146, 92) }, -- тёмный песчаник
		Accent = GOLD,
		Detail = { material = Enum.Material.Marble, color = Color3.fromRGB(52, 150, 160) }, -- бирюза / фаянс
	},
	Rome = {
		Main = BuildConfig.FactionMaterials.Rome,
		Trim = { material = Enum.Material.Limestone, color = Color3.fromRGB(206, 196, 172) }, -- травертин
		Accent = GOLD,
		Detail = { material = Enum.Material.Marble, color = Color3.fromRGB(122, 40, 52) }, -- порфир
	},
	Greece = {
		Main = BuildConfig.FactionMaterials.Greece,
		Trim = { material = Enum.Material.Marble, color = Color3.fromRGB(250, 248, 240) }, -- белый мрамор
		Accent = GOLD,
		Detail = { material = Enum.Material.Marble, color = Color3.fromRGB(58, 92, 156) }, -- расписная синь
	},
} :: { [string]: Palette }

BuildConfig.DefaultPalette = {
	Main = BuildConfig.DefaultMaterial,
	Trim = { material = Enum.Material.SmoothPlastic, color = Color3.fromRGB(170, 170, 170) },
	Accent = GOLD,
	Detail = { material = Enum.Material.SmoothPlastic, color = Color3.fromRGB(90, 110, 150) },
} :: Palette

-- Цвета призрака.
BuildConfig.GhostValidColor = Color3.fromRGB(90, 230, 120) -- установка: можно ставить
BuildConfig.GhostInvalidColor = Color3.fromRGB(235, 75, 75) -- установка: нельзя
BuildConfig.CarveActiveColor = Color3.fromRGB(170, 90, 255) -- резак задевает блок: ЛКМ вырежет
BuildConfig.CarveIdleColor = Color3.fromRGB(255, 150, 40) -- резак ничего не задевает
BuildConfig.GhostTransparency = 0.55
BuildConfig.GhostFollowSpeed = 22 -- чем больше, тем быстрее призрак догоняет курсор

-- Подсветка блока под курсором в режиме «Снос».
BuildConfig.DeleteHighlightColor = Color3.fromRGB(255, 70, 70)

-- Режим «Двигать»: подсветка блока, цвет стрелок, ожидание ответа сервера.
BuildConfig.MoveHighlightColor = Color3.fromRGB(90, 170, 255)
BuildConfig.PaintHighlightColor = Color3.fromRGB(255, 200, 60)
BuildConfig.MoveHandlesColor = Color3.fromRGB(255, 200, 60)
BuildConfig.MovePendingTimeout = 1

-- Сколько секунд держится сообщение на панели «Точность».
BuildConfig.NoticeDuration = 3

-- Атрибуты на поставленных блоках (переносятся и на вырезанные блоки).
BuildConfig.Attributes = {
	OwnerUserId = "OwnerUserId",
	ShapeId = "ShapeId",
	TabletId = "TabletId", -- стоит на плите скрижали (потомок детали блока)
}

return BuildConfig
]]></string></Properties></Item>
<Item class="ModuleScript" referent="33"><Properties><string name="Name">BuildGrid</string><string name="Source"><![CDATA[--!strict
-- BuildGrid: общая математика строительного редактора для клиента и сервера.
-- Клиент считает здесь положение призрака, сервер теми же функциями
-- перепроверяет запрос, поэтому результат у обоих совпадает.
--
-- Все расчёты идут в локальных координатах участка (центр плиты = 0,0,0).
-- Сетка начинается от угла плиты, поэтому блоки ложатся ровно по текстуре сетки.
-- Поворот — три угла в градусах:
--   yaw   (клавиша R) — вокруг вертикальной оси Y участка;
--   pitch (клавиша T) — наклон вперёд/назад (ось X фигуры);
--   roll  (клавиша Y) — наклон вбок (ось Z фигуры).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BlockLibrary = require(ReplicatedStorage.Shared.BlockLibrary)
local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

export type Angles = {
	yaw: number,
	pitch: number,
	roll: number,
}

export type PlacementRequest = {
	plot: BasePart,
	shapeId: string,
	angles: Angles,
	size: Vector3?, -- свой размер базовой формы или резака (nil = размер из BuildConfig.Shapes)
	gridStep: number, -- 0 = без сетки
	snapToCenter: boolean, -- «Магнит к центру»
	inward: boolean, -- true = резак: фигура утапливается в грань, а не ставится на неё
	hitPart: BasePart, -- плита участка или блок под курсором
	hitPos: Vector3, -- точка попадания луча (мир)
	hitNormal: Vector3, -- нормаль грани (мир)
}

export type Placement = {
	cframe: CFrame, -- мировой CFrame фигуры
	localCenter: Vector3, -- центр в координатах участка (его клиент отправляет серверу)
	extents: Vector3, -- габариты с учётом поворота (AABB в координатах участка)
}

local EPSILON = 0.01
local AXES = { Vector3.xAxis, Vector3.yAxis, Vector3.zAxis }
local CORNER_SIGNS = { -1, 1 }

local BuildGrid = {}

-- ===== Вспомогательное =====

local function component(v: Vector3, axis: number): number
	if axis == 1 then
		return v.X
	elseif axis == 2 then
		return v.Y
	end
	return v.Z
end

local function withComponent(v: Vector3, axis: number, value: number): Vector3
	if axis == 1 then
		return Vector3.new(value, v.Y, v.Z)
	elseif axis == 2 then
		return Vector3.new(v.X, value, v.Z)
	end
	return Vector3.new(v.X, v.Y, value)
end

-- Номер оси (1 = X, 2 = Y, 3 = Z), вдоль которой вектор направлен сильнее всего.
local function dominantAxis(v: Vector3): number
	local ax, ay, az = math.abs(v.X), math.abs(v.Y), math.abs(v.Z)
	if ay >= ax and ay >= az then
		return 2
	end
	return if ax >= az then 1 else 3
end

-- Почти целые значения делаем целыми: повороты на 90° получаются идеально ровными.
local function clean(x: number): number
	local r = math.round(x)
	return if math.abs(x - r) < 1e-6 then r else x
end

local function round3(x: number): number
	return math.round(x * 1000) / 1000
end

-- Центр округляем до 1/1000 студа: клиент и сервер видят одно и то же число.
local function roundVector(v: Vector3): Vector3
	return Vector3.new(round3(v.X), round3(v.Y), round3(v.Z))
end

-- Высота верхней грани плиты в локальных координатах участка.
local function surfaceY(plot: BasePart): number
	return plot.Size.Y / 2
end

-- Привязывает центр к сетке по одной оси: округляем НИЖНИЙ/ЛЕВЫЙ край до шага,
-- так формы любой кратной шагу длины встают ровно по линиям сетки.
local function snapAxis(center: number, extent: number, origin: number, step: number): number
	local minEdge = center - extent / 2
	local snappedMin = origin + math.floor((minEdge - origin) / step + 0.5) * step
	return snappedMin + extent / 2
end

-- Половина «толщины» повёрнутой коробки вдоль направления n (единичный вектор):
-- на столько центр должен отстоять от грани, чтобы фигура касалась её вплотную.
local function supportHalf(rotation: CFrame, size: Vector3, n: Vector3): number
	return 0.5
		* (
			math.abs(n:Dot(rotation.RightVector)) * size.X
			+ math.abs(n:Dot(rotation.UpVector)) * size.Y
			+ math.abs(n:Dot(rotation.LookVector)) * size.Z
		)
end

-- ===== Поворот =====

-- Угол из сети: число, кратное MinRotationStep, в диапазоне [0, 360).
function BuildGrid.isValidAngle(value: unknown): boolean
	if typeof(value) ~= "number" then
		return false
	end
	local v = value :: number
	return v == v and v >= 0 and v < 360 and v % BuildConfig.MinRotationStep == 0
end

-- Добавляет шаг к углу и возвращает его в диапазон [0, 360).
function BuildGrid.addAngle(current: number, step: number): number
	return (current + step) % 360
end

-- Поворот фигуры в координатах участка: yaw (Y) * pitch (X) * roll (Z).
-- Yaw внешний, поэтому R всегда крутит вокруг вертикали, а T/Y наклоняют фигуру
-- относительно её собственного «перёда».
function BuildGrid.makeRotation(angles: Angles): CFrame
	local raw = CFrame.Angles(0, math.rad(angles.yaw), 0)
		* CFrame.Angles(math.rad(angles.pitch), 0, 0)
		* CFrame.Angles(0, 0, math.rad(angles.roll))
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = raw:GetComponents()
	return CFrame.new(
		0,
		0,
		0,
		clean(r00),
		clean(r01),
		clean(r02),
		clean(r10),
		clean(r11),
		clean(r12),
		clean(r20),
		clean(r21),
		clean(r22)
	)
end

-- Габариты повёрнутой коробки в осях участка (AABB).
function BuildGrid.getExtents(rotation: CFrame, size: Vector3): Vector3
	local r, u, l = rotation.RightVector, rotation.UpVector, rotation.LookVector
	return Vector3.new(
		math.abs(r.X) * size.X + math.abs(u.X) * size.Y + math.abs(l.X) * size.Z,
		math.abs(r.Y) * size.X + math.abs(u.Y) * size.Y + math.abs(l.Y) * size.Z,
		math.abs(r.Z) * size.X + math.abs(u.Z) * size.Y + math.abs(l.Z) * size.Z
	)
end

-- ===== Геометрия граней =====

-- Грань детали-коробки, в которую попал луч: центр грани и её нормаль (мир).
-- Для вырезанных блоков (UnionOperation) берётся грань их габаритной коробки.
function BuildGrid.getFace(part: BasePart, worldNormal: Vector3): (Vector3, Vector3)
	local localNormal = part.CFrame:VectorToObjectSpace(worldNormal)
	local axis = dominantAxis(localNormal)
	local sign = if component(localNormal, axis) >= 0 then 1 else -1
	local axisVector = AXES[axis] * sign
	local half = component(part.Size, axis) / 2
	return part.CFrame:PointToWorldSpace(axisVector * half), part.CFrame:VectorToWorldSpace(axisVector)
end

-- Коробка inner целиком внутри коробки outer (все 8 углов)?
function BuildGrid.isBoxInside(innerCFrame: CFrame, innerSize: Vector3, outerCFrame: CFrame, outerSize: Vector3): boolean
	local half = innerSize / 2
	local limit = outerSize / 2 + Vector3.one * EPSILON
	for _, sx in CORNER_SIGNS do
		for _, sy in CORNER_SIGNS do
			for _, sz in CORNER_SIGNS do
				local corner = innerCFrame:PointToWorldSpace(Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
				local p = outerCFrame:PointToObjectSpace(corner)
				if math.abs(p.X) > limit.X or math.abs(p.Y) > limit.Y or math.abs(p.Z) > limit.Z then
					return false
				end
			end
		end
	end
	return true
end

-- ===== Расчёт позиции призрака (клиент) =====

function BuildGrid.computePlacement(req: PlacementRequest): Placement?
	local shape = BuildConfig.Shapes[req.shapeId]
	if not shape then
		return nil
	end

	local plot = req.plot
	local plotCFrame = plot.CFrame
	local size = req.size or shape.size
	local rotation = BuildGrid.makeRotation(req.angles)
	local extents = BuildGrid.getExtents(rotation, size)
	-- Установка — фигура снаружи грани; резак — утоплен в грань (прорезает внутрь блока).
	local direction = if req.inward then -1 else 1
	local center: Vector3

	if req.snapToCenter and req.hitPart ~= plot then
		-- «Магнит к центру»: ровно по центру грани блока под курсором, сетка не нужна.
		local faceCenter, faceNormal = BuildGrid.getFace(req.hitPart, req.hitNormal)
		local p = plotCFrame:PointToObjectSpace(faceCenter)
		local n = plotCFrame:VectorToObjectSpace(faceNormal)
		center = p + n * (supportHalf(rotation, size, n) * direction)
	else
		-- Шаг 1. Точка касания и нормаль в координатах участка.
		local p = plotCFrame:PointToObjectSpace(req.hitPos)
		local n = plotCFrame:VectorToObjectSpace(req.hitNormal).Unit
		if req.hitPart:IsA("Part") then
			-- Обычный блок или плита: берём точную плоскость грани, чтобы не было
			-- микрозазоров из-за погрешности луча.
			local faceCenter, faceNormal = BuildGrid.getFace(req.hitPart, req.hitNormal)
			local f = plotCFrame:PointToObjectSpace(faceCenter)
			n = plotCFrame:VectorToObjectSpace(faceNormal)
			p -= n * (p - f):Dot(n)
		end

		-- Шаг 2. Фигура касается грани вплотную (с учётом поворота и наклона).
		local half = supportHalf(rotation, size, n) * direction
		center = p + n * half

		-- Шаг 3. Сетка: привязываем две оси вдоль грани, по оси нормали фигура
		-- остаётся вплотную к грани. При шаге 0 — свободное перемещение.
		local step = req.gridStep
		if step > 0 then
			local normalAxis = dominantAxis(n)
			local origins = Vector3.new(-plot.Size.X / 2, surfaceY(plot), -plot.Size.Z / 2)
			for axis = 1, 3 do
				if axis ~= normalAxis then
					-- Тонкая полоса резака встаёт на линию сетки серединой, а не краем.
					local extent = component(extents, axis)
					if extent <= BuildConfig.BladeThickness + EPSILON then
						extent = 0
					end
					local snapped = snapAxis(component(center, axis), extent, component(origins, axis), step)
					center = withComponent(center, axis, snapped)
				end
			end
			-- Наклонная грань (повёрнутый блок): после привязки возвращаем фигуру в контакт.
			local drift = (center - p):Dot(n) - half
			if math.abs(drift) > 1e-4 then
				center -= n * drift
			end
		end
	end

	center = roundVector(center)
	return {
		cframe = plotCFrame * CFrame.new(center) * rotation,
		localCenter = center,
		extents = extents,
	}
end

-- ===== Проверки (клиент и сервер) =====

-- Сервер: собирает Placement из присланных клиентом центра и углов (углы уже проверены).
function BuildGrid.fromLocal(
	plot: BasePart,
	shapeId: string,
	localCenter: Vector3,
	angles: Angles,
	size: Vector3?
): Placement?
	local shape = BuildConfig.Shapes[shapeId]
	if not shape then
		return nil
	end
	local rotation = BuildGrid.makeRotation(angles)
	local center = roundVector(localCenter)
	return {
		cframe = plot.CFrame * CFrame.new(center) * rotation,
		localCenter = center,
		extents = BuildGrid.getExtents(rotation, size or shape.size),
	}
end

-- Фигура целиком внутри строительной зоны: внутри плиты 200x200 (минус отступ
-- под бордюр), не ниже поверхности и не выше BuildHeight.
function BuildGrid.isInsideArea(plot: BasePart, localCenter: Vector3, extents: Vector3): boolean
	local halfX = plot.Size.X / 2 - BuildConfig.EdgeInset
	local halfZ = plot.Size.Z / 2 - BuildConfig.EdgeInset
	local bottom = localCenter.Y - extents.Y / 2
	local top = localCenter.Y + extents.Y / 2
	local surface = surfaceY(plot)

	return math.abs(localCenter.X) + extents.X / 2 <= halfX + EPSILON
		and math.abs(localCenter.Z) + extents.Z / 2 <= halfZ + EPSILON
		and bottom >= surface - EPSILON
		and top <= surface + PlotConfig.BuildHeight + EPSILON
end

-- Невидимая деталь-«щуп» для точной проверки пересечений (GetPartsInPart).
-- В мире она находится только на время одного запроса.
local probe: Part? = nil

local function getProbe(): Part
	local existing = probe
	if existing then
		return existing
	end
	local created = Instance.new("Part")
	created.Name = "BuildProbe"
	created.Anchored = true
	created.CanCollide = false
	created.CanTouch = false
	created.CastShadow = false
	created.Transparency = 1
	probe = created
	return created
end

-- Детали из папок folders, которые реально пересекают коробку (cframe, size).
-- Проверка идёт по настоящей геометрии, поэтому проёмы, вырезанные резаком,
-- считаются пустым местом (туда можно поставить блок).
function BuildGrid.queryBox(cframe: CFrame, size: Vector3, folders: { Instance }): { BasePart }
	if #folders == 0 then
		return {}
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = folders

	local p = getProbe()
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	p.CFrame = cframe
	p.Parent = workspace
	local parts = workspace:GetPartsInPart(p, params)
	p.Parent = nil
	return parts
end

local function plotFolders(plot: BasePart, withDecor: boolean): { Instance }
	local folders: { Instance } = {}
	local blocks = plot:FindFirstChild(BuildConfig.BlocksFolderName)
	if blocks then
		table.insert(folders, blocks)
	end
	local decor = if withDecor then plot:FindFirstChild(BuildConfig.DecorFolderName) else nil
	if decor then
		table.insert(folders, decor)
	end
	return folders
end

-- Пересекается ли фигура с поставленными блоками или декором участка.
-- Коробку чуть уменьшаем, чтобы соседи, касающиеся гранями, не мешали.
function BuildGrid.isBlocked(plot: BasePart, cframe: CFrame, size: Vector3): boolean
	local shrunk = size - Vector3.one * (BuildConfig.OverlapTolerance * 2)
	return #BuildGrid.queryBox(cframe, shrunk, plotFolders(plot, true)) > 0
end

-- То же для любой формы, включая составные: проверяются коробки из BlockLibrary
-- (у арки — опоры и свод, у лестницы — ступени), поэтому под аркой и над ступенями
-- можно строить. Каждая коробка уменьшается на тот же допуск касания.
function BuildGrid.isShapeBlocked(plot: BasePart, cframe: CFrame, shapeId: string): boolean
	local boxes = BlockLibrary.getCollisionBoxes(shapeId)
	if #boxes == 0 then
		return true
	end
	local folders = plotFolders(plot, true)
	local inset = Vector3.one * (BuildConfig.OverlapTolerance * 2)
	for _, box in boxes do
		local shrunk = (box.size - inset):Max(Vector3.one * 0.01)
		if #BuildGrid.queryBox(cframe * box.cframe, shrunk, folders) > 0 then
			return true
		end
	end
	return false
end

-- Свои блоки, которые задевает резак (их и будет резать сервер).
-- Составные модели не режутся: берём только Part'ы, лежащие прямо в папке Blocks.
function BuildGrid.findCarveTargets(plot: BasePart, cframe: CFrame, size: Vector3, ownerUserId: number): { BasePart }
	local blocks = plot:FindFirstChild(BuildConfig.BlocksFolderName)
	if not blocks then
		return {}
	end
	local shrunk = size - Vector3.one * (BuildConfig.OverlapTolerance * 2)
	local targets: { BasePart } = {}
	for _, part in BuildGrid.queryBox(cframe, shrunk, { blocks }) do
		if part.Parent == blocks and part:GetAttribute(BuildConfig.Attributes.OwnerUserId) == ownerUserId then
			table.insert(targets, part)
		end
	end
	return targets
end

-- ---------------------------------------------------------------------------
-- Перенос уже поставленного блока (режим «Двигать»).
-- ---------------------------------------------------------------------------

BuildGrid.roundVector = roundVector

-- Все детали блока: сам Part / CSG-результат или детали составной модели.
-- Скрижали (декор на гранях) в габарит и пересечения не входят.
function BuildGrid.blockParts(block: Instance): { BasePart }
	local parts: { BasePart } = {}
	if block:IsA("BasePart") then
		table.insert(parts, block)
	end
	for _, descendant in block:GetDescendants() do
		if descendant:IsA("BasePart") and descendant:GetAttribute(BuildConfig.Attributes.TabletId) == nil then
			table.insert(parts, descendant)
		end
	end
	return parts
end

-- Сдвигает блок целиком. У одиночной детали PivotTo не двигает потомков,
-- поэтому висящие на ней скрижали переносим вручную.
function BuildGrid.shiftBlock(block: PVInstance, worldOffset: Vector3)
	block:PivotTo(block:GetPivot() + worldOffset)
	if block:IsA("BasePart") then
		for _, descendant in block:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.CFrame += worldOffset
			end
		end
	end
end

-- Габарит блока по осям участка: центр и размеры в координатах участка.
function BuildGrid.getBlockBounds(plot: BasePart, block: Instance): (Vector3?, Vector3?)
	local minCorner: Vector3? = nil
	local maxCorner: Vector3? = nil
	for _, part in BuildGrid.blockParts(block) do
		local relative = plot.CFrame:ToObjectSpace(part.CFrame)
		local half = BuildGrid.getExtents(relative.Rotation, part.Size) / 2
		local low, high = relative.Position - half, relative.Position + half
		minCorner = if minCorner then minCorner:Min(low) else low
		maxCorner = if maxCorner then maxCorner:Max(high) else high
	end
	if not minCorner or not maxCorner then
		return nil, nil
	end
	return (minCorner + maxCorner) / 2, maxCorner - minCorner
end

-- Смещение вдоль одной оси участка (1 = X, 2 = Y, 3 = Z) с привязкой края блока к сетке.
function BuildGrid.snapMove(
	plot: BasePart,
	localCenter: Vector3,
	extents: Vector3,
	axis: number,
	distance: number,
	gridStep: number
): number
	local start = component(localCenter, axis)
	if gridStep <= 0 then
		return round3(distance)
	end
	local origins = Vector3.new(-plot.Size.X / 2, surfaceY(plot), -plot.Size.Z / 2)
	local snapped = snapAxis(start + distance, component(extents, axis), component(origins, axis), gridStep)
	return round3(snapped - start)
end

-- Задевает ли блок после сдвига чужую геометрию (собственные детали не в счёт).
function BuildGrid.isMoveBlocked(plot: BasePart, block: Instance, localOffset: Vector3): boolean
	local worldOffset = plot.CFrame:VectorToWorldSpace(localOffset)
	local folders = plotFolders(plot, true)
	local inset = Vector3.one * (BuildConfig.OverlapTolerance * 2)
	for _, part in BuildGrid.blockParts(block) do
		local shrunk = (part.Size - inset):Max(Vector3.one * 0.01)
		for _, hit in BuildGrid.queryBox(part.CFrame + worldOffset, shrunk, folders) do
			if hit ~= block and not hit:IsDescendantOf(block) then
				return true
			end
		end
	end
	return false
end

return BuildGrid
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD45"><Properties><string name="Name">BuildSize</string><string name="Source"><![CDATA[--!strict
-- BuildSize: пользовательские размеры блока и резака (X, Y, Z).
-- Общий модуль: панель «Точность» считает шаг кнопок −/+, сервер проверяет присланный размер.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)

local BuildSize = {}

local EPSILON = 1e-4

local function round3(x: number): number
	return math.round(x * 1000) / 1000
end

function BuildSize.round(size: Vector3): Vector3
	return Vector3.new(round3(size.X), round3(size.Y), round3(size.Z))
end

function BuildSize.clamp(value: number, minSize: number): number
	return round3(math.clamp(value, minSize, BuildConfig.MaxBlockSize))
end

-- Сервер: размер от клиента — конечный Vector3 в пределах [minSize, MaxBlockSize].
function BuildSize.isValid(value: unknown, minSize: number): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	local size = value :: Vector3
	for _, c in { size.X, size.Y, size.Z } do
		if c ~= c or c < minSize - EPSILON or c > BuildConfig.MaxBlockSize + EPSILON then
			return false
		end
	end
	return true
end

-- Кнопки −/+: к ближайшему кратному шага сетки в нужную сторону (при сетке «0» — мелкий шаг).
function BuildSize.nudge(value: number, gridStep: number, direction: number, minSize: number): number
	local step = if gridStep > 0 then gridStep else BuildConfig.FreeSizeStep
	local ratio = value / step
	local nextValue = if direction > 0
		then (math.floor(ratio + EPSILON) + 1) * step
		else (math.ceil(ratio - EPSILON) - 1) * step
	return BuildSize.clamp(nextValue, minSize)
end

-- Текст из поля ввода; запятая допускается как десятичный разделитель.
function BuildSize.parse(text: string): number?
	local n = tonumber((string.gsub(text, ",", ".")))
	if not n or n ~= n or math.abs(n) == math.huge then
		return nil
	end
	return n
end

function BuildSize.format(value: number): string
	return (string.gsub(string.format("%.3f", value), "%.?0+$", ""))
end

-- Полоса резака: ширина и высота от игрока, толщина фиксирована.
function BuildSize.blade(size: Vector3): Vector3
	return Vector3.new(size.X, size.Y, BuildConfig.BladeThickness)
end

return BuildSize
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD48"><Properties><string name="Name">PaintCatalog</string><string name="Source"><![CDATA[--!strict
-- PaintCatalog: единый источник данных меню «Покраска / Скрижали».
-- Клиент рисует по нему образцы и карточки, сервер по id находит материал или текст скрижали.

export type Material = {
	id: string,
	displayName: string,
	material: Enum.Material,
	color: Color3,
	reflectance: number,
}

export type TabletStyle = "Stone" | "DarkStone"

export type Tablet = {
	id: string,
	title: string,
	factionId: string, -- «родная» фракция (скрижали доступны всем, своя отмечается ★)
	factionName: string,
	style: TabletStyle,
	text: string,
}

local PaintCatalog = {}

PaintCatalog.Materials = {
	{
		id = "Gold",
		displayName = "Золото",
		material = Enum.Material.Foil,
		color = Color3.fromRGB(212, 175, 55),
		reflectance = 0.2,
	},
	{
		id = "Lapis",
		displayName = "Лазурит",
		material = Enum.Material.Marble,
		color = Color3.fromRGB(34, 76, 164),
		reflectance = 0.05,
	},
	{
		id = "Marble",
		displayName = "Мрамор",
		material = Enum.Material.Marble,
		color = Color3.fromRGB(240, 238, 232),
		reflectance = 0,
	},
	{
		id = "Sandstone",
		displayName = "Песчаник",
		material = Enum.Material.Sandstone,
		color = Color3.fromRGB(214, 180, 120),
		reflectance = 0,
	},
	{
		id = "Obsidian",
		displayName = "Обсидиан",
		material = Enum.Material.Slate,
		color = Color3.fromRGB(24, 22, 30),
		reflectance = 0.18,
	},
	{
		id = "Bronze",
		displayName = "Бронза",
		material = Enum.Material.Metal,
		color = Color3.fromRGB(176, 114, 54),
		reflectance = 0.1,
	},
} :: { Material }

PaintCatalog.Tablets = {
	{
		id = "Tutankhamun",
		title = "Захоронение Тутанхамона",
		factionId = "Egypt",
		factionName = "Египет",
		style = "DarkStone",
		text = "Тутанхамон был славным правителем, считался одним из лучших богов. "
			.. "Жаль, он нас покинул и не освятил нашу пирамиду, вот и захоронился в ней...",
	},
	{
		id = "Caesar",
		title = "Дух Цезаря",
		factionId = "Rome",
		factionName = "Рим",
		style = "Stone",
		text = "Был один бог Цезарь, прославил и отдал половину духа в Колизей. "
			.. "Вот Цезарь любил народ, восхищался Колизеем, и проживет тот 1000 лет. "
			.. "Но к сожалению, бог не вечный — предал нашу душу брат его честной...",
	},
	{
		id = "Olympus",
		title = "Пророчество Олимпа",
		factionId = "Greece",
		factionName = "Греция",
		style = "Stone",
		text = "Боги спустились с Олимпа и велели воздвигнуть этот храм. "
			.. "Коли колонны коснутся облаков, Зевс благословит народ, "
			.. "а коли дрогнут — пошлет грозу на земли наши...",
	},
} :: { Tablet }

PaintCatalog.MaterialById = {} :: { [string]: Material }
for _, material in PaintCatalog.Materials do
	PaintCatalog.MaterialById[material.id] = material
end

PaintCatalog.TabletById = {} :: { [string]: Tablet }
for _, tablet in PaintCatalog.Tablets do
	PaintCatalog.TabletById[tablet.id] = tablet
end

return PaintCatalog
]]></string></Properties></Item>
</Item>
  </Item>
  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[--!strict
-- PlotService (Script): точка входа серверной части.
-- Слушает выбор фракции в Главном Меню и выдаёт игроку личный участок:
--   1) проверяет запрос от клиента,
--   2) занимает слот в сетке и строит участок (PlotBuilder),
--   3) закрепляет участок за игроком (PlotOwnership),
--   4) телепортирует персонажа в центр участка (PlotTeleporter).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FactionConfig = require(ReplicatedStorage.Shared.FactionConfig)
local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

local PlotAllocator = require(script.Parent.PlotAllocator)
local PlotBuilder = require(script.Parent.PlotBuilder)
local PlotOwnership = require(script.Parent.PlotOwnership)
local CharacterHider = require(script.Parent.CharacterHider)
local PlotTeleporter = require(script.Parent.PlotTeleporter)

-- Шаг 1. Подготовка: папка для участков и RemoteFunction для меню.
local plotsFolder = workspace:FindFirstChild(PlotConfig.FolderName)
if not plotsFolder then
	plotsFolder = Instance.new("Folder")
	plotsFolder.Name = PlotConfig.FolderName
	plotsFolder.Parent = workspace
end

local selectFaction = Instance.new("RemoteFunction")
selectFaction.Name = PlotConfig.RemoteName
selectFaction.Parent = ReplicatedStorage.Shared

local busyPlayers: { [Player]: boolean } = {} -- защита от повторных запросов

-- Полная очистка игрока: участок, закрепление и слот. Безопасно вызывать повторно.
local function releasePlayer(player: Player)
	local claim = PlotOwnership.release(player)
	if claim then
		claim.plot:Destroy()
	end
	PlotAllocator.release(player.UserId)
end

-- Шаг 2a. Телепортирует игрока в центр участка и прячет его персонажа:
-- дальше игрок смотрит на участок свободной камерой, персонаж ему не нужен.
local function placeOnPlot(player: Player, plot: Part): boolean
	if not PlotTeleporter.toPlot(player, plot) then
		return false
	end

	local character = player.Character
	if character then
		CharacterHider.hide(character)
	end
	return true
end

-- Шаг 2. Создаёт участок и переносит на него игрока.
local function assignPlot(player: Player, faction: FactionConfig.Faction): boolean
	-- Участок уже есть (повторный запрос): новый не строим, просто возвращаем на него.
	local existing = PlotOwnership.getClaim(player)
	if existing then
		return placeOnPlot(player, existing.plot)
	end

	-- Слот в сетке -> центр участка -> Part нужного стиля.
	local slot = PlotAllocator.acquire(player.UserId)
	local center = PlotAllocator.slotCenter(slot)
	local plot = PlotBuilder.build(plotsFolder, player, faction.id, slot, center)

	-- Закрепляем территорию ДО телепорта: она принадлежит игроку с первой секунды.
	PlotOwnership.claim(player, plot, faction.id)

	-- Телепорт. Если персонажа нет, откатываем всё, чтобы не осталось «мёртвых» участков.
	if not placeOnPlot(player, plot) then
		releasePlayer(player)
		return false
	end
	return true
end

-- Шаг 3. Обработчик сигнала из меню. Возвращаемое значение получает клиент:
-- true = всё готово, false = меню нужно вернуть на экран выбора.
selectFaction.OnServerInvoke = function(player: Player, factionId: unknown): boolean
	-- Данным от клиента верить нельзя: проверяем тип и существование фракции.
	if typeof(factionId) ~= "string" then
		return false
	end
	local faction = FactionConfig.ById[factionId]
	if not faction then
		warn(`[PlotService] {player.Name} прислал неизвестную фракцию: {factionId}`)
		return false
	end

	if busyPlayers[player] then
		return false
	end
	busyPlayers[player] = true

	local success, result = pcall(assignPlot, player, faction)
	busyPlayers[player] = nil

	if not success then
		warn(`[PlotService] Ошибка выдачи участка для {player.Name}: {result}`)
		releasePlayer(player)
		return false
	end
	return result
end

-- Шаг 4. Игрок вышел: удаляем участок и освобождаем слот для следующих.
Players.PlayerRemoving:Connect(function(player: Player)
	busyPlayers[player] = nil
	releasePlayer(player)
end)

-- Шаг 5. Респавн: возвращаем игрока на его участок и снова прячем персонажа.
local function trackRespawns(player: Player)
	player.CharacterAdded:Connect(function()
		local claim = PlotOwnership.getClaim(player)
		if claim then
			placeOnPlot(player, claim.plot)
		end
	end)
end

Players.PlayerAdded:Connect(trackRespawns)
for _, player in Players:GetPlayers() do
	trackRespawns(player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">PlotAllocator</string>
          <string name="Source"><![CDATA[--!strict
-- PlotAllocator: раздаёт игрокам слоты сетки и считает центр участка по слоту.
-- Ничего не знает ни о Part'ах, ни о фракциях: только номера и координаты.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

local PlotAllocator = {}

local slotOwner: { [number]: number } = {} -- слот -> UserId
local slotOfUser: { [number]: number } = {} -- UserId -> слот

-- Центр участка для слота: слоты идут рядами по GridColumns штук.
function PlotAllocator.slotCenter(slot: number): Vector3
	local column = slot % PlotConfig.GridColumns
	local row = slot // PlotConfig.GridColumns
	local offset = Vector3.new(column * PlotConfig.GridSpacing, 0, row * PlotConfig.GridSpacing)
	return PlotConfig.GridOrigin + offset
end

-- Выдаёт игроку наименьший свободный слот (освободившиеся слоты переиспользуются).
-- Если слот у игрока уже есть, возвращает его же.
function PlotAllocator.acquire(userId: number): number
	local existing = slotOfUser[userId]
	if existing then
		return existing
	end

	local slot = 0
	while slotOwner[slot] do
		slot += 1
	end

	slotOwner[slot] = userId
	slotOfUser[userId] = slot
	return slot
end

-- Освобождает слот игрока (безопасно вызывать повторно).
function PlotAllocator.release(userId: number)
	local slot = slotOfUser[userId]
	if slot then
		slotOwner[slot] = nil
		slotOfUser[userId] = nil
	end
end

return PlotAllocator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">PlotBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- PlotBuilder: физически создаёт Part участка с нужным материалом и цветом,
-- сеткой для стройки, бордюром и угловыми элементами.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

local PlotBuilder = {}

-- Создаёт один анкерный Part-деталь декора.
local function addPart(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	material: Enum.Material,
	color: Color3
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.Material = material
	part.Color = color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- Едва заметная строительная сетка поверх участка (Texture на верхней грани).
local function addGrid(plot: Part)
	local grid = Instance.new("Texture")
	grid.Name = "BuildGrid"
	grid.Texture = PlotConfig.GridTexture
	grid.Face = Enum.NormalId.Top
	grid.StudsPerTileU = PlotConfig.GridStudsPerTile
	grid.StudsPerTileV = PlotConfig.GridStudsPerTile
	grid.Transparency = PlotConfig.GridTransparency
	grid.Color3 = PlotConfig.GridColor
	grid.Parent = plot
end

-- Бордюр: четыре планки по краю участка. Длинные (север/юг) идут на всю ширину,
-- короткие (восток/запад) заходят между ними, чтобы планки не пересекались.
local function addBorder(decor: Instance, center: Vector3, style: PlotConfig.PlotStyle)
	local half = PlotConfig.PlotSize / 2
	local width = PlotConfig.BorderWidth
	local height = PlotConfig.BorderHeight
	local surfaceY = center.Y + PlotConfig.PlotThickness / 2
	local y = surfaceY + height / 2
	local offset = half - width / 2

	local function rail(name: string, size: Vector3, dx: number, dz: number)
		addPart(
			decor,
			name,
			size,
			CFrame.new(center.X + dx, y, center.Z + dz),
			style.borderMaterial,
			style.borderColor
		)
	end

	local long = PlotConfig.PlotSize
	local short = PlotConfig.PlotSize - width * 2
	rail("BorderNorth", Vector3.new(long, height, width), 0, -offset)
	rail("BorderSouth", Vector3.new(long, height, width), 0, offset)
	rail("BorderEast", Vector3.new(width, height, short), offset, 0)
	rail("BorderWest", Vector3.new(width, height, short), -offset, 0)
end

-- Колонна: база + цилиндрический ствол + капитель.
local function addColumn(decor: Instance, name: string, base: Vector3, style: PlotConfig.PlotStyle)
	local baseSize = PlotConfig.CornerBaseSize
	local slab = 2 -- толщина базы и капители
	local shaftHeight = PlotConfig.CornerHeight - slab * 2
	local shaftDiameter = baseSize - 3

	addPart(
		decor,
		name .. "Base",
		Vector3.new(baseSize, slab, baseSize),
		CFrame.new(base + Vector3.new(0, slab / 2, 0)),
		style.cornerMaterial,
		style.cornerColor
	)

	-- Цилиндр Roblox вытянут вдоль оси X, поэтому поворачиваем его «стоймя».
	local shaft = addPart(
		decor,
		name .. "Shaft",
		Vector3.new(shaftHeight, shaftDiameter, shaftDiameter),
		CFrame.new(base + Vector3.new(0, slab + shaftHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		style.cornerMaterial,
		style.cornerColor
	)
	shaft.Shape = Enum.PartType.Cylinder

	addPart(
		decor,
		name .. "Capital",
		Vector3.new(baseSize, slab, baseSize),
		CFrame.new(base + Vector3.new(0, slab + shaftHeight + slab / 2, 0)),
		style.cornerMaterial,
		style.cornerColor
	)
end

-- Массивный блок с «шапкой» (для Египта).
local function addBlock(decor: Instance, name: string, base: Vector3, style: PlotConfig.PlotStyle)
	local baseSize = PlotConfig.CornerBaseSize
	local capHeight = 2
	local bodyHeight = PlotConfig.CornerHeight - capHeight

	addPart(
		decor,
		name .. "Body",
		Vector3.new(baseSize, bodyHeight, baseSize),
		CFrame.new(base + Vector3.new(0, bodyHeight / 2, 0)),
		style.cornerMaterial,
		style.cornerColor
	)
	addPart(
		decor,
		name .. "Cap",
		Vector3.new(baseSize - 2, capHeight, baseSize - 2),
		CFrame.new(base + Vector3.new(0, bodyHeight + capHeight / 2, 0)),
		style.borderMaterial,
		style.capColor or style.borderColor
	)
end

-- Угловые элементы: по одному в каждом углу, вплотную к внешнему краю участка.
local function addCorners(decor: Instance, center: Vector3, style: PlotConfig.PlotStyle)
	local surfaceY = center.Y + PlotConfig.PlotThickness / 2
	local inset = PlotConfig.PlotSize / 2 - PlotConfig.CornerBaseSize / 2
	local corners = {
		{ name = "CornerNE", sx = 1, sz = -1 },
		{ name = "CornerSE", sx = 1, sz = 1 },
		{ name = "CornerSW", sx = -1, sz = 1 },
		{ name = "CornerNW", sx = -1, sz = -1 },
	}

	for _, corner in corners do
		local base = Vector3.new(center.X + corner.sx * inset, surfaceY, center.Z + corner.sz * inset)
		if style.cornerKind == "Column" then
			addColumn(decor, corner.name, base, style)
		else
			addBlock(decor, corner.name, base, style)
		end
	end
end

-- Создаёт участок 200x200 с центром в `center` и помещает его в `parent`.
function PlotBuilder.build(parent: Instance, player: Player, factionId: string, slot: number, center: Vector3): Part
	-- Шаг 1. Стиль по фракции (песок для Египта, мрамор для Рима и Греции).
	local style = PlotConfig.Styles[factionId] or PlotConfig.DefaultStyle

	-- Шаг 2. Сам Part: размер, положение, материал, цвет.
	local plot = Instance.new("Part")
	plot.Name = `Plot_{player.UserId}`
	plot.Size = Vector3.new(PlotConfig.PlotSize, PlotConfig.PlotThickness, PlotConfig.PlotSize)
	plot.Position = center
	plot.Anchored = true
	plot.Material = style.material
	plot.Color = style.color
	plot.TopSurface = Enum.SurfaceType.Smooth
	plot.BottomSurface = Enum.SurfaceType.Smooth

	-- Шаг 3. Метки владельца: их удобно читать из любых будущих скриптов.
	plot:SetAttribute(PlotConfig.Attributes.OwnerUserId, player.UserId)
	plot:SetAttribute(PlotConfig.Attributes.FactionId, factionId)
	plot:SetAttribute(PlotConfig.Attributes.SlotIndex, slot)

	-- Шаг 4. Оформление: сетка, бордюр и углы. Декор лежит внутри участка (папка Decor),
	-- поэтому исчезает вместе с ним, когда PlotService удаляет участок.
	addGrid(plot)
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	addBorder(decor, center, style)
	addCorners(decor, center, style)
	decor.Parent = plot

	-- Папка для построек игрока (заполняет BuildService, имя = BuildConfig.BlocksFolderName).
	-- Лежит внутри участка, поэтому блоки удаляются вместе с ним.
	local blocks = Instance.new("Folder")
	blocks.Name = "Blocks"
	blocks.Parent = plot

	-- Parent задаём последним, когда Part полностью настроен.
	plot.Parent = parent
	return plot
end

return PlotBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">PlotOwnership</string>
          <string name="Source"><![CDATA[--!strict
-- PlotOwnership: реестр «чей участок». Закрепляет территорию за игроком и
-- отвечает на вопрос «может ли игрок строить в этой точке?».
-- Будущая система строительства должна вызывать PlotOwnership.canBuildAt
-- перед тем, как поставить блок.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

export type Claim = {
	player: Player,
	plot: Part,
	factionId: string,
}

local PlotOwnership = {}

local claims: { [number]: Claim } = {} -- UserId -> участок

-- Закрепляет участок за игроком.
function PlotOwnership.claim(player: Player, plot: Part, factionId: string)
	claims[player.UserId] = { player = player, plot = plot, factionId = factionId }
end

-- Участок игрока или nil, если он ещё не выбрал фракцию.
function PlotOwnership.getClaim(player: Player): Claim?
	return claims[player.UserId]
end

-- Снимает закрепление и возвращает снятую запись (nil, если её не было).
function PlotOwnership.release(player: Player): Claim?
	local claim = claims[player.UserId]
	claims[player.UserId] = nil
	return claim
end

-- Чей участок в этой точке мира? nil, если точка не принадлежит никому.
function PlotOwnership.getOwnerAt(position: Vector3): Player?
	for _, claim in claims do
		-- Переводим точку в локальные координаты участка и сравниваем с границами.
		local local_ = claim.plot.CFrame:PointToObjectSpace(position)
		local halfSize = claim.plot.Size / 2
		local insideX = math.abs(local_.X) <= halfSize.X
		local insideZ = math.abs(local_.Z) <= halfSize.Z
		local insideY = local_.Y >= -halfSize.Y and local_.Y <= halfSize.Y + PlotConfig.BuildHeight

		if insideX and insideZ and insideY then
			return claim.player
		end
	end
	return nil
end

-- Можно ли игроку строить в этой точке: только на собственном участке.
function PlotOwnership.canBuildAt(player: Player, position: Vector3): boolean
	return PlotOwnership.getOwnerAt(position) == player
end

return PlotOwnership
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">PlotTeleporter</string>
          <string name="Source"><![CDATA[--!strict
-- PlotTeleporter: ставит персонажа игрока ровно в центр его участка.

local PlotTeleporter = {}

local CHARACTER_WAIT_TIMEOUT = 5 -- сколько секунд ждать появления персонажа
local SAFETY_GAP = 0.5 -- небольшой зазор над поверхностью, чтобы не застрять в Part'е

-- Ждёт персонажа с HumanoidRootPart (игрок мог ещё не заспавниться).
local function waitForCharacter(player: Player): (Model?, BasePart?)
	local deadline = os.clock() + CHARACTER_WAIT_TIMEOUT
	repeat
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and root and root:IsA("BasePart") then
			return character, root
		end
		task.wait(0.1)
	until os.clock() >= deadline or player.Parent == nil

	return nil, nil
end

-- Телепортирует на участок. Возвращает false, если персонажа не удалось найти.
function PlotTeleporter.toPlot(player: Player, plot: Part): boolean
	local character, root = waitForCharacter(player)
	if not character or not root then
		warn(`[PlotTeleporter] У {player.Name} нет персонажа, телепорт отменён`)
		return false
	end

	-- Шаг 1. Высота от HumanoidRootPart до ступней: работает и для R15, и для R6.
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hipHeight = if humanoid then humanoid.HipHeight else 0
	local standHeight = math.max(hipHeight + root.Size.Y / 2, character:GetExtentsSize().Y / 2)

	-- Шаг 2. Центр участка по X/Z (ровно), по Y: верхняя грань + рост персонажа.
	local center = plot.Position
	local surfaceY = center.Y + plot.Size.Y / 2
	local target = Vector3.new(center.X, surfaceY + standHeight + SAFETY_GAP, center.Z)

	-- Шаг 3. Переносим и гасим скорость, чтобы персонажа не «унесло» после телепорта.
	character:PivotTo(CFrame.new(target))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return true
end

return PlotTeleporter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">CharacterHider</string>
          <string name="Source"><![CDATA[--!strict
-- CharacterHider: полностью прячет персонажа игрока, пока тот строит свободной камерой.
-- Делается на сервере, потому что изменения прозрачности на клиенте
-- не реплицируются, и другие игроки продолжали бы видеть персонажа.
--
-- Что именно делаем:
--   1) все части и аксессуары: Transparency = 1, без коллизий, лучи (Raycast) их не задевают;
--   2) лица (Decal), частицы, следы и таблички над головой выключаем;
--   3) HumanoidRootPart якорим: без коллизий персонаж иначе провалился бы сквозь плиту.

local CharacterHider = {}

-- Прячет один объект из персонажа (часть, лицо, эффект или табличку).
local function hideInstance(instance: Instance)
	if instance:IsA("BasePart") then
		instance.Transparency = 1
		instance.CanCollide = false
		instance.CanQuery = false -- луч мыши при будущей стройке пролетает сквозь персонажа
		instance.CanTouch = false
	elseif instance:IsA("Decal") then
		instance.Transparency = 1
	elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") then
		instance.Enabled = false
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = false
	end
end

-- Прячет персонажа. Вызывать после телепорта на участок.
function CharacterHider.hide(character: Model)
	-- Шаг 1. Убираем ник и полоску здоровья над головой.
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	-- Шаг 2. Прячем всё, что уже есть в персонаже.
	for _, descendant in character:GetDescendants() do
		hideInstance(descendant)
	end

	-- Шаг 3. Аксессуары и инструменты могут догрузиться позже: прячем и их.
	character.DescendantAdded:Connect(hideInstance)

	-- Шаг 4. Якорим корень, чтобы персонаж остался на месте, а не упал в пустоту.
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		root.Anchored = true
	end
end

return CharacterHider
]]></string>
        </Properties>
      </Item>
    <Item class="Script" referent="34"><Properties><string name="Name">BuildService</string><string name="Source"><![CDATA[--!strict
-- BuildService (Script): серверный обработчик строительного редактора.
-- Принимает запросы клиента «поставить» / «удалить» / «вырезать» и НИЧЕМУ не верит:
--   1) проверяет типы данных, форму и углы (кратны BuildConfig.MinRotationStep),
--   2) проверяет, что фигура на СВОЁМ участке (и для установки — ни с чем не пересекается),
--   3) спавнит блок (BlockFactory) или вырезает форму (BlockCarver -> SubtractAsync в pcall).
-- Шаг сетки (4 / 1 / 0.25 / свободно) — удобство клиента, сервер его не навязывает:
-- сервер отвечает за то, ГДЕ можно строить.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)
local BuildSize = require(ReplicatedStorage.Shared.BuildSize)
local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)

local PlotOwnership = require(script.Parent.PlotOwnership)
local BlockFactory = require(script.Parent.BlockFactory)
local BlockCarver = require(script.Parent.BlockCarver)
local BlockMover = require(script.Parent.BlockMover)
local BlockPainter = require(script.Parent.BlockPainter)
local TabletFactory = require(script.Parent.TabletFactory)

-- Шаг 1. RemoteEvent'ы для клиента.
local function makeRemote(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = ReplicatedStorage.Shared
	return remote
end

local placeRemote = makeRemote(BuildConfig.PlaceRemoteName)
local removeRemote = makeRemote(BuildConfig.RemoveRemoteName)
local carveRemote = makeRemote(BuildConfig.CarveRemoteName)
local moveRemote = makeRemote(BuildConfig.MoveRemoteName)
local paintRemote = makeRemote(BuildConfig.PaintRemoteName)
local tabletRemote = makeRemote(BuildConfig.TabletRemoteName)
local eraseRemote = makeRemote(BuildConfig.EraseTabletRemoteName)
local noticeRemote = makeRemote(BuildConfig.NoticeRemoteName)

type ShapeRequest = {
	claim: PlotOwnership.Claim,
	blocks: Folder,
	shapeId: string,
	size: Vector3,
	placement: BuildGrid.Placement,
}

local lastAction: { [Player]: { [string]: number } } = {}
local carving: { [Player]: boolean } = {} -- идёт CSG-операция этого игрока

-- Антиспам: true, если с прошлого такого действия прошло не меньше cooldown секунд.
local function cooldownPassed(player: Player, action: string, cooldown: number): boolean
	local timers = lastAction[player]
	if not timers then
		timers = {}
		lastAction[player] = timers
	end
	local now = os.clock()
	if now - (timers[action] or 0) < cooldown then
		return false
	end
	timers[action] = now
	return true
end

local function notify(player: Player, text: string)
	noticeRemote:FireClient(player, text)
end

local function isFiniteVector(v: Vector3): boolean
	for _, c in { v.X, v.Y, v.Z } do
		if c ~= c or math.abs(c) > 1e5 then -- NaN или бесконечность
			return false
		end
	end
	return true
end

-- Папка Blocks внутри участка (создаётся PlotBuilder; на всякий случай создаём и здесь).
-- Корень своего блока (прямой потомок Blocks на участке игрока) по любой его детали.
local function findOwnBlock(player: Player, clicked: Instance): (Instance?, PlotOwnership.Claim?)
	local claim = PlotOwnership.getClaim(player)
	if not claim then
		return nil, nil
	end
	local blocks = claim.plot:FindFirstChild(BuildConfig.BlocksFolderName)
	if not blocks or not clicked:IsDescendantOf(blocks) then
		return nil, nil
	end
	local target: Instance = clicked
	while target.Parent ~= blocks do
		local parent = target.Parent
		if not parent then
			return nil, nil
		end
		target = parent
	end
	if target:GetAttribute(BuildConfig.Attributes.OwnerUserId) ~= player.UserId then
		return nil, nil
	end
	return target, claim
end

local function getBlocksFolder(plot: Part): Folder
	local folder = plot:FindFirstChild(BuildConfig.BlocksFolderName)
	if folder and folder:IsA("Folder") then
		return folder
	end
	local created = Instance.new("Folder")
	created.Name = BuildConfig.BlocksFolderName
	created.Parent = plot
	return created
end

-- Общий разбор запроса с фигурой: (shapeId, локальный центр, yaw, pitch, roll).
local function parseShapeRequest(
	player: Player,
	shapeId: unknown,
	localCenter: unknown,
	yaw: unknown,
	pitch: unknown,
	roll: unknown,
	size: unknown, -- свой размер (nil = стандартный размер формы)
	minSize: number
): ShapeRequest?
	if typeof(shapeId) ~= "string" or typeof(localCenter) ~= "Vector3" then
		return nil
	end
	local shape = BuildConfig.Shapes[shapeId]
	if not shape or not isFiniteVector(localCenter) then
		return nil
	end
	if not (BuildGrid.isValidAngle(yaw) and BuildGrid.isValidAngle(pitch) and BuildGrid.isValidAngle(roll)) then
		return nil
	end

	-- У игрока должен быть участок.
	local claim = PlotOwnership.getClaim(player)
	if not claim or not claim.plot.Parent then
		return nil
	end

	local angles: BuildGrid.Angles = { yaw = yaw :: number, pitch = pitch :: number, roll = roll :: number }
	-- Свой размер разрешён только базовым формам и только в допустимых пределах.
	local actualSize = shape.size
	if size ~= nil then
		if shape.prefab or not BuildSize.isValid(size, minSize) then
			return nil
		end
		actualSize = BuildSize.round(size :: Vector3)
	end

	local placement = BuildGrid.fromLocal(claim.plot, shapeId, localCenter, angles, actualSize)
	if not placement then
		return nil
	end
	-- Центр фигуры принадлежит участку именно этого игрока (реестр участков).
	if not PlotOwnership.canBuildAt(player, placement.cframe.Position) then
		return nil
	end

	return {
		claim = claim,
		blocks = getBlocksFolder(claim.plot),
		shapeId = shapeId,
		size = actualSize,
		placement = placement,
	}
end

-- Шаг 2. Установка блока.
placeRemote.OnServerEvent:Connect(
	function(
		player: Player,
		shapeId: unknown,
		localCenter: unknown,
		yaw: unknown,
		pitch: unknown,
		roll: unknown,
		size: unknown
	)
		if not cooldownPassed(player, "place", BuildConfig.PlaceCooldown) then
			return
		end
		local request =
			parseShapeRequest(player, shapeId, localCenter, yaw, pitch, roll, size, BuildConfig.MinBlockSize)
		if not request then
			return
		end
		if #request.blocks:GetChildren() >= BuildConfig.MaxBlocksPerPlayer then
			notify(player, string.format("Достигнут лимит: %d блоков", BuildConfig.MaxBlocksPerPlayer))
			return
		end

		local plot = request.claim.plot
		local placement = request.placement
		-- Фигура целиком внутри плиты 200x200 (с учётом поворота) и ни с чем не пересекается.
		if not BuildGrid.isInsideArea(plot, placement.localCenter, placement.extents) then
			return
		end
		-- Для составных блоков проверяются коробки деталей (см. BlockLibrary.getCollisionBoxes).
		-- Базовая форма — один бокс своего размера; составная — боксы из библиотеки.
		local shape = BuildConfig.Shapes[request.shapeId]
		local blocked = if shape.prefab
			then BuildGrid.isShapeBlocked(plot, placement.cframe, request.shapeId)
			else BuildGrid.isBlocked(plot, placement.cframe, request.size)
		if blocked then
			return
		end

		local block =
			BlockFactory.create(request.shapeId, request.claim.factionId, placement.cframe, player, request.size)
		if block then
			block.Parent = request.blocks
		end
	end
)

-- Шаг 3. Вырезание (Резак): форма призрака вычитается из своих блоков через CSG.
carveRemote.OnServerEvent:Connect(
	function(
		player: Player,
		shapeId: unknown,
		localCenter: unknown,
		yaw: unknown,
		pitch: unknown,
		roll: unknown,
		size: unknown
	)
		if carving[player] then
			return -- прошлый разрез ещё считается
		end
		if not cooldownPassed(player, "carve", BuildConfig.CarveCooldown) then
			return
		end
		-- Резаку разрешена толщина полосы: она тоньше минимального блока.
		local request =
			parseShapeRequest(player, shapeId, localCenter, yaw, pitch, roll, size, BuildConfig.BladeThickness)
		if not request then
			return
		end
		local shape = BuildConfig.Shapes[request.shapeId]
		if shape and shape.prefab then
			notify(player, "Резак работает только с базовыми формами")
			return
		end

		local placement = request.placement
		local targets = BuildGrid.findCarveTargets(request.claim.plot, placement.cframe, request.size, player.UserId)
		if #targets == 0 then
			notify(player, "Резак не задевает ни одного вашего блока")
			return
		end
		if #targets > BuildConfig.MaxCarveTargets then
			notify(player, string.format("Слишком много блоков под резаком (максимум %d)", BuildConfig.MaxCarveTargets))
			return
		end

		carving[player] = true
		local ok, result = pcall(BlockCarver.carve, targets, placement.cframe, request.size, request.blocks)
		carving[player] = nil

		if not ok then
			warn("[BuildService] Ошибка вырезания:", result)
			notify(player, "Не удалось вырезать форму")
		elseif result.failed > 0 then
			notify(
				player,
				string.format("Не удалось вырезать %d из %d: слишком сложное пересечение", result.failed, #targets)
			)
		end
	end
)

-- Шаг 4. Удаление (ЛКМ в режиме «Снос» или клавиша X): только свой блок своего участка.
-- Клиент может прислать любую деталь составной модели — поднимаемся до корня
-- (прямого ребёнка папки Blocks) и сносим блок целиком.
removeRemote.OnServerEvent:Connect(function(player: Player, clicked: unknown)
	if typeof(clicked) ~= "Instance" then
		return
	end
	if not cooldownPassed(player, "remove", BuildConfig.RemoveCooldown) then
		return
	end

	local target = findOwnBlock(player, clicked)
	if not target then
		return
	end

	target:Destroy()
end)

-- Шаг 5. Чистим таймеры вышедших игроков (сами блоки удаляются вместе с участком).
-- Перенос: клиент присылает блок и смещение в координатах участка (после отпускания стрелки).
moveRemote.OnServerEvent:Connect(function(player: Player, clicked: unknown, localOffset: unknown)
	if typeof(clicked) ~= "Instance" or typeof(localOffset) ~= "Vector3" then
		return
	end
	if not isFiniteVector(localOffset) or localOffset.Magnitude < 1e-3 then
		return
	end
	if carving[player] then
		return -- CSG может заменить блок прямо сейчас
	end
	if not cooldownPassed(player, "move", BuildConfig.MoveCooldown) then
		return
	end

	local target, claim = findOwnBlock(player, clicked)
	if not target or not claim or not target:IsA("PVInstance") then
		return
	end
	local destination = target:GetPivot().Position + claim.plot.CFrame:VectorToWorldSpace(localOffset)
	if not PlotOwnership.canBuildAt(player, destination) then
		return
	end

	local moved, reason = BlockMover.move(claim.plot, target, localOffset)
	if not moved and reason then
		notify(player, reason)
	end
end)

-- Полезная цель покраски / скрижали: деталь своего блока (сама скрижаль целью не считается).
local function findOwnPart(player: Player, clicked: unknown): (BasePart?, PlotOwnership.Claim?)
	if typeof(clicked) ~= "Instance" or not clicked:IsA("BasePart") then
		return nil, nil
	end
	if clicked:GetAttribute(BuildConfig.Attributes.TabletId) ~= nil then
		return nil, nil
	end
	local block, claim = findOwnBlock(player, clicked)
	if not block or not claim then
		return nil, nil
	end
	return clicked, claim
end

-- Покраска: клиент присылает деталь, по которой кликнул, и id материала из PaintCatalog.
paintRemote.OnServerEvent:Connect(function(player: Player, clicked: unknown, materialId: unknown)
	if typeof(materialId) ~= "string" then
		return
	end
	local material = PaintCatalog.MaterialById[materialId]
	if not material or not cooldownPassed(player, "paint", BuildConfig.PaintCooldown) then
		return
	end
	local part = findOwnPart(player, clicked)
	if part then
		BlockPainter.paint(part, material)
	end
end)

-- Скрижаль: деталь, точка и нормаль попадания луча, id скрижали.
tabletRemote.OnServerEvent:Connect(
	function(player: Player, clicked: unknown, hitPos: unknown, hitNormal: unknown, tabletId: unknown)
		if typeof(hitPos) ~= "Vector3" or typeof(hitNormal) ~= "Vector3" or typeof(tabletId) ~= "string" then
			return
		end
		local tablet = PaintCatalog.TabletById[tabletId]
		if not tablet or not isFiniteVector(hitPos) or not isFiniteVector(hitNormal) then
			return
		end
		if math.abs(hitNormal.Magnitude - 1) > 0.01 then
			return
		end
		if not cooldownPassed(player, "tablet", BuildConfig.TabletCooldown) then
			return
		end
		local part, claim = findOwnPart(player, clicked)
		if not part or not claim or not PlotOwnership.canBuildAt(player, hitPos) then
			return
		end
		-- Точка должна лежать на самой детали, а не где-то в стороне от неё.
		local offset = part.CFrame:PointToObjectSpace(hitPos)
		local reach = part.Size / 2 + Vector3.one * 0.5
		if math.abs(offset.X) > reach.X or math.abs(offset.Y) > reach.Y or math.abs(offset.Z) > reach.Z then
			return
		end
		if TabletFactory.count(getBlocksFolder(claim.plot)) >= BuildConfig.MaxTabletsPerPlayer then
			notify(player, string.format("Достигнут лимит: %d скрижалей", BuildConfig.MaxTabletsPerPlayer))
			return
		end
		TabletFactory.place(claim.plot, part, hitPos, hitNormal, tablet)
	end
)

-- «Очистить грань»: снять скрижали с грани, по которой кликнули.
eraseRemote.OnServerEvent:Connect(function(player: Player, clicked: unknown, hitNormal: unknown)
	if typeof(hitNormal) ~= "Vector3" or not isFiniteVector(hitNormal) then
		return
	end
	if math.abs(hitNormal.Magnitude - 1) > 0.01 then
		return
	end
	if not cooldownPassed(player, "erase", BuildConfig.PaintCooldown) then
		return
	end
	local part = findOwnPart(player, clicked)
	if part and TabletFactory.erase(part, hitNormal) == 0 then
		notify(player, "На этой грани нет скрижалей")
	end
end)

Players.PlayerRemoving:Connect(function(player: Player)
	lastAction[player] = nil
	carving[player] = nil
end)
]]></string></Properties></Item>
<Item class="ModuleScript" referent="35"><Properties><string name="Name">BlockFactory</string><string name="Source"><![CDATA[--!strict
-- BlockFactory: создаёт реальный закреплённый (Anchored) блок нужной формы.
--   * Базовые формы (Блок, Стена, Опора, Плита) — один Part с материалом фракции
--     (песчаник для Египта, мрамор для Рима и Греции). Их же умеет резать резак.
--   * Составные формы (колонны, арки, лестницы, пирамиды, алтари...) — Model из
--     нескольких деталей по чертежу BlockLibrary с палитрой фракции (камень, окантовка,
--     золото, цветные вставки). Pivot модели = центр габаритной коробки формы.
-- Метки владельца и формы ставятся на сам блок (Part или Model) — прямого ребёнка папки Blocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BlockLibrary = require(ReplicatedStorage.Shared.BlockLibrary)

local BlockFactory = {}

local function createBasic(shapeId: string, size: Vector3, factionId: string, cframe: CFrame): Part
	local look = BuildConfig.FactionMaterials[factionId] or BuildConfig.DefaultMaterial
	local part = Instance.new("Part")
	part.Name = shapeId
	part.Size = size
	part.CFrame = cframe
	part.Anchored = true
	part.CanCollide = true
	part.Material = look.material
	part.Color = look.color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- size — свой размер базовой формы (составные блоки всегда строятся в размере из библиотеки).
function BlockFactory.create(
	shapeId: string,
	factionId: string,
	cframe: CFrame,
	owner: Player,
	size: Vector3?
): Instance?
	local shape = BuildConfig.Shapes[shapeId]
	if not shape then
		return nil
	end

	local block: Instance?
	if shape.prefab then
		block = BlockLibrary.buildModel(shapeId, factionId, cframe)
	else
		block = createBasic(shapeId, size or shape.size, factionId, cframe)
	end
	if not block then
		return nil
	end

	-- Метки: чей блок и какой формы (проверяются при удалении).
	block:SetAttribute(BuildConfig.Attributes.OwnerUserId, owner.UserId)
	block:SetAttribute(BuildConfig.Attributes.ShapeId, shapeId)
	return block
end

return BlockFactory
]]></string></Properties></Item>
<Item class="ModuleScript" referent="36"><Properties><string name="Name">BlockCarver</string><string name="Source"><![CDATA[--!strict
-- BlockCarver (сервер): вырезание формы из блоков с помощью Roblox CSG
-- (Solid Modeling, BasePart:SubtractAsync). Так прорезаются дверные проёмы, окна и ниши.
--
-- Каждый вызов SubtractAsync обёрнут в pcall: на сложных пересечениях
-- (слишком много треугольников, вырожденная геометрия, пустой результат)
-- движок бросает ошибку — тогда блок просто остаётся как был.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)

export type CarveResult = {
	carved: number, -- сколько блоков прорезано
	removed: number, -- сколько блоков резак накрыл целиком (они удалены)
	failed: number, -- на скольких CSG не справился (блок не изменился)
}

local BlockCarver = {}

-- Невидимая деталь-резак той же формы, что и призрак (чуть больше, см. CutterInflate).
local function makeCutter(cframe: CFrame, size: Vector3): Part
	local cutter = Instance.new("Part")
	cutter.Name = "BuildCutter"
	-- Тонкую сторону полосы не раздуваем: пропил остаётся ровно в её толщину.
	local function inflate(side: number): number
		return if side > BuildConfig.BladeThickness + 1e-3 then side + BuildConfig.CutterInflate * 2 else side
	end
	cutter.Size = Vector3.new(inflate(size.X), inflate(size.Y), inflate(size.Z))
	cutter.CFrame = cframe
	cutter.Anchored = true
	cutter.CanCollide = false
	cutter.CanTouch = false
	cutter.CanQuery = false
	cutter.CastShadow = false
	cutter.Transparency = 1
	return cutter
end

-- Переносит на результат CSG всё, что важно для игры: метки владельца, физику и вид.
local function adopt(union: BasePart, original: BasePart)
	for name, value in original:GetAttributes() do
		union:SetAttribute(name, value)
	end
	union.Name = original.Name
	union.Anchored = true
	union.CanCollide = true
	union.CanQuery = true
	union.CanTouch = true
	union.Material = original.Material
	union.Color = original.Color
	union.Reflectance = original.Reflectance
	-- Скрижали с граней исходного блока переезжают на результат.
	for _, child in original:GetChildren() do
		if child:GetAttribute(BuildConfig.Attributes.TabletId) ~= nil then
			child.Parent = union
		end
	end
	if union:IsA("UnionOperation") then
		-- Стенки среза красим цветом блока, а не цветом резака.
		union.UsePartColor = true
	end
end

-- Вырезает коробку (cutterCFrame, cutterSize) из каждого блока targets.
-- folder — папка Blocks участка: результат кладётся туда же, исходный блок удаляется.
function BlockCarver.carve(targets: { BasePart }, cutterCFrame: CFrame, cutterSize: Vector3, folder: Instance): CarveResult
	local result: CarveResult = { carved = 0, removed = 0, failed = 0 }
	local cutter = makeCutter(cutterCFrame, cutterSize)
	cutter.Parent = workspace

	for _, target in targets do
		if target.Parent ~= folder then
			continue -- блок уже удалили
		end

		-- Резак накрывает блок целиком: от блока ничего не останется — просто удаляем его
		-- (SubtractAsync с пустым результатом всё равно вернул бы ошибку).
		if BuildGrid.isBoxInside(target.CFrame, target.Size, cutter.CFrame, cutter.Size) then
			target:Destroy()
			result.removed += 1
			continue
		end

		-- Срез в материале и цвете самого блока.
		cutter.Material = target.Material
		cutter.Color = target.Color

		local ok, union = pcall(function()
			return target:SubtractAsync(
				{ cutter },
				Enum.CollisionFidelity.PreciseConvexDecomposition, -- точная коллизия: в проём можно пройти
				Enum.RenderFidelity.Automatic
			)
		end)

		if not ok then
			warn("[BlockCarver] SubtractAsync не справился:", union)
			result.failed += 1
		elseif typeof(union) == "Instance" and union:IsA("BasePart") then
			-- SubtractAsync уступает выполнение: за это время блок могли удалить.
			if target.Parent == folder then
				adopt(union, target)
				union.Parent = folder
				target:Destroy()
				result.carved += 1
			else
				union:Destroy()
			end
		else
			result.failed += 1
		end
	end

	cutter:Destroy()
	return result
end

return BlockCarver
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD46"><Properties><string name="Name">BlockMover</string><string name="Source"><![CDATA[--!strict
-- BlockMover (сервер): перенос уже поставленного блока (Part, CSG-результат или составная Model)
-- на смещение, присланное 3D-стрелками клиента. Блок сдвигается целиком, без поворота.
-- Клиенту не доверяем: новое место проверяется по границам участка и по пересечениям.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)

local BlockMover = {}

-- localOffset — смещение в координатах участка. Возвращает false и причину, если двигать нельзя.
function BlockMover.move(plot: BasePart, block: Instance, localOffset: Vector3): (boolean, string?)
	if not block:IsA("PVInstance") then
		return false, nil
	end
	local center, extents = BuildGrid.getBlockBounds(plot, block)
	if not center or not extents then
		return false, nil
	end

	local offset = BuildGrid.roundVector(localOffset)
	if not BuildGrid.isInsideArea(plot, center + offset, extents) then
		return false, "Сюда передвинуть нельзя: блок выходит за плиту"
	end
	if BuildGrid.isMoveBlocked(plot, block, offset) then
		return false, "Сюда передвинуть нельзя: мешает другой блок"
	end

	BuildGrid.shiftBlock(block, plot.CFrame:VectorToWorldSpace(offset))
	return true, nil
end

return BlockMover
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD49"><Properties><string name="Name">BlockPainter</string><string name="Source"><![CDATA[--!strict
-- BlockPainter (сервер): перекраска одной детали блока материалом из PaintCatalog.
-- Красится именно та деталь, по которой кликнули: у составной модели — отдельная часть.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)

local BlockPainter = {}

function BlockPainter.paint(part: BasePart, material: PaintCatalog.Material)
	part.Material = material.material
	part.Color = material.color
	part.Reflectance = material.reflectance
	if part:IsA("PartOperation") then
		part.UsePartColor = true -- иначе CSG-результат сохранит цвета исходных деталей
	end
end

return BlockPainter
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD50"><Properties><string name="Name">TabletFactory</string><string name="Source"><![CDATA[--!strict
-- TabletFactory (сервер): декоративные скрижали с надписью на гранях блоков.
--   * скрижаль — тонкая плита, прижатая к грани по нормали попадания луча, с SurfaceGui на лицевой стороне;
--   * она становится потомком детали, на которую повешена: сносится и переезжает вместе с блоком;
--   * плита не участвует в коллизиях и запросах (CanQuery = false), поэтому не мешает стройке,
--     а клики «проходят» сквозь неё в блок — так работает «Очистить грань».

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)
local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)

type Look = {
	material: Enum.Material,
	color: Color3,
	ink: Color3,
	border: Color3,
	borderTransparency: number,
	textStroke: number?, -- прозрачность тёмной обводки букв (nil = без обводки)
}

local LOOKS: { [PaintCatalog.TabletStyle]: Look } = {
	Stone = {
		material = Enum.Material.Limestone,
		color = Color3.fromRGB(196, 186, 165),
		ink = Color3.fromRGB(46, 38, 30),
		border = Color3.fromRGB(46, 38, 30),
		borderTransparency = 0.35,
	},
	-- Тёмный камень с золотом: светлые буквы с обводкой читаются при любом освещении.
	DarkStone = {
		material = Enum.Material.Slate,
		color = Color3.fromRGB(45, 35, 25),
		ink = Color3.fromRGB(255, 235, 180),
		border = Color3.fromRGB(255, 200, 60),
		borderTransparency = 0,
		textStroke = 0.15,
	},
}

local PIXELS_PER_STUD = 60
local TABLET_FONT = Enum.Font.Garamond -- античная антиква с кириллицей
local SAME_FACE_DOT = 0.9 -- скрижаль считается висящей на грани, если смотрит почти туда же

local TabletFactory = {}

local function isTablet(instance: Instance): boolean
	return instance:GetAttribute(BuildConfig.Attributes.TabletId) ~= nil
end

local function isBox(part: BasePart): boolean
	return part:IsA("Part") and part.Shape == Enum.PartType.Block
end

-- Протяжённость детали вдоль направления (для грани бокса — её ширина или высота).
local function span(part: BasePart, direction: Vector3): number
	local cframe, size = part.CFrame, part.Size
	return math.abs(direction:Dot(cframe.RightVector)) * size.X
		+ math.abs(direction:Dot(cframe.UpVector)) * size.Y
		+ math.abs(direction:Dot(cframe.LookVector)) * size.Z
end

local function makeLabel(name: string, text: string, look: Look, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Text = text
	label.Font = TABLET_FONT
	label.TextColor3 = look.ink
	if look.textStroke then
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = look.textStroke
	end
	label.TextScaled = true
	label.TextWrapped = true
	label.BackgroundTransparency = 1
	label.Parent = parent
	return label
end

local function buildInscription(tablet: PaintCatalog.Tablet, look: Look, parent: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Inscription"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = PIXELS_PER_STUD
	gui.LightInfluence = 0.4
	gui.Parent = parent

	-- Рамка с отступом от края плиты.
	local border = Instance.new("Frame")
	border.Name = "Border"
	border.AnchorPoint = Vector2.new(0.5, 0.5)
	border.Position = UDim2.fromScale(0.5, 0.5)
	border.Size = UDim2.fromScale(0.94, 0.9)
	border.BackgroundTransparency = 1
	border.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Color = look.border
	stroke.Thickness = 4
	stroke.Transparency = look.borderTransparency
	stroke.Parent = border

	local title = makeLabel("Title", tablet.title, look, border)
	title.Position = UDim2.fromScale(0.05, 0.05)
	title.Size = UDim2.fromScale(0.9, 0.2)

	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.AnchorPoint = Vector2.new(0.5, 0)
	divider.Position = UDim2.fromScale(0.5, 0.27)
	divider.Size = UDim2.new(0.6, 0, 0, 2)
	divider.BackgroundColor3 = look.border
	divider.BackgroundTransparency = look.borderTransparency
	divider.BorderSizePixel = 0
	divider.Parent = border

	local body = makeLabel("Body", tablet.text, look, border)
	body.Position = UDim2.fromScale(0.05, 0.31)
	body.Size = UDim2.fromScale(0.9, 0.63)
end

-- Вешает скрижаль на грань детали part в точке попадания луча (hitPos, hitNormal — мировые).
function TabletFactory.place(
	plot: BasePart,
	part: BasePart,
	hitPos: Vector3,
	hitNormal: Vector3,
	tablet: PaintCatalog.Tablet
): BasePart
	local full = BuildConfig.TabletSize
	local aspect = full.X / full.Y
	local point, normal = hitPos, hitNormal.Unit

	-- У бокса берём точную грань: скрижаль ложится вплотную, без наклона от погрешности нормали.
	local faceCenter: Vector3? = nil
	if isBox(part) then
		local center, faceNormal = BuildGrid.getFace(part, normal)
		faceCenter, normal = center, faceNormal
		point -= normal * (point - center):Dot(normal)
	end

	-- Верх надписи — вверх участка; на горизонтальной грани — «вперёд» участка.
	local plotCFrame = plot.CFrame
	local up = if math.abs(normal:Dot(plotCFrame.UpVector)) > 0.99 then plotCFrame.LookVector else plotCFrame.UpVector
	local facing = CFrame.lookAt(point, point + normal, up)
	local right, top = facing.RightVector, facing.UpVector

	-- Не шире и не выше грани (но и не мельче читаемого минимума).
	local spanRight, spanTop = span(part, right), span(part, top)
	local width = math.clamp(spanRight, BuildConfig.TabletMinWidth, full.X)
	local height = math.min(width / aspect, math.max(spanTop, BuildConfig.TabletMinWidth / aspect))
	width = height * aspect

	if faceCenter then
		-- Сдвигаем к центру грани ровно настолько, чтобы плита не свисала с края.
		local offset = point - faceCenter
		local limitRight = math.max((spanRight - width) / 2, 0)
		local limitTop = math.max((spanTop - height) / 2, 0)
		point = faceCenter
			+ right * math.clamp(offset:Dot(right), -limitRight, limitRight)
			+ top * math.clamp(offset:Dot(top), -limitTop, limitTop)
	end

	local position = point + normal * (full.Z / 2)

	-- Новая скрижаль заменяет те, что она перекрыла бы на этой же грани.
	for _, child in part:GetChildren() do
		if
			child:IsA("BasePart")
			and isTablet(child)
			and child.CFrame.LookVector:Dot(normal) > SAME_FACE_DOT
			and (child.Position - position).Magnitude < math.max(height, child.Size.Y)
		then
			child:Destroy()
		end
	end

	local look = LOOKS[tablet.style]
	local plaque = Instance.new("Part")
	plaque.Name = "Tablet"
	plaque.Size = Vector3.new(width, height, full.Z)
	plaque.CFrame = CFrame.lookAt(position, position + normal, up) -- лицевая грань (Front) смотрит наружу
	plaque.Anchored = true
	plaque.CanCollide = false
	plaque.CanQuery = false
	plaque.CanTouch = false
	plaque.CastShadow = false
	plaque.Material = look.material
	plaque.Color = look.color
	plaque.TopSurface = Enum.SurfaceType.Smooth
	plaque.BottomSurface = Enum.SurfaceType.Smooth
	plaque:SetAttribute(BuildConfig.Attributes.TabletId, tablet.id)
	buildInscription(tablet, look, plaque)
	plaque.Parent = part
	return plaque
end

-- Снимает все скрижали с грани детали, на которую указывает нормаль. Возвращает их число.
function TabletFactory.erase(part: BasePart, hitNormal: Vector3): number
	local normal = hitNormal.Unit
	if isBox(part) then
		local _, faceNormal = BuildGrid.getFace(part, normal)
		normal = faceNormal
	end
	local removed = 0
	for _, child in part:GetChildren() do
		if child:IsA("BasePart") and isTablet(child) and child.CFrame.LookVector:Dot(normal) > SAME_FACE_DOT then
			child:Destroy()
			removed += 1
		end
	end
	return removed
end

-- Сколько скрижалей уже висит на постройках участка.
function TabletFactory.count(blocks: Instance): number
	local total = 0
	for _, descendant in blocks:GetDescendants() do
		if isTablet(descendant) then
			total += 1
		end
	end
	return total
end

return TabletFactory
]]></string></Properties></Item>
</Item>
  </Item>
  <Item class="StarterPlayer" referent="5">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="6">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="8">
          <Properties>
            <string name="Name">MainMenu</string>
            <string name="Source"><![CDATA[--!strict
-- MainMenu (LocalScript): точка входа клиентского меню.
-- Rojo превращает папку MainMenu в LocalScript, а соседние .luau-файлы
-- становятся его дочерними ModuleScript'ами.

local Players = game:GetService("Players")

local MenuController = require(script.MenuController)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui") :: PlayerGui

MenuController.start(playerGui)
]]></string>
          </Properties>
<Item class="ModuleScript" referent="RBXSTEP50004">
<Properties>
<string name="Name">BlockPickerView</string>
<string name="Source"><![CDATA[--!strict
-- BlockPickerView: разметка компактного каталога блоков (кнопка «Блоки» / клавиша B).
-- Заголовок, вкладки категорий и прокручиваемая сетка плиток (ScrollingFrame + UIGridLayout).
-- Только разметка, без логики: фильтры, выбор и звёздочки — в BlockPickerController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BlockCatalog = require(ReplicatedStorage.Shared.BlockCatalog)
local Theme = require(script.Parent.Theme)
local UIFactory = require(script.Parent.UIFactory)

export type Tile = {
	button: TextButton,
	star: TextLabel, -- ★ «родной» блок фракции
	lock: TextLabel, -- «только стройка»: составной блок нельзя взять формой резака
	order: number,
}

export type View = {
	frame: Frame,
	scroll: ScrollingFrame,
	closeButton: TextButton,
	factionLabel: TextLabel,
	tabButtons: { [string]: TextButton },
	tiles: { [string]: Tile },
}

local PICKER_SIZE = Vector2.new(680, 330)
local TILE_SIZE = Vector2.new(120, 76)
local TAB_HEIGHT = 30
local TAB_GAP = 6
local GAP = 8

local BlockPickerView = {}

-- Над нижней панелью: её высота (84 + отступы) + нижний отступ + зазор.
BlockPickerView.ShownPosition = UDim2.new(0.5, 0, 1, -136)
BlockPickerView.HiddenPosition = UDim2.new(0.5, 0, 1, -116)

local function fitText(label: TextLabel, maxTextSize: number)
	label.TextScaled = true
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label
end

local function buildTile(entry: BlockCatalog.Entry, order: number, parent: Instance): Tile
	local button = UIFactory.button(entry.id .. "Tile", "", Theme.SecondaryButtonColor, parent)
	button.LayoutOrder = order

	local name = UIFactory.label("TileName", entry.displayName, 18, button)
	name.Position = UDim2.fromOffset(6, 8)
	name.Size = UDim2.new(1, -12, 0, 26)
	fitText(name, 19)

	local description = UIFactory.label("TileDescription", entry.description, 13, button)
	description.Font = Theme.BodyFont
	description.TextColor3 = Theme.SubTextColor
	description.TextWrapped = true
	description.Position = UDim2.fromOffset(6, 36)
	description.Size = UDim2.new(1, -12, 0, 32)
	fitText(description, 14)

	local star = UIFactory.label("Featured", "★", 16, button)
	star.AnchorPoint = Vector2.new(1, 0)
	star.Position = UDim2.new(1, -4, 0, 2)
	star.Size = UDim2.fromOffset(18, 18)
	star.TextColor3 = Theme.PanelStroke
	star.Visible = false

	local lock = UIFactory.label("BuildOnly", "только стройка", 11, button)
	lock.Font = Theme.BodyFont
	lock.TextColor3 = Theme.SubTextColor
	lock.AnchorPoint = Vector2.new(0.5, 1)
	lock.Position = UDim2.new(0.5, 0, 1, -2)
	lock.Size = UDim2.new(1, -8, 0, 12)
	fitText(lock, 11)
	lock.Visible = false

	return { button = button, star = star, lock = lock, order = order }
end

function BlockPickerView.build(gui: ScreenGui): View
	-- Шаг 1. Рамка каталога (в том же ScreenGui, что и нижняя панель — общий UIScale).
	local frame = UIFactory.panel("BlockPicker", UDim2.fromOffset(PICKER_SIZE.X, PICKER_SIZE.Y), gui)
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = BlockPickerView.HiddenPosition
	frame.Active = true -- клики по фону каталога не уходят в мир
	frame.Visible = false

	-- Шаг 2. Заголовок и крестик.
	local title = UIFactory.label("Title", "Каталог блоков", 22, frame)
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(0.5, 0, 0, 28)
	title.TextXAlignment = Enum.TextXAlignment.Left

	local factionLabel = UIFactory.label("FactionHint", "", 14, frame)
	factionLabel.Font = Theme.BodyFont
	factionLabel.TextColor3 = Theme.SubTextColor
	factionLabel.AnchorPoint = Vector2.new(1, 0)
	factionLabel.Position = UDim2.new(1, -52, 0, 12)
	factionLabel.Size = UDim2.new(0.45, 0, 0, 22)
	factionLabel.TextXAlignment = Enum.TextXAlignment.Right

	local closeButton = UIFactory.button("Close", "✕", Theme.SecondaryButtonColor, frame)
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -10, 0, 8)
	closeButton.Size = UDim2.fromOffset(32, 30)

	-- Шаг 3. Вкладки категорий.
	local tabsRow = Instance.new("Frame")
	tabsRow.Name = "Tabs"
	tabsRow.BackgroundTransparency = 1
	tabsRow.Position = UDim2.fromOffset(12, 44)
	tabsRow.Size = UDim2.new(1, -24, 0, TAB_HEIGHT)
	tabsRow.Parent = frame

	local tabsLayout = Instance.new("UIListLayout")
	tabsLayout.FillDirection = Enum.FillDirection.Horizontal
	tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabsLayout.Padding = UDim.new(0, TAB_GAP)
	tabsLayout.Parent = tabsRow

	-- Вкладки делят ширину окна поровну: новая категория не уезжает за край.
	local tabCount = #BlockCatalog.Categories
	local tabWidth = math.floor((PICKER_SIZE.X - 24 - TAB_GAP * (tabCount - 1)) / tabCount)
	local tabButtons: { [string]: TextButton } = {}
	for index, category in BlockCatalog.Categories do
		local tab = UIFactory.button(category.id .. "Tab", category.label, Theme.SecondaryButtonColor, tabsRow)
		tab.Size = UDim2.fromOffset(tabWidth, TAB_HEIGHT)
		tab.LayoutOrder = index
		tab.TextScaled = true
		local tabTextLimit = Instance.new("UITextSizeConstraint")
		tabTextLimit.MaxTextSize = 16
		tabTextLimit.Parent = tab
		tabButtons[category.id] = tab
	end

	-- Шаг 4. Прокручиваемая сетка плиток.
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Blocks"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.Position = UDim2.fromOffset(12, 44 + TAB_HEIGHT + 10)
	scroll.Size = UDim2.new(1, -24, 1, -(44 + TAB_HEIGHT + 10 + 12))
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = Theme.PanelStroke
	scroll.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingLeft = UDim.new(0, 4)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = scroll

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.fromOffset(TILE_SIZE.X, TILE_SIZE.Y)
	grid.CellPadding = UDim2.fromOffset(GAP, GAP)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = scroll

	-- Подстраховка к AutomaticCanvasSize: высота прокрутки всегда равна высоте сетки плиток,
	-- поэтому новые блоки не остаются за нижним краем списка.
	local function fitCanvas()
		scroll.CanvasSize = UDim2.fromOffset(0, grid.AbsoluteContentSize.Y + 8)
	end
	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitCanvas)
	fitCanvas()

	local tiles: { [string]: Tile } = {}
	for index, entry in BlockCatalog.List do
		tiles[entry.id] = buildTile(entry, index, scroll)
	end

	return {
		frame = frame,
		scroll = scroll,
		closeButton = closeButton,
		factionLabel = factionLabel,
		tabButtons = tabButtons,
		tiles = tiles,
	}
end

return BlockPickerView
]]></string>
</Properties>
</Item>

<Item class="ModuleScript" referent="RBXSTEP50003">
<Properties>
<string name="Name">BlockPickerController</string>
<string name="Source"><![CDATA[--!strict
-- BlockPickerController: логика каталога блоков.
--   * открыть / закрыть / переключить (кнопка «Блоки», клавиша B, крестик);
--   * вкладки категорий фильтруют плитки, «Все» показывает всё;
--   * «родные» блоки фракции помечены ★ и стоят первыми;
--   * в режиме «Вырезать» составные блоки подписаны «только стройка»
--     (резак режет только базовыми формами);
--   * клик по плитке отдаёт сигнал ShapePicked(shapeId) — что делать, решает BuildHudController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BlockCatalog = require(ReplicatedStorage.Shared.BlockCatalog)
local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local FactionConfig = require(ReplicatedStorage.Shared.FactionConfig)
local BlockPickerView = require(script.Parent.BlockPickerView)
local Theme = require(script.Parent.Theme)

export type Picker = {
	open: () -> (),
	close: () -> (),
	toggle: () -> (),
	isOpen: () -> boolean,
	setSelected: (shapeId: string?) -> (),
	setCarving: (carving: boolean) -> (),
	setFaction: (factionId: string?) -> (),
	ShapePicked: RBXScriptSignal, -- (shapeId: string)
}

local BlockPickerController = {}

local function setStroke(button: GuiObject, selected: boolean)
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if selected then Theme.SelectedStroke else Theme.PanelStroke
		stroke.Thickness = if selected then Theme.StrokeThickness + 2 else Theme.StrokeThickness
	end
end

-- Название фракции для подсказки в заголовке (если FactionConfig его знает).
local function factionTitle(factionId: string): string
	local config = FactionConfig :: any
	local byId = config.ById or config.Factions
	local faction = if type(byId) == "table" then byId[factionId] else nil
	if type(faction) == "table" then
		local name = faction.displayName or faction.name
		if type(name) == "string" then
			return name
		end
	end
	return factionId
end

function BlockPickerController.new(gui: ScreenGui): Picker
	local view = BlockPickerView.build(gui)
	local picked = Instance.new("BindableEvent")

	local opened = false
	local category = BlockCatalog.AllCategoryId
	local selectedId: string? = nil
	local carving = false
	local factionId: string? = nil

	local function refreshTabs()
		for id, tab in view.tabButtons do
			setStroke(tab, id == category)
		end
	end

	local function refreshTiles()
		for _, entry in BlockCatalog.List do
			local tile = view.tiles[entry.id]
			if tile then
				tile.button.Visible = category == BlockCatalog.AllCategoryId or entry.category == category
				local featured = BlockCatalog.isFeatured(entry, factionId)
				tile.star.Visible = featured
				-- Родные блоки фракции — в начале списка.
				tile.button.LayoutOrder = if featured then tile.order - 1000 else tile.order
				local shape = BuildConfig.Shapes[entry.id]
				tile.lock.Visible = carving and shape ~= nil and shape.prefab == true
				setStroke(tile.button, entry.id == selectedId)
			end
		end
	end

	local function open()
		if opened then
			return
		end
		opened = true
		view.frame.Position = BlockPickerView.HiddenPosition
		view.frame.Visible = true
		TweenService:Create(view.frame, Theme.TweenInfo, { Position = BlockPickerView.ShownPosition }):Play()
	end

	local function close()
		opened = false
		view.frame.Visible = false
	end

	local function toggle()
		if opened then
			close()
		else
			open()
		end
	end

	for id, tab in view.tabButtons do
		tab.Activated:Connect(function()
			category = id
			view.scroll.CanvasPosition = Vector2.zero
			refreshTabs()
			refreshTiles()
		end)
	end

	for id, tile in view.tiles do
		tile.button.Activated:Connect(function()
			picked:Fire(id)
		end)
	end

	view.closeButton.Activated:Connect(close)

	refreshTabs()
	refreshTiles()

	return {
		open = open,
		close = close,
		toggle = toggle,
		isOpen = function(): boolean
			return opened
		end,
		setSelected = function(shapeId: string?)
			selectedId = shapeId
			refreshTiles()
		end,
		setCarving = function(value: boolean)
			carving = value
			refreshTiles()
		end,
		setFaction = function(value: string?)
			factionId = value
			view.factionLabel.Text = if value then "★ — блоки фракции «" .. factionTitle(value) .. "»" else ""
			refreshTiles()
		end,
		ShapePicked = picked.Event,
	}
end

return BlockPickerController
]]></string>
</Properties>
</Item>

          <Item class="ModuleScript" referent="9">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--!strict
-- MenuController: логика меню. Переключает экраны и обрабатывает кнопки.
-- Состояния: "Title" -> "FactionSelect" -> закрыто (игрок в мире),
-- плюс "Settings" (открывается с титульного экрана).

local TweenService = game:GetService("TweenService")

local MenuView = require(script.Parent.MenuView)
local BuildCameraController = require(script.Parent.BuildCameraController)
local BuildHudController = require(script.Parent.BuildHudController)
local BuildController = require(script.Parent.BuildController)
local Teleporter = require(script.Parent.Teleporter)
local ScaleSettings = require(script.Parent.ScaleSettings)
local Theme = require(script.Parent.Theme)

type State = "Title" | "FactionSelect" | "Settings" | "Closed"

local MenuController = {}

function MenuController.start(playerGui: PlayerGui)
	local view = MenuView.build(playerGui)
	local buildHud = BuildHudController.start(playerGui) -- строительная панель (скрыта до выбора фракции)
	local busy = false -- защита от двойного клика во время телепорта

	-- Показывает только нужный экран.
	local function setState(state: State)
		view.titleScreen.Visible = state == "Title"
		view.factionScreen.Visible = state == "FactionSelect"
		view.settingsScreen.Visible = state == "Settings"
		view.gui.Enabled = state ~= "Closed"
	end

	-- Применяет размер интерфейса: плавно меняет UIScale и подсвечивает
	-- выбранную кнопку обводкой (фон кнопок занят hover-эффектом UIFactory).
	local function applyScale(optionId: string, instant: boolean?)
		for _, option in Theme.ScaleOptions do
			local button = view.scaleButtons[option.id]
			local stroke = button:FindFirstChildOfClass("UIStroke")
			local selected = option.id == optionId

			if stroke then
				stroke.Color = if selected then Theme.SelectedStroke else Theme.PanelStroke
				stroke.Thickness = if selected then Theme.StrokeThickness + 2 else Theme.StrokeThickness
			end

			if selected then
				ScaleSettings.set(option.scale, instant) -- общий масштаб для остальных экранов
				if instant then
					view.uiScale.Scale = option.scale
				else
					TweenService:Create(view.uiScale, Theme.TweenInfo, { Scale = option.scale }):Play()
				end
			end
		end
	end

	-- «Настройки» и «Закрыть»: открыть окно и вернуться в главное меню.
	view.settingsButton.Activated:Connect(function()
		setState("Settings")
	end)
	view.closeSettingsButton.Activated:Connect(function()
		setState("Title")
	end)

	-- Кнопки размера интерфейса.
	for optionId, button in view.scaleButtons do
		button.Activated:Connect(function()
			applyScale(optionId)
		end)
	end

	-- «Играть»: переходим к выбору фракции.
	view.playButton.Activated:Connect(function()
		setState("FactionSelect")
	end)

	-- «Назад»: возвращаемся на титульный экран.
	view.backButton.Activated:Connect(function()
		setState("Title")
	end)

	-- Выбор фракции: закрываем меню, сервер строит участок и телепортирует персонажа,
	-- затем включается свободная строительная камера.
	for factionId, button in view.factionButtons do
		button.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			setState("Closed")

			if Teleporter.toFaction(factionId) then
				-- Участок готов: включаем строительную камеру, вместе с ней появляется панель.
				if BuildCameraController.enter() then
					buildHud.show()
					-- Строительный редактор: призрак, установка, резак и удаление блоков.
					local plot = BuildCameraController.getPlot()
					if plot then
						task.spawn(BuildController.start, plot, buildHud)
					end
				end
			else
				setState("FactionSelect") -- не получилось: вернуть меню
			end
			busy = false
		end)
	end

	applyScale(Theme.DefaultScaleId, true)
	setState("Title")
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="10">
            <Properties>
              <string name="Name">MenuView</string>
              <string name="Source"><![CDATA[--!strict
-- MenuView: строит иерархию интерфейса (ScreenGui -> Frames -> Buttons).
-- Только разметка, без логики: обработчики навешивает MenuController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FactionConfig = require(ReplicatedStorage.Shared.FactionConfig)
local Theme = require(script.Parent.Theme)
local UIFactory = require(script.Parent.UIFactory)

export type View = {
	gui: ScreenGui,
	uiScale: UIScale, -- масштаб всего меню
	titleScreen: Frame, -- экран с кнопкой «Играть»
	factionScreen: Frame, -- экран выбора фракции
	settingsScreen: Frame, -- окно настроек
	playButton: TextButton,
	settingsButton: TextButton,
	backButton: TextButton,
	closeSettingsButton: TextButton,
	factionButtons: { [string]: TextButton }, -- id фракции -> кнопка
	scaleButtons: { [string]: TextButton }, -- id варианта размера -> кнопка
}

local MenuView = {}

function MenuView.build(playerGui: PlayerGui): View
	-- Шаг 1. Корневой ScreenGui. ResetOnSpawn = false, чтобы меню
	-- не пересоздавалось при респавне персонажа.
	local gui = Instance.new("ScreenGui")
	gui.Name = "MainMenu"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true -- закрывает и верхнюю панель Roblox
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10

	-- UIScale на ScreenGui масштабирует все вложенные элементы разом.
	local uiScale = Instance.new("UIScale")
	uiScale.Parent = gui

	-- Шаг 2. Титульный экран: название игры, кнопки «Играть» и «Настройки».
	local titleScreen = UIFactory.screen("TitleScreen", gui)
	local titlePanel = UIFactory.panel("Panel", UDim2.fromOffset(460, 370), titleScreen)
	UIFactory.verticalList(titlePanel, 20)

	local title = UIFactory.label("Title", "Древний Мир", 48, titlePanel)
	title.LayoutOrder = 1

	local subtitle = UIFactory.label("Subtitle", "Рим • Греция • Египет", 22, titlePanel)
	subtitle.Font = Theme.BodyFont
	subtitle.TextColor3 = Theme.SubTextColor
	subtitle.LayoutOrder = 2

	local playButton = UIFactory.button("PlayButton", "Играть", Theme.PrimaryButtonColor, titlePanel)
	playButton.Size = UDim2.new(0.7, 0, 0, 60)
	playButton.LayoutOrder = 3

	local settingsButton = UIFactory.button("SettingsButton", "Настройки", Theme.SecondaryButtonColor, titlePanel)
	settingsButton.Size = UDim2.new(0.7, 0, 0, 48)
	settingsButton.TextSize = 24
	settingsButton.LayoutOrder = 4

	-- Шаг 3. Экран выбора фракции: по кнопке на каждую фракцию из конфига.
	local factionScreen = UIFactory.screen("FactionScreen", gui)
	local factionPanel = UIFactory.panel("Panel", UDim2.fromOffset(520, 480), factionScreen)
	UIFactory.verticalList(factionPanel, 16)

	local factionTitle = UIFactory.label("Title", "Выберите цивилизацию", 36, factionPanel)
	factionTitle.LayoutOrder = 0

	local factionButtons: { [string]: TextButton } = {}
	for index, faction in FactionConfig.List do
		local button = UIFactory.button(
			faction.id .. "Button",
			"",
			faction.buttonColor,
			factionPanel,
			faction.accentColor
		)
		button.Size = UDim2.new(1, 0, 0, 80)
		button.LayoutOrder = index

		-- Внутри кнопки: название и описание фракции.
		local name = UIFactory.label("FactionName", faction.displayName, 30, button)
		name.Position = UDim2.fromOffset(0, 8)

		local description = UIFactory.label("Description", faction.description, 18, button)
		description.Font = Theme.BodyFont
		description.TextColor3 = Theme.SubTextColor
		description.Position = UDim2.fromOffset(0, 44)

		factionButtons[faction.id] = button
	end

	local backButton = UIFactory.button("BackButton", "Назад", Theme.SecondaryButtonColor, factionPanel)
	backButton.Size = UDim2.new(0.5, 0, 0, 44)
	backButton.TextSize = 22
	backButton.LayoutOrder = #FactionConfig.List + 1

	-- Шаг 4. Окно настроек: выбор размера интерфейса и кнопка «Закрыть».
	local settingsScreen = UIFactory.screen("SettingsScreen", gui)
	local settingsPanel = UIFactory.panel("Panel", UDim2.fromOffset(480, 300), settingsScreen)
	UIFactory.verticalList(settingsPanel, 16)

	local settingsTitle = UIFactory.label("Title", "Настройки", 36, settingsPanel)
	settingsTitle.LayoutOrder = 1

	local scaleLabel = UIFactory.label("ScaleLabel", "Размер интерфейса", 22, settingsPanel)
	scaleLabel.Font = Theme.BodyFont
	scaleLabel.TextColor3 = Theme.SubTextColor
	scaleLabel.LayoutOrder = 2

	-- Ряд кнопок-переключателей, по одной на каждый вариант из Theme.ScaleOptions.
	local scaleRow = Instance.new("Frame")
	scaleRow.Name = "ScaleRow"
	scaleRow.BackgroundTransparency = 1
	scaleRow.Size = UDim2.new(1, 0, 0, 48)
	scaleRow.LayoutOrder = 3
	scaleRow.Parent = settingsPanel

	local rowLayout = Instance.new("UIListLayout")
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rowLayout.Padding = UDim.new(0, 10)
	rowLayout.Parent = scaleRow

	local scaleButtons: { [string]: TextButton } = {}
	local optionCount = #Theme.ScaleOptions
	for index, option in Theme.ScaleOptions do
		local button = UIFactory.button(option.id .. "ScaleButton", option.label, Theme.SecondaryButtonColor, scaleRow)
		-- Делим ширину ряда поровну с учётом отступов между кнопками.
		button.Size = UDim2.new(1 / optionCount, -10 * (optionCount - 1) / optionCount, 1, 0)
		button.TextSize = 20
		button.LayoutOrder = index
		scaleButtons[option.id] = button
	end

	local closeSettingsButton = UIFactory.button("CloseButton", "Закрыть", Theme.PrimaryButtonColor, settingsPanel)
	closeSettingsButton.Size = UDim2.new(0.5, 0, 0, 44)
	closeSettingsButton.TextSize = 22
	closeSettingsButton.LayoutOrder = 4

	-- Шаг 5. Добавляем GUI в PlayerGui последним, когда иерархия уже собрана.
	gui.Parent = playerGui

	return {
		gui = gui,
		uiScale = uiScale,
		titleScreen = titleScreen,
		factionScreen = factionScreen,
		settingsScreen = settingsScreen,
		playButton = playButton,
		settingsButton = settingsButton,
		backButton = backButton,
		closeSettingsButton = closeSettingsButton,
		factionButtons = factionButtons,
		scaleButtons = scaleButtons,
	}
end

return MenuView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="11">
            <Properties>
              <string name="Name">Teleporter</string>
              <string name="Source"><![CDATA[--!strict
-- Teleporter: отправляет выбор фракции на сервер.
-- Сам телепорт и создание участка теперь делает сервер (PlotService):
-- он строит личный Plot 200x200 и ставит персонажа в его центр.
-- Клиент только ждёт ответа: true = готово, false = ошибка (меню вернётся назад).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FactionConfig = require(ReplicatedStorage.Shared.FactionConfig)
local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

local REMOTE_TIMEOUT = 10 -- сколько секунд ждать RemoteFunction от сервера

local Teleporter = {}

function Teleporter.toFaction(factionId: string): boolean
	if not FactionConfig.ById[factionId] then
		warn(`[Teleporter] Неизвестная фракция: {factionId}`)
		return false
	end

	local remote = ReplicatedStorage.Shared:WaitForChild(PlotConfig.RemoteName, REMOTE_TIMEOUT)
	if not remote or not remote:IsA("RemoteFunction") then
		warn("[Teleporter] Сервер не ответил: RemoteFunction не найдена")
		return false
	end

	-- InvokeServer ждёт, пока сервер построит участок и телепортирует персонажа.
	local ok, result = pcall(function()
		return remote:InvokeServer(factionId)
	end)
	if not ok then
		warn(`[Teleporter] Ошибка вызова сервера: {result}`)
		return false
	end
	return result == true
end

return Teleporter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">BuildCameraController</string>
              <string name="Source"><![CDATA[--!strict
-- BuildCameraController: свободная строительная камера (Free Build Camera).
-- Включается после того, как сервер построил участок игрока (см. MenuController).
--
-- Управление:
--   WASD            движение вперёд/назад/влево/вправо (по горизонтали, по взгляду)
--   E / Пробел      вверх,  Q / LeftShift: вниз,  LeftCtrl: ускорение
--   ПКМ (зажать)    поворот камеры мышью
--   Колесо мыши     приближение / отдаление (вдоль направления взгляда)
--
-- Плавность: клиент хранит «целевое» положение камеры (его двигает ввод) и каждый
-- кадр в RenderStep догоняет его критически демпфированной пружиной (smoothDamp):
-- старт и остановка без рывков, а при резком вводе камера не дёргается.
-- Границы: камера не уходит дальше BoundsMargin за края плиты, не опускается ниже
-- поверхности плиты и не поднимается выше PlotConfig.BuildHeight.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)

-- Все настройки камеры в одном месте.
local CONFIG = {
	MoveSpeed = 70, -- studs/сек
	BoostMultiplier = 2.5, -- множитель скорости при зажатом LeftCtrl
	ZoomStep = 18, -- studs за один «щелчок» колеса
	MouseSensitivity = 0.0045, -- радиан на пиксель

	MinPitch = math.rad(-85), -- нельзя смотреть строго вниз/вверх (нет переворота)
	MaxPitch = math.rad(70),

	BoundsMargin = 30, -- насколько можно вылететь за край плиты
	MinHeight = 4, -- минимальная высота над поверхностью плиты
	MaxHeight = PlotConfig.BuildHeight, -- максимальная высота над поверхностью плиты

	StartOutset = 25, -- стартовая точка: на столько студов за краем плиты
	StartHeightRatio = 0.7, -- стартовая высота как доля размера плиты (200 -> 140)

	IntroSmoothTime = 0.9, -- «длинная» плавность при перелёте на стартовую позицию
	MoveSmoothTime = 0.14, -- обычная плавность движения
	RotateSmoothTime = 0.07, -- обычная плавность поворота
	IntroDuration = 2.5, -- за сколько секунд плавность меняется с длинной на обычную

	PlotWaitTimeout = 5, -- сколько секунд ждать появления участка на клиенте
}

local KEYS = {
	Forward = { Enum.KeyCode.W },
	Back = { Enum.KeyCode.S },
	Left = { Enum.KeyCode.A },
	Right = { Enum.KeyCode.D },
	Up = { Enum.KeyCode.E, Enum.KeyCode.Space },
	Down = { Enum.KeyCode.Q, Enum.KeyCode.LeftShift },
	Boost = { Enum.KeyCode.LeftControl },
}

local BIND_NAME = "BuildCameraController"

type Session = {
	plot: Part,
	camera: Camera,
	minBounds: Vector3,
	maxBounds: Vector3,
	-- Текущее (отображаемое) состояние камеры и скорости пружин.
	pos: Vector3,
	posVelocity: Vector3,
	yaw: number,
	yawVelocity: number,
	pitch: number,
	pitchVelocity: number,
	-- Цель, к которой камера плавно стремится.
	targetPos: Vector3,
	targetYaw: number,
	targetPitch: number,
	elapsed: number,
	rotating: boolean,
	connections: { RBXScriptConnection },
}

local BuildCameraController = {}

local session: Session? = nil

-- ===== Математика =====

-- Критически демпфированная пружина (как SmoothDamp в Unity): без перелёта и рывков.
local function smoothDamp(current: number, target: number, velocity: number, smoothTime: number, dt: number): (number, number)
	local omega = 2 / math.max(smoothTime, 0.0001)
	local x = omega * dt
	local decay = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	return target + (change + temp) * decay, (velocity - omega * temp) * decay
end

local function smoothDampVector(
	current: Vector3,
	target: Vector3,
	velocity: Vector3,
	smoothTime: number,
	dt: number
): (Vector3, Vector3)
	local omega = 2 / math.max(smoothTime, 0.0001)
	local x = omega * dt
	local decay = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	return target + (change + temp) * decay, (velocity - omega * temp) * decay
end

-- Приводит угол к диапазону [-pi, pi], чтобы камера поворачивалась кратчайшим путём.
local function wrapAngle(angle: number): number
	return (angle + math.pi) % (2 * math.pi) - math.pi
end

local function clampToBounds(s: Session, position: Vector3): Vector3
	return Vector3.new(
		math.clamp(position.X, s.minBounds.X, s.maxBounds.X),
		math.clamp(position.Y, s.minBounds.Y, s.maxBounds.Y),
		math.clamp(position.Z, s.minBounds.Z, s.maxBounds.Z)
	)
end

-- ===== Ввод =====

local function isAnyDown(keys: { Enum.KeyCode }): boolean
	for _, key in keys do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

local function axis(positive: { Enum.KeyCode }, negative: { Enum.KeyCode }): number
	return (if isAnyDown(positive) then 1 else 0) - (if isAnyDown(negative) then 1 else 0)
end

local function setRotating(s: Session, rotating: boolean)
	s.rotating = rotating
	-- Пока зажата ПКМ, курсор «прибит» к месту, а мы читаем только смещение мыши.
	UserInputService.MouseBehavior = if rotating then Enum.MouseBehavior.LockCurrentPosition else Enum.MouseBehavior.Default
end

-- Отключает/включает стандартное управление персонажем (иначе он бегает по WASD).
local function setCharacterControls(enabled: boolean)
	local ok, err = pcall(function()
		local playerScripts = Players.LocalPlayer:WaitForChild("PlayerScripts")
		local playerModule = require(playerScripts:WaitForChild("PlayerModule")) :: any
		local controls = playerModule:GetControls()
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end)
	if not ok then
		warn(`[BuildCameraController] Не удалось переключить управление персонажем: {err}`)
	end
end

-- ===== Покадровое обновление =====

local function step(dt: number)
	local s = session
	if not s then
		return
	end
	dt = math.min(dt, 0.1) -- защита от больших скачков при лагах

	s.elapsed += dt

	-- Шаг 1. Ввод двигает ЦЕЛЬ (если игрок не печатает в чат).
	if UserInputService:GetFocusedTextBox() == nil then
		local forward = axis(KEYS.Forward, KEYS.Back)
		local strafe = axis(KEYS.Right, KEYS.Left)
		local vertical = axis(KEYS.Up, KEYS.Down)

		-- Горизонтальные оси берём по yaw, вертикаль: мировая «вверх».
		local flat = CFrame.fromOrientation(0, s.targetYaw, 0)
		local direction = flat.LookVector * forward + flat.RightVector * strafe + Vector3.yAxis * vertical

		if direction.Magnitude > 0 then
			local speed = CONFIG.MoveSpeed * (if isAnyDown(KEYS.Boost) then CONFIG.BoostMultiplier else 1)
			s.targetPos = clampToBounds(s, s.targetPos + direction.Unit * speed * dt)
		end
	end

	-- Шаг 2. Плавность: сначала длинная (перелёт на старт), потом обычная.
	local introProgress = math.clamp(s.elapsed / CONFIG.IntroDuration, 0, 1)
	local moveTime = CONFIG.IntroSmoothTime + (CONFIG.MoveSmoothTime - CONFIG.IntroSmoothTime) * introProgress
	local rotateTime = CONFIG.IntroSmoothTime + (CONFIG.RotateSmoothTime - CONFIG.IntroSmoothTime) * introProgress

	s.pos, s.posVelocity = smoothDampVector(s.pos, s.targetPos, s.posVelocity, moveTime, dt)
	s.yaw, s.yawVelocity = smoothDamp(s.yaw, s.targetYaw, s.yawVelocity, rotateTime, dt)
	s.pitch, s.pitchVelocity = smoothDamp(s.pitch, s.targetPitch, s.pitchVelocity, rotateTime, dt)

	-- Шаг 3. Применяем к камере (позиция дополнительно зажата границами).
	s.pos = clampToBounds(s, s.pos)
	s.camera.CFrame = CFrame.new(s.pos) * CFrame.fromOrientation(s.pitch, s.yaw, 0)
end

-- ===== Публичный API =====

-- Выключает камеру и возвращает обычное управление.
function BuildCameraController.stop()
	local s = session
	if not s then
		return
	end
	session = nil -- сначала обнуляем, чтобы step() больше ничего не делал

	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in s.connections do
		connection:Disconnect()
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	s.camera.CameraType = Enum.CameraType.Custom
	setCharacterControls(true)
end

function BuildCameraController.isActive(): boolean
	return session ~= nil
end

-- Включает камеру для данного участка.
function BuildCameraController.start(plot: Part)
	BuildCameraController.stop()

	local camera = workspace.CurrentCamera
	if not camera then
		warn("[BuildCameraController] Нет CurrentCamera")
		return
	end

	-- Шаг 1. Границы: края плиты ± BoundsMargin, высота от плиты до MaxHeight.
	local half = plot.Size / 2
	local center = plot.Position
	local surfaceY = center.Y + half.Y
	local minBounds = Vector3.new(
		center.X - half.X - CONFIG.BoundsMargin,
		surfaceY + CONFIG.MinHeight,
		center.Z - half.Z - CONFIG.BoundsMargin
	)
	local maxBounds = Vector3.new(
		center.X + half.X + CONFIG.BoundsMargin,
		surfaceY + CONFIG.MaxHeight,
		center.Z + half.Z + CONFIG.BoundsMargin
	)

	-- Шаг 2. Стартовая точка: над южным краем плиты, взгляд на центр. Так видна вся плита.
	local startHeight = math.min(plot.Size.X * CONFIG.StartHeightRatio, CONFIG.MaxHeight)
	local startPos = Vector3.new(center.X, surfaceY + startHeight, center.Z + half.Z + CONFIG.StartOutset)
	local lookTarget = Vector3.new(center.X, surfaceY, center.Z)
	local startPitch, startYaw = CFrame.lookAt(startPos, lookTarget):ToOrientation()

	-- Шаг 3. Текущее состояние берём у обычной камеры, чтобы перелёт начался без скачка.
	local currentPitch, currentYaw = camera.CFrame:ToOrientation()
	local currentPos = camera.CFrame.Position

	local s: Session = {
		plot = plot,
		camera = camera,
		minBounds = minBounds,
		maxBounds = maxBounds,
		pos = currentPos,
		posVelocity = Vector3.zero,
		yaw = currentYaw,
		yawVelocity = 0,
		pitch = currentPitch,
		pitchVelocity = 0,
		targetPos = startPos,
		targetYaw = currentYaw + wrapAngle(startYaw - currentYaw), -- кратчайший поворот
		targetPitch = startPitch,
		elapsed = 0,
		rotating = false,
		connections = {},
	}
	session = s

	-- Шаг 4. Ввод мышью: ПКМ крутит камеру, колесо двигает вдоль взгляда.
	table.insert(
		s.connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if not processed and input.UserInputType == Enum.UserInputType.MouseButton2 then
				setRotating(s, true)
			end
		end)
	)
	table.insert(
		s.connections,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseButton2 then
				setRotating(s, false)
			end
		end)
	)
	table.insert(
		s.connections,
		UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
			if input.UserInputType == Enum.UserInputType.MouseMovement and s.rotating then
				s.targetYaw -= input.Delta.X * CONFIG.MouseSensitivity
				s.targetPitch =
					math.clamp(s.targetPitch - input.Delta.Y * CONFIG.MouseSensitivity, CONFIG.MinPitch, CONFIG.MaxPitch)
			elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
				local look = CFrame.fromOrientation(s.targetPitch, s.targetYaw, 0).LookVector
				s.targetPos = clampToBounds(s, s.targetPos + look * input.Position.Z * CONFIG.ZoomStep)
			end
		end)
	)
	-- Окно потеряло фокус при зажатой ПКМ: отпускание не придёт, сбрасываем сами.
	table.insert(
		s.connections,
		UserInputService.WindowFocusReleased:Connect(function()
			setRotating(s, false)
		end)
	)
	-- Участок удалён (например, игрок выходит): камеру выключаем.
	table.insert(s.connections, plot.Destroying:Connect(BuildCameraController.stop))

	-- Шаг 5. Берём камеру на себя, отключаем бег персонажа и запускаем покадровый цикл.
	camera.CameraType = Enum.CameraType.Scriptable
	setCharacterControls(false)
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, step)
end

-- Ищет участок локального игрока среди Workspace.Plots по атрибуту владельца.
local function findOwnPlot(): Part?
	local folder = workspace:WaitForChild(PlotConfig.FolderName, CONFIG.PlotWaitTimeout)
	if not folder then
		return nil
	end

	local userId = Players.LocalPlayer.UserId
	local deadline = os.clock() + CONFIG.PlotWaitTimeout
	repeat
		for _, child in folder:GetChildren() do
			if child:IsA("Part") and child:GetAttribute(PlotConfig.Attributes.OwnerUserId) == userId then
				return child
			end
		end
		task.wait(0.1)
	until os.clock() >= deadline

	return nil
end

-- Вызывается после того, как сервер выдал участок: находит его и включает камеру.
function BuildCameraController.enter(): boolean
	local plot = findOwnPlot()
	if not plot then
		warn("[BuildCameraController] Участок игрока не найден, камера не включена")
		return false
	end

	BuildCameraController.start(plot)
	return true
end

-- Участок текущей сессии камеры (нужен BuildController).
function BuildCameraController.getPlot(): Part?
	local s = session
	return if s then s.plot else nil
end

return BuildCameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">ScaleSettings</string>
              <string name="Source"><![CDATA[--!strict
-- ScaleSettings: общий размер интерфейса (значение UIScale).
-- Главное меню записывает сюда выбранный в «Настройках» размер, а остальные
-- экраны (например, строительная панель) читают его и подписываются на изменения,
-- поэтому весь интерфейс масштабируется одинаково.

local Theme = require(script.Parent.Theme)

local ScaleSettings = {}

local changed = Instance.new("BindableEvent")
local current = 1

-- Стартовое значение: вариант по умолчанию из Theme.
for _, option in Theme.ScaleOptions do
	if option.id == Theme.DefaultScaleId then
		current = option.scale
	end
end

-- Сигнал: (scale: number, instant: boolean). instant = true: применить без анимации.
ScaleSettings.Changed = changed.Event

function ScaleSettings.get(): number
	return current
end

function ScaleSettings.set(scale: number, instant: boolean?)
	current = scale
	changed:Fire(scale, instant == true)
end

return ScaleSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="28">
            <Properties>
              <string name="Name">BuildHudView</string>
              <string name="Source"><![CDATA[--!strict
-- BuildHudView: строит иерархию нижней строительной панели (ScreenGui -> Panel -> Slots).
-- Только разметка, без логики: выбор слотов обрабатывает BuildHudController.
-- Слева — кнопка каталога «Блоки» (открывает BlockPicker), справа — инструменты.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildSlots = require(ReplicatedStorage.Shared.BuildSlots)
local Theme = require(script.Parent.Theme)
local UIFactory = require(script.Parent.UIFactory)

export type View = {
	gui: ScreenGui,
	uiScale: UIScale, -- масштаб всей панели (синхронизируется с настройками меню)
	panel: Frame,
	slotButtons: { [string]: TextButton }, -- id слота -> кнопка
	selectionBars: { [string]: Frame }, -- id слота -> полоска «выбрано» внизу кнопки
	descriptionLabels: { [string]: TextLabel }, -- id слота -> подпись (у «Блоков» — текущая форма)
}

local SLOT_SIZE = Vector2.new(112, 84)
local TOOL_SLOT_WIDTH = 210
local PANEL_PADDING = 12
local BOTTOM_MARGIN = 16

local BuildHudView = {}

-- Положения панели для анимации появления: у нижнего края и за экраном.
BuildHudView.PanelShownPosition = UDim2.new(0.5, 0, 1, -BOTTOM_MARGIN)
BuildHudView.PanelHiddenPosition = UDim2.new(0.5, 0, 1, 220)

-- Ограничивает максимальный размер текста при TextScaled (длинные названия сжимаются).
local function scaleToFit(label: TextLabel, maxTextSize: number)
	label.TextScaled = true
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label
end

function BuildHudView.build(playerGui: PlayerGui): View
	-- Шаг 1. Корневой ScreenGui. Скрыт до выбора фракции; DisplayOrder ниже меню (10).
	local gui = Instance.new("ScreenGui")
	gui.Name = "BuildHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	gui.Enabled = false

	local uiScale = Instance.new("UIScale")
	uiScale.Parent = gui

	-- Шаг 2. Панель внизу по центру: ширина подстраивается под количество слотов.
	local panel = UIFactory.panel("Panel", UDim2.fromOffset(0, 0), gui)
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = BuildHudView.PanelHiddenPosition
	panel.AutomaticSize = Enum.AutomaticSize.XY
	panel.Active = true -- клики по фону панели не уходят в мир (не ставят блок)
	UIFactory.horizontalList(panel, PANEL_PADDING)

	-- Шаг 3. По кнопке на каждый слот из BuildSlots.
	local slotButtons: { [string]: TextButton } = {}
	local selectionBars: { [string]: Frame } = {}
	local descriptionLabels: { [string]: TextLabel } = {}

	local separatorAdded = false
	for index, slot in BuildSlots.List do
		local isTool = slot.kind == "Tool"

		-- Инструменты (резак, снос, покраска) отделяем от каталога одной тонкой вертикальной чертой.
		if isTool and not separatorAdded then
			separatorAdded = true
			local separator = Instance.new("Frame")
			separator.Name = "Separator"
			separator.Size = UDim2.fromOffset(2, SLOT_SIZE.Y - 24)
			separator.BackgroundColor3 = Theme.PanelStroke
			separator.BackgroundTransparency = 0.4
			separator.BorderSizePixel = 0
			separator.LayoutOrder = index * 2 - 1
			separator.Parent = panel
		end

		local button = UIFactory.button(
			slot.id .. "Slot",
			"",
			if isTool then Theme.PrimaryButtonColor else Theme.SecondaryButtonColor,
			panel
		)
		button.Size = UDim2.fromOffset(if slot.wide then TOOL_SLOT_WIDTH else SLOT_SIZE.X, SLOT_SIZE.Y)
		button.LayoutOrder = index * 2

		-- Внутри кнопки: название и подпись.
		local name = UIFactory.label("SlotName", slot.displayName, 24, button)
		name.Position = UDim2.fromOffset(6, 10)
		name.Size = UDim2.new(1, -12, 0, 30)
		scaleToFit(name, 26)

		local description = UIFactory.label("SlotDescription", slot.description, 16, button)
		description.Font = Theme.BodyFont
		description.TextColor3 = Theme.SubTextColor
		description.Position = UDim2.fromOffset(6, 46)
		description.Size = UDim2.new(1, -12, 0, 24)
		scaleToFit(description, 18)

		-- Полоска «выбрано» внизу кнопки (видна только у выбранного слота).
		local bar = Instance.new("Frame")
		bar.Name = "SelectionBar"
		bar.AnchorPoint = Vector2.new(0.5, 1)
		bar.Position = UDim2.new(0.5, 0, 1, -6)
		bar.Size = UDim2.new(0.6, 0, 0, 4)
		bar.BackgroundColor3 = Theme.SelectedStroke
		bar.BorderSizePixel = 0
		bar.Visible = false
		bar.Parent = button

		local barCorner = Instance.new("UICorner")
		barCorner.CornerRadius = UDim.new(1, 0)
		barCorner.Parent = bar

		slotButtons[slot.id] = button
		selectionBars[slot.id] = bar
		descriptionLabels[slot.id] = description
	end

	-- Шаг 4. Добавляем GUI в PlayerGui последним, когда иерархия уже собрана.
	gui.Parent = playerGui

	return {
		gui = gui,
		uiScale = uiScale,
		panel = panel,
		slotButtons = slotButtons,
		selectionBars = selectionBars,
		descriptionLabels = descriptionLabels,
	}
end

return BuildHudView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="29">
            <Properties>
              <string name="Name">BuildHudController</string>
              <string name="Source"><![CDATA[--!strict
-- BuildHudController: логика строительной панели.
-- Показывает/прячет панель, подсвечивает выбор и держит масштаб
-- в синхроне с настройками меню (ScaleSettings).
--
-- Выбор состоит из двух частей:
--   * форма — что ставим или чем режем. Выбирается в каталоге «Блоки»
--     (кнопка на панели или клавиша B): базовые формы и составные античные блоки;
--   * инструмент (Вырезать / Снос / Покраска) — необязательный; без него идёт
--     обычная установка выбранной формы.
-- «Вырезать» режет формой выбранной фигуры, поэтому при нём форма остаётся
-- выбранной и её можно менять (дверь — «Стена», окно — «Блок» и т.д.).
-- Резак работает только базовыми формами: выбор составного блока при резаке
-- выключает резак и переходит к установке этого блока.
-- Механики строительства здесь нет: выбор отдаётся сигналом SelectionChanged,
-- на него подписан BuildController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local BuildSlots = require(ReplicatedStorage.Shared.BuildSlots)
local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BlockCatalog = require(ReplicatedStorage.Shared.BlockCatalog)
local BuildHudView = require(script.Parent.BuildHudView)
local BlockPickerController = require(script.Parent.BlockPickerController)
local PaintMenuController = require(script.Parent.PaintMenuController)
local ScaleSettings = require(script.Parent.ScaleSettings)
local Theme = require(script.Parent.Theme)

export type BuildHud = {
	show: () -> (), -- плавно выдвинуть панель
	hide: () -> (), -- плавно убрать панель (и закрыть каталог)
	getSelection: () -> (string?, string?), -- (id формы, id инструмента)
	SelectionChanged: RBXScriptSignal, -- (shapeId: string?, toolId: string?)
	setFaction: (factionId: string?) -> (), -- отметить ★ «родные» блоки фракции
}

-- Инструменты, которым нужна форма (резак режет формой выбранной фигуры).
local SHAPE_TOOLS: { [string]: boolean } = {
	Carve = true,
}

local DEFAULT_CARVE_SHAPE = "Block"

local BuildHudController = {}

local function isPrefab(shapeId: string?): boolean
	local shape = if shapeId then BuildConfig.Shapes[shapeId] else nil
	return shape ~= nil and shape.prefab == true
end

function BuildHudController.start(playerGui: PlayerGui): BuildHud
	local view = BuildHudView.build(playerGui)
	local picker = BlockPickerController.new(view.gui)
	PaintMenuController.attach(view.gui)

	local shapeId: string? = nil
	local toolId: string? = nil
	local visible = false
	local selectionChanged = Instance.new("BindableEvent")
	local catalogSlot = BuildSlots.ById[BuildConfig.CatalogSlotId]

	-- Шаг 1. Масштаб: берём текущий и следим за изменениями из настроек меню.
	view.uiScale.Scale = ScaleSettings.get()
	ScaleSettings.Changed:Connect(function(scale: number, instant: boolean)
		if instant then
			view.uiScale.Scale = scale
		else
			TweenService:Create(view.uiScale, Theme.TweenInfo, { Scale = scale }):Play()
		end
	end)

	-- Шаг 2. Подсветка: золотистая обводка + полоска внизу кнопки
	-- (фон кнопок занят hover-эффектом UIFactory, поэтому выделяем обводкой).
	local function setHighlighted(id: string, selected: boolean)
		local button = view.slotButtons[id]
		local stroke = if button then button:FindFirstChildOfClass("UIStroke") else nil
		if stroke then
			stroke.Color = if selected then Theme.SelectedStroke else Theme.PanelStroke
			stroke.Thickness = if selected then Theme.StrokeThickness + 2 else Theme.StrokeThickness
		end
		local bar = view.selectionBars[id]
		if bar then
			bar.Visible = selected
		end
	end

	local function refresh()
		-- Форма подсвечена, когда она реально используется: в установке или как форма резака.
		local shapeInUse = shapeId ~= nil and (toolId == nil or SHAPE_TOOLS[toolId :: string] == true)
		for _, slot in BuildSlots.List do
			local selected = if slot.kind == "Catalog" then shapeInUse or picker.isOpen() else slot.id == toolId
			setHighlighted(slot.id, selected)
		end

		-- Подпись кнопки «Блоки» — текущая форма.
		local description = view.descriptionLabels[BuildConfig.CatalogSlotId]
		if description and catalogSlot then
			description.Text = if shapeInUse and shapeId
				then BlockCatalog.displayName(shapeId) .. " · B"
				else catalogSlot.description
		end

		picker.setSelected(if shapeInUse then shapeId else nil)
		picker.setCarving(toolId == BuildConfig.CarveSlotId)
	end

	local function fire()
		refresh()
		selectionChanged:Fire(shapeId, toolId)
	end

	local function toggleCatalog()
		PaintMenuController.close() -- каталог и меню покраски занимают одно место
		picker.toggle()
		refresh()
	end

	-- Клик по плитке каталога.
	picker.ShapePicked:Connect(function(pickedId: string)
		local currentTool = toolId
		if currentTool ~= nil and SHAPE_TOOLS[currentTool] then
			if isPrefab(pickedId) then
				toolId = nil -- составной блок резаком не берётся: переходим к установке
			end
			shapeId = pickedId -- иначе меняем форму резака, режим остаётся
		elseif currentTool ~= nil then
			toolId = nil -- из «Сноса»/«Покраски» сразу в установку этой формы
			shapeId = pickedId
		elseif shapeId == pickedId then
			shapeId = nil -- повторный выбор снимает форму (призрак прячется)
		else
			shapeId = pickedId
		end
		picker.close()
		PaintMenuController.close()
		fire()
	end)

	local function onSlotClicked(slot: BuildSlots.Slot)
		if slot.kind == "Catalog" then
			toggleCatalog()
			return
		end
		local isPaint = slot.id == BuildConfig.PaintSlotId
		if isPaint and toolId == slot.id and not PaintMenuController.isOpen() then
			-- Инструмент уже включён, меню закрыто после выбора кисти: открываем его снова.
			picker.close()
			PaintMenuController.open()
			refresh()
			return
		end
		if toolId == slot.id then
			toolId = nil -- повторный клик выключает инструмент
		else
			toolId = slot.id
			if SHAPE_TOOLS[slot.id] and (shapeId == nil or isPrefab(shapeId)) then
				shapeId = DEFAULT_CARVE_SHAPE -- резаку нужна базовая форма: по умолчанию «Блок»
			end
		end
		if isPaint and toolId == slot.id then
			picker.close()
			PaintMenuController.open()
		else
			PaintMenuController.close()
		end
		fire()
	end

	for _, slot in BuildSlots.List do
		local button = view.slotButtons[slot.id]
		if button then
			button.Activated:Connect(function()
				onSlotClicked(slot)
			end)
		end
	end

	-- Клавиша B: открыть/закрыть каталог (только пока панель на экране).
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if processed or not visible or UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == BuildConfig.Keys.OpenCatalog then
			toggleCatalog()
		end
	end)

	-- Шаг 3. Появление и скрытие панели.
	local function show()
		visible = true
		view.panel.Position = BuildHudView.PanelHiddenPosition
		view.gui.Enabled = true
		TweenService:Create(view.panel, Theme.TweenInfo, { Position = BuildHudView.PanelShownPosition }):Play()
		refresh()
	end

	local function hide()
		visible = false
		picker.close()
		PaintMenuController.close()
		local tween = TweenService:Create(view.panel, Theme.TweenInfo, { Position = BuildHudView.PanelHiddenPosition })
		tween.Completed:Once(function()
			if not visible then
				view.gui.Enabled = false
			end
		end)
		tween:Play()
	end

	refresh()

	return {
		show = show,
		hide = hide,
		getSelection = function(): (string?, string?)
			return shapeId, toolId
		end,
		SelectionChanged = selectionChanged.Event,
		setFaction = function(factionId: string?)
			picker.setFaction(factionId)
			PaintMenuController.setFaction(factionId)
		end,
	}
end

return BuildHudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="12">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--!strict
-- Theme: цвета, шрифты и размеры меню. Меняйте стиль здесь, не трогая логику.

local Theme = {
	Font = Enum.Font.Fantasy,
	BodyFont = Enum.Font.Garamond,

	BackgroundColor = Color3.fromRGB(20, 16, 12),
	BackgroundTransparency = 0.15,

	PanelColor = Color3.fromRGB(45, 36, 26),
	PanelStroke = Color3.fromRGB(200, 165, 90), -- «золото»

	TextColor = Color3.fromRGB(245, 230, 200),
	SubTextColor = Color3.fromRGB(200, 185, 155),

	PrimaryButtonColor = Color3.fromRGB(170, 130, 60),
	SecondaryButtonColor = Color3.fromRGB(70, 58, 44),

	CornerRadius = UDim.new(0, 10),
	StrokeThickness = 2,

	TweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),

	-- Варианты размера интерфейса (значение UIScale.Scale) для окна настроек.
	ScaleOptions = {
		{ id = "Small", label = "Маленький", scale = 0.8 },
		{ id = "Standard", label = "Стандартный", scale = 1 },
		{ id = "Large", label = "Большой", scale = 1.2 },
	},
	DefaultScaleId = "Standard",
	SelectedStroke = Color3.fromRGB(255, 245, 215), -- обводка выбранного варианта
}

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="13">
            <Properties>
              <string name="Name">UIFactory</string>
              <string name="Source"><![CDATA[--!strict
-- UIFactory: маленькие функции-конструкторы для типовых элементов интерфейса.
-- Все элементы создаются кодом, поэтому интерфейс целиком хранится в git.

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local UIFactory = {}

-- Добавляет скруглённые углы и обводку в одном стиле.
local function decorate(instance: GuiObject, strokeColor: Color3?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius
	corner.Parent = instance

	local stroke = Instance.new("UIStroke")
	stroke.Color = strokeColor or Theme.PanelStroke
	stroke.Thickness = Theme.StrokeThickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = instance
end

-- Полноэкранный Frame («экран» меню). По умолчанию скрыт.
function UIFactory.screen(name: string, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Theme.BackgroundColor
	frame.BackgroundTransparency = Theme.BackgroundTransparency
	frame.BorderSizePixel = 0
	frame.Visible = false
	frame.Parent = parent
	return frame
end

-- Центральная панель с обводкой.
function UIFactory.panel(name: string, size: UDim2, parent: Instance): Frame
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	frame.Size = size
	frame.BackgroundColor3 = Theme.PanelColor
	frame.BorderSizePixel = 0
	frame.Parent = parent
	decorate(frame)
	return frame
end

-- Текстовая надпись (заголовок или подпись).
function UIFactory.label(name: string, text: string, textSize: number, parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Text = text
	label.Font = Theme.Font
	label.TextSize = textSize
	label.TextColor3 = Theme.TextColor
	label.TextWrapped = true
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, textSize + 12)
	label.Parent = parent
	return label
end

-- Кнопка с эффектом наведения (плавное осветление).
function UIFactory.button(name: string, text: string, color: Color3, parent: Instance, strokeColor: Color3?): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.Text = text
	button.Font = Theme.Font
	button.TextSize = 28
	button.TextColor3 = Theme.TextColor
	button.BackgroundColor3 = color
	button.AutoButtonColor = false -- свой hover-эффект ниже
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, 56)
	button.Parent = parent
	decorate(button, strokeColor)

	local hoverColor = color:Lerp(Color3.new(1, 1, 1), 0.15)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, Theme.TweenInfo, { BackgroundColor3 = hoverColor }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, Theme.TweenInfo, { BackgroundColor3 = color }):Play()
	end)

	return button
end

-- Вертикальная раскладка детей с отступами.
function UIFactory.verticalList(parent: Instance, padding: number)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.Parent = parent

	local inner = Instance.new("UIPadding")
	inner.PaddingTop = UDim.new(0, padding)
	inner.PaddingBottom = UDim.new(0, padding)
	inner.PaddingLeft = UDim.new(0, padding)
	inner.PaddingRight = UDim.new(0, padding)
	inner.Parent = parent
end

-- Горизонтальная раскладка детей с отступами (для нижней строительной панели).
function UIFactory.horizontalList(parent: Instance, padding: number)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.Parent = parent

	local inner = Instance.new("UIPadding")
	inner.PaddingTop = UDim.new(0, padding)
	inner.PaddingBottom = UDim.new(0, padding)
	inner.PaddingLeft = UDim.new(0, padding)
	inner.PaddingRight = UDim.new(0, padding)
	inner.Parent = parent
end

return UIFactory
]]></string>
            </Properties>
          </Item>
        <Item class="ModuleScript" referent="37"><Properties><string name="Name">BuildController</string><string name="Source"><![CDATA[--!strict
-- BuildController: клиентский контроллер строительного редактора (Placement System).
--   * нижняя панель: каталог «Блоки» (базовые и составные формы) + инструменты «Вырезать» и «Снос»;
--   * составные блоки (Model) ведут себя как одиночные: призрак из тех же деталей,
--     сетка и поворот по габариту, «Снос» по любой детали удаляет всю модель;
--   * панель «Точность» справа: шаг сетки 4 / 1 / 0.25 / 0 (свободно), шаг поворота
--     90° / 45° / 15° / 5°, «Магнит к центру», сброс поворота (BuildSettingsController);
--   * призрак плавно следует за курсором по плите и блокам:
--       установка — зелёный (можно) / красный (нельзя),
--       резак — фиолетовый (задевает ваш блок, ЛКМ вырежет) / оранжевый (ничего не задевает);
--   * «Двигать»: ЛКМ по своему блоку показывает 3D-стрелки X / Y / Z (MoveGizmo), перенос идёт по шагу сетки;
--   * размер базовых блоков и резака (X, Y, Z) задаётся на панели «Точность»; резак бывает «кубом»
--     или тонкой «полосой» (BuildConfig.BladeThickness);
--   * «Покраска / Скрижали»: ЛКМ красит деталь выбранным материалом, вешает скрижаль на грань
--     или очищает грань — смотря какая кисть выбрана в меню (PaintMenuController);
--   * R — вращение вокруг вертикальной оси Y, T — наклон вперёд/назад (X), Y — наклон вбок (Z);
--   * ЛКМ — поставить / вырезать / снести (в режиме «Снос»);
--   * X — быстро удалить свой блок под курсором в любом режиме;
--   * ПКМ строительство НЕ использует: она только вращает камеру (BuildCameraController).
-- Сервер всё перепроверяет сам (BuildService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)
local PlotConfig = require(ReplicatedStorage.Shared.PlotConfig)
local BlockCatalog = require(ReplicatedStorage.Shared.BlockCatalog)
local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)
local BuildSettingsController = require(script.Parent.BuildSettingsController)
local GhostPreview = require(script.Parent.GhostPreview)
local MoveGizmo = require(script.Parent.MoveGizmo)
local PaintMenuController = require(script.Parent.PaintMenuController)

type BuildHud = {
	getSelection: () -> (string?, string?),
	SelectionChanged: RBXScriptSignal,
	setFaction: ((factionId: string?) -> ())?,
}

type Mode = "None" | "Place" | "Carve" | "Delete" | "Move" | "Paint"

type Remotes = {
	place: RemoteEvent,
	remove: RemoteEvent,
	carve: RemoteEvent,
	move: RemoteEvent,
	paint: RemoteEvent,
	tablet: RemoteEvent,
	erase: RemoteEvent,
	notice: RemoteEvent,
}

type Session = {
	plot: Part,
	blocks: Instance,
	remotes: Remotes,
	previewFolder: Folder,
	ghost: GhostPreview.Ghost,
	gizmo: MoveGizmo.Gizmo, -- 3D-стрелки режима «Двигать»
	highlight: Highlight,
	rayParams: RaycastParams,
	mode: Mode,
	shapeId: string?,
	placement: BuildGrid.Placement?,
	canAct: boolean, -- можно ли сделать ЛКМ в текущей точке (поставить / вырезать)
	hovered: Instance?, -- корень блока под курсором (Part или Model)
	factionId: string?, -- фракция участка: палитра и стиль колонн в призраке
	lastActionTime: number,
	connections: { RBXScriptConnection },
}

local BIND_NAME = "BuildController"
local RAY_LENGTH = 2000
local CLIENT_PLACE_COOLDOWN = 0.1

local localPlayer = Players.LocalPlayer

local BuildController = {}

local session: Session? = nil
-- Поворот призрака в градусах; запоминается между сессиями строительства.
local angles: BuildGrid.Angles = { yaw = 0, pitch = 0, roll = 0 }

-- ===== Луч из курсора =====

-- Куда смотрит курсор: только своя плита или блоки на ней (декор и призрак исключены).
local function raycastMouse(s: Session): RaycastResult?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end

	local exclude: { Instance } = { s.previewFolder }
	local decor = s.plot:FindFirstChild(BuildConfig.DecorFolderName)
	if decor then
		table.insert(exclude, decor)
	end
	if localPlayer.Character then
		table.insert(exclude, localPlayer.Character)
	end
	s.rayParams.FilterDescendantsInstances = exclude

	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, s.rayParams)
	if not result then
		return nil
	end
	if result.Instance == s.plot or result.Instance:IsDescendantOf(s.blocks) then
		return result
	end
	return nil
end

-- Свой поставленный (в том числе уже вырезанный) блок под курсором или nil.
-- Для составного блока луч попадает в одну деталь — возвращаем всю модель
-- (прямого ребёнка папки Blocks), чтобы подсветка и «Снос» работали с блоком целиком.
local function ownBlockFrom(s: Session, result: RaycastResult?): Instance?
	if not result then
		return nil
	end
	local node: Instance? = result.Instance
	while node and node.Parent ~= s.blocks do
		node = node.Parent
	end
	if node and node:GetAttribute(BuildConfig.Attributes.OwnerUserId) == localPlayer.UserId then
		return node
	end
	return nil
end

local function setHovered(s: Session, part: Instance?)
	if part ~= s.hovered then
		s.hovered = part
		s.highlight.Adornee = part
		s.highlight.Enabled = part ~= nil
	end
end

-- ===== Режимы =====

local function shapeName(shapeId: string): string
	return BlockCatalog.displayName(shapeId)
end

-- Свой размер из панели «Точность» — только для базовых форм и резака (nil = размер формы).
local function activeSize(s: Session): Vector3?
	local shapeId = s.shapeId
	local shape = if shapeId then BuildConfig.Shapes[shapeId] else nil
	if not shape or shape.prefab or (s.mode ~= "Place" and s.mode ~= "Carve") then
		return nil
	end
	return BuildSettingsController.get().size or shape.size
end

local function isBlade(s: Session): boolean
	return s.mode == "Carve" and BuildSettingsController.get().cutterShape == BuildConfig.CutterBladeId
end

-- Сообщает панели, чей размер редактируется, и перестраивает призрак под этот размер.
local function syncSize(s: Session)
	local shapeId = s.shapeId
	local shape = if shapeId then BuildConfig.Shapes[shapeId] else nil
	BuildSettingsController.setCarveMode(s.mode == "Carve")
	if isBlade(s) then
		BuildSettingsController.setSizeTarget(BuildConfig.CutterBladeId, BuildConfig.BladeDefaultSize, true)
	elseif shapeId and shape and not shape.prefab and (s.mode == "Place" or s.mode == "Carve") then
		BuildSettingsController.setSizeTarget(shapeId, shape.size, false)
	else
		BuildSettingsController.setSizeTarget(nil)
	end
	if shapeId then
		s.ghost.setShape(shapeId, s.factionId, activeSize(s))
	end
end

local describeBrush: () -> string

local function describeMode(s: Session): string
	local shapeId = s.shapeId
	if isBlade(s) then
		return "Резак-полоса: ЛКМ — разрезать, R — повернуть лезвие"
	elseif s.mode == "Move" then
		return "Перенос: ЛКМ по своему блоку, затем тяните стрелки"
	elseif s.mode == "Paint" then
		return describeBrush()
	end
	if s.mode == "Place" and shapeId then
		return "Установка: " .. shapeName(shapeId) .. ". ЛКМ — поставить"
	elseif s.mode == "Carve" and shapeId then
		return "Резак, форма: " .. shapeName(shapeId) .. ". ЛКМ — вырезать"
	elseif s.mode == "Delete" then
		return "Снос: ЛКМ по своему блоку"
	end
	return "Откройте «Блоки» (B) и выберите форму"
end

-- Переключение режима по выбору на нижней панели (форма + инструмент).
local function applySelection(s: Session, shapeId: string?, toolId: string?)
	s.placement = nil
	s.canAct = false
	setHovered(s, nil)

	local shape = if shapeId then BuildConfig.Shapes[shapeId] else nil
	local hasShape = shape ~= nil
	if toolId == BuildConfig.CarveSlotId and shape and shape.prefab then
		-- Резак работает только базовыми формами (CSG по одному Part).
		shapeId = "Block"
	end
	if toolId == BuildConfig.CarveSlotId and hasShape then
		s.mode = "Carve"
	elseif toolId == BuildConfig.DeleteSlotId then
		s.mode = "Delete"
	elseif toolId == BuildConfig.MoveSlotId then
		s.mode = "Move"
	elseif toolId == BuildConfig.PaintSlotId then
		s.mode = "Paint"
	elseif toolId == nil and hasShape then
		s.mode = "Place"
	else
		-- Ничего не выбрано или инструмент без призрака («Покраска»).
		s.mode = "None"
	end

	if (s.mode == "Place" or s.mode == "Carve") and shapeId then
		s.shapeId = shapeId
	else
		s.shapeId = nil
	end
	if s.mode ~= "Move" then
		s.gizmo.select(nil)
	end
	local highlightColor = if s.mode == "Move"
		then BuildConfig.MoveHighlightColor
		elseif s.mode == "Paint" then BuildConfig.PaintHighlightColor
		else BuildConfig.DeleteHighlightColor
	s.highlight.FillColor = highlightColor
	s.highlight.OutlineColor = highlightColor
	syncSize(s)
	s.ghost.hide()
	BuildSettingsController.setMode(describeMode(s))
end

-- ===== Действия =====

local function cooldownPassed(s: Session, cooldown: number): boolean
	local now = os.clock()
	if now - s.lastActionTime < cooldown then
		return false
	end
	s.lastActionTime = now
	return true
end

-- ЛКМ в режиме установки: отправляем «намерение» — форму, центр (в координатах
-- участка) и три угла. Сервер сам проверит границы и пересечения.
local function tryPlace(s: Session)
	local shapeId = s.shapeId
	local placement = s.placement
	if not shapeId or not placement then
		return
	end
	if not s.canAct then
		BuildSettingsController.notify("Здесь строить нельзя: фигура выходит за плиту или задевает блок")
		return
	end
	if not cooldownPassed(s, CLIENT_PLACE_COOLDOWN) then
		return
	end
	s.remotes.place:FireServer(shapeId, placement.localCenter, angles.yaw, angles.pitch, angles.roll, activeSize(s))
end

-- ЛКМ в режиме резака: сервер вычтет форму призрака из задетых блоков (SubtractAsync).
local function tryCarve(s: Session)
	local shapeId = s.shapeId
	local placement = s.placement
	if not shapeId or not placement then
		return
	end
	if not s.canAct then
		BuildSettingsController.notify("Резак ничего не задевает: наведите его на свой блок")
		return
	end
	if not cooldownPassed(s, BuildConfig.CarveCooldown) then
		return
	end
	s.remotes.carve:FireServer(shapeId, placement.localCenter, angles.yaw, angles.pitch, angles.roll, activeSize(s))
end

local function tryRemove(s: Session, part: Instance?)
	if part then
		s.remotes.remove:FireServer(part)
	end
end

-- Деталь своего блока под курсором: цель покраски и скрижалей (у модели — отдельная часть).
local function paintTarget(s: Session, result: RaycastResult?): BasePart?
	if result and ownBlockFrom(s, result) then
		return result.Instance
	end
	return nil
end

function describeBrush(): string
	local brush = PaintMenuController.getBrush()
	local id = if brush then brush.id else nil
	if brush and brush.kind == "Erase" then
		return "Очистить грань: ЛКМ по грани со скрижалью"
	elseif brush and brush.kind == "Material" and id then
		local material = PaintCatalog.MaterialById[id]
		return "Покраска: " .. (if material then material.displayName else id) .. ". ЛКМ по блоку или детали"
	elseif brush and brush.kind == "Tablet" and id then
		local tablet = PaintCatalog.TabletById[id]
		return "Скрижаль «" .. (if tablet then tablet.title else id) .. "». ЛКМ по грани блока"
	end
	return "Покраска / Скрижали: выберите материал или скрижаль в меню"
end

-- ЛКМ в режиме «Покраска / Скрижали»: действие зависит от выбранной в меню кисти.
local function tryPaint(s: Session)
	local brush = PaintMenuController.getBrush()
	if not brush then
		BuildSettingsController.notify("Сначала выберите материал или скрижаль в меню")
		return
	end
	local result = raycastMouse(s)
	local part = paintTarget(s, result)
	if not result or not part then
		BuildSettingsController.notify("Наведите курсор на свой блок")
		return
	end
	if brush.kind == "Material" then
		s.remotes.paint:FireServer(part, brush.id)
	elseif brush.kind == "Tablet" then
		s.remotes.tablet:FireServer(part, result.Position, result.Normal, brush.id)
	else
		s.remotes.erase:FireServer(part, result.Normal)
	end
end

-- R / T / Y: поворот на текущий шаг панели «Точность» (призрак довернётся плавно).
local function rotate(axis: "yaw" | "pitch" | "roll")
	local stepDegrees = BuildSettingsController.get().rotationStep
	if axis == "yaw" then
		angles.yaw = BuildGrid.addAngle(angles.yaw, stepDegrees)
	elseif axis == "pitch" then
		angles.pitch = BuildGrid.addAngle(angles.pitch, stepDegrees)
	else
		angles.roll = BuildGrid.addAngle(angles.roll, stepDegrees)
	end
	BuildSettingsController.setAngles(angles)
end

-- ===== Кадр =====

local function step(dt: number)
	local s = session
	if not s then
		return
	end

	local result = raycastMouse(s)
	local shapeId = s.shapeId
	local shape: BuildConfig.Shape? = nil
	if shapeId then
		shape = BuildConfig.Shapes[shapeId]
	end

	if (s.mode == "Place" or s.mode == "Carve") and shapeId and shape then
		local size = activeSize(s)
		local placement: BuildGrid.Placement? = nil
		if result then
			local hit = result.Instance
			if hit:IsA("BasePart") then
				local settings = BuildSettingsController.get()
				placement = BuildGrid.computePlacement({
					plot = s.plot,
					shapeId = shapeId,
					size = size,
					angles = angles,
					gridStep = settings.gridStep,
					snapToCenter = settings.snapToCenter,
					inward = s.mode == "Carve",
					hitPart = hit,
					hitPos = result.Position,
					hitNormal = result.Normal,
				})
			end
		end
		s.placement = placement

		if placement then
			local color: Color3
			if s.mode == "Place" then
				-- Установка: целиком на плите 200x200 и ни с чем не пересекается.
				s.canAct = BuildGrid.isInsideArea(s.plot, placement.localCenter, placement.extents)
					and not (
						if size
							then BuildGrid.isBlocked(s.plot, placement.cframe, size)
							else BuildGrid.isShapeBlocked(s.plot, placement.cframe, shapeId)
					)
				color = if s.canAct then BuildConfig.GhostValidColor else BuildConfig.GhostInvalidColor
			else
				-- Резак: фиолетовый, если задевает хотя бы один свой блок, иначе оранжевый.
				local targets = BuildGrid.findCarveTargets(s.plot, placement.cframe, size or shape.size, localPlayer.UserId)
				s.canAct = #targets > 0
				color = if s.canAct then BuildConfig.CarveActiveColor else BuildConfig.CarveIdleColor
			end
			s.ghost.update(placement.cframe, color, dt)
		else
			s.canAct = false
			s.ghost.hide()
		end
	elseif s.mode == "Delete" then
		setHovered(s, ownBlockFrom(s, result))
	elseif s.mode == "Paint" then
		setHovered(s, paintTarget(s, result))
	elseif s.mode == "Move" then
		-- Подсвечиваем блок, который выберет клик (кроме уже выбранного и пока тянут стрелку).
		local target = if s.gizmo.isBusy() then nil else ownBlockFrom(s, result)
		setHovered(s, if target ~= s.gizmo.getSelected() then target else nil)
	end
	s.gizmo.update(dt)
end

-- ===== Публичный API =====

function BuildController.isActive(): boolean
	return session ~= nil
end

function BuildController.stop()
	local s = session
	if not s then
		return
	end
	session = nil
	RunService:UnbindFromRenderStep(BIND_NAME)
	for _, connection in s.connections do
		connection:Disconnect()
	end
	s.ghost.destroy()
	s.gizmo.destroy()
	s.previewFolder:Destroy()
	BuildSettingsController.hide()
end

local function waitRemote(name: string): RemoteEvent?
	local remote = ReplicatedStorage.Shared:WaitForChild(name, 10)
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

-- Включает строительный редактор на участке игрока. Вызывается из MenuController
-- после того, как включилась строительная камера и показалась нижняя панель.
function BuildController.start(plot: Part, buildHud: BuildHud): boolean
	BuildController.stop()

	-- Шаг 1. Ждём папку блоков и RemoteEvent'ы от сервера.
	local blocks = plot:WaitForChild(BuildConfig.BlocksFolderName, 10)
	local place = waitRemote(BuildConfig.PlaceRemoteName)
	local remove = waitRemote(BuildConfig.RemoveRemoteName)
	local carve = waitRemote(BuildConfig.CarveRemoteName)
	local move = waitRemote(BuildConfig.MoveRemoteName)
	local paint = waitRemote(BuildConfig.PaintRemoteName)
	local tablet = waitRemote(BuildConfig.TabletRemoteName)
	local erase = waitRemote(BuildConfig.EraseTabletRemoteName)
	local notice = waitRemote(BuildConfig.NoticeRemoteName)
	local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
	if not blocks or not place or not remove or not carve or not move then
		warn("[BuildController] Не найдены Blocks или RemoteEvent'ы, строительство не включено")
		return false
	end
	if not paint or not tablet or not erase or not notice or not playerGui then
		warn("[BuildController] Не найдены Blocks или RemoteEvent'ы, строительство не включено")
		return false
	end

	-- Шаг 2. Локальные объекты предпросмотра (созданы на клиенте — сервер их не видит).
	local previewFolder = Instance.new("Folder")
	previewFolder.Name = "BuildPreview"
	previewFolder.Parent = workspace

	local highlight = Instance.new("Highlight")
	highlight.Name = "DeleteHighlight"
	highlight.FillColor = BuildConfig.DeleteHighlightColor
	highlight.OutlineColor = BuildConfig.DeleteHighlightColor
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = previewFolder

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude

	local s: Session = {
		plot = plot,
		blocks = blocks,
		remotes = {
			place = place,
			remove = remove,
			carve = carve,
			move = move,
			paint = paint,
			tablet = tablet,
			erase = erase,
			notice = notice,
		},
		previewFolder = previewFolder,
		ghost = GhostPreview.new(previewFolder),
		gizmo = MoveGizmo.new(plot, previewFolder, playerGui, {
			getGridStep = function(): number
				return BuildSettingsController.get().gridStep
			end,
			commit = function(block: Instance, localOffset: Vector3)
				move:FireServer(block, localOffset)
			end,
			notify = BuildSettingsController.notify,
		}),
		highlight = highlight,
		rayParams = rayParams,
		mode = "None",
		shapeId = nil,
		placement = nil,
		canAct = false,
		hovered = nil,
		factionId = nil,
		lastActionTime = 0,
		connections = {},
	}
	session = s

	-- Фракция участка (ставит сервер): палитра призрака и «родные» блоки в каталоге.
	local faction = plot:GetAttribute(PlotConfig.Attributes.FactionId)
	s.factionId = if typeof(faction) == "string" then faction else nil
	local setFaction = buildHud.setFaction
	if setFaction then
		setFaction(s.factionId)
	end

	-- Шаг 3. Панель «Точность» справа (шаг сетки, шаг поворота, магнит).
	BuildSettingsController.show()
	BuildSettingsController.setAngles(angles)

	-- Шаг 4. Выбор на нижней панели (форма + инструмент).
	applySelection(s, buildHud.getSelection())
	table.insert(
		s.connections,
		buildHud.SelectionChanged:Connect(function(shapeId: string?, toolId: string?)
			applySelection(s, shapeId, toolId)
		end)
	)

	-- Кнопка «Сброс» на панели «Точность»: все углы в 0.
	-- Смена кисти в меню «Покраска / Скрижали»: обновляем подпись режима.
	table.insert(
		s.connections,
		PaintMenuController.Changed:Connect(function()
			BuildSettingsController.setMode(describeMode(s))
		end)
	)

	-- Смена формы резака или размера на панели: обновляем призрак и подпись режима.
	table.insert(
		s.connections,
		BuildSettingsController.Changed:Connect(function()
			syncSize(s)
			BuildSettingsController.setMode(describeMode(s))
		end)
	)

	table.insert(
		s.connections,
		BuildSettingsController.ResetRotationRequested:Connect(function()
			angles.yaw = 0
			angles.pitch = 0
			angles.roll = 0
			BuildSettingsController.setAngles(angles)
		end)
	)

	-- Сообщения сервера (лимит блоков, неудачный разрез и т.п.).
	table.insert(
		s.connections,
		notice.OnClientEvent:Connect(function(text: unknown)
			if typeof(text) == "string" then
				BuildSettingsController.notify(text)
			end
		end)
	)

	-- Шаг 5. Клавиатура и мышь. ПКМ здесь не обрабатывается — она целиком у камеры.
	table.insert(
		s.connections,
		UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
			if processed or UserInputService:GetFocusedTextBox() then
				return
			end

			local key = input.KeyCode
			local shaping = s.mode == "Place" or s.mode == "Carve"
			if key == BuildConfig.Keys.RotateY then
				if shaping then
					rotate("yaw")
				end
			elseif key == BuildConfig.Keys.TiltX then
				if shaping then
					rotate("pitch")
				end
			elseif key == BuildConfig.Keys.TiltZ then
				if shaping then
					rotate("roll")
				end
			elseif key == BuildConfig.Keys.QuickDelete then
				-- X: быстрое удаление своего блока под курсором в любом режиме.
				tryRemove(s, ownBlockFrom(s, raycastMouse(s)))
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				if s.mode == "Place" then
					tryPlace(s)
				elseif s.mode == "Carve" then
					tryCarve(s)
				elseif s.mode == "Delete" then
					tryRemove(s, ownBlockFrom(s, raycastMouse(s)))
				elseif s.mode == "Paint" then
					tryPaint(s)
				elseif s.mode == "Move" then
					-- Откладываем на такт: клик по стрелке — это перетаскивание, а не смена выбора.
					task.defer(function()
						if session == s and s.mode == "Move" and not s.gizmo.isBusy() then
							s.gizmo.select(ownBlockFrom(s, raycastMouse(s)))
						end
					end)
				end
			end
		end)
	)

	-- Шаг 6. Обновление призрака каждый кадр — после того, как сдвинулась камера.
	RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 2, step)

	-- Участок удалён (игрок вышел/перезашёл) — выключаемся.
	table.insert(s.connections, plot.Destroying:Connect(BuildController.stop))
	return true
end

return BuildController
]]></string></Properties></Item>
<Item class="ModuleScript" referent="38"><Properties><string name="Name">GhostPreview</string><string name="Source"><![CDATA[--!strict
-- GhostPreview: полупрозрачный «призрак» фигуры для предпросмотра.
-- Живёт только на клиенте (другие игроки его не видят), не участвует в физике
-- и не ловит лучи мыши (CanQuery = false). Плавно догоняет целевую позицию
-- и поворот. Цвет задаёт BuildController: зелёный/красный — установка,
-- фиолетовый/оранжевый — резак.
--
-- Призрак — Model из тех же деталей, что и настоящий блок (BlockLibrary), поэтому
-- составные формы (арки, колонны, пирамиды...) видны в предпросмотре целиком.
-- Невидимая деталь Bounds повторяет габаритную коробку формы: по ней рисуется контур.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BlockLibrary = require(ReplicatedStorage.Shared.BlockLibrary)

export type Ghost = {
	setShape: (shapeId: string, factionId: string?, size: Vector3?) -> (), -- size — свой размер базовой формы
	update: (target: CFrame, color: Color3, dt: number) -> (),
	hide: () -> (),
	destroy: () -> (),
}

local GhostPreview = {}

local function makeGhostPart(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon -- лёгкое свечение
	part.Transparency = 1 -- скрыт до первого update
end

function GhostPreview.new(parent: Instance): Ghost
	local model = Instance.new("Model")
	model.Name = "BuildGhost"
	model.Parent = parent

	-- Габаритная коробка формы (всегда прозрачная) — опора для контура и pivot.
	local bounds = Instance.new("Part")
	bounds.Name = "Bounds"
	makeGhostPart(bounds)
	bounds.Parent = model
	model.PrimaryPart = bounds

	-- Контур, чтобы границы призрака были чётко видны на фоне плиты и блоков.
	local outline = Instance.new("SelectionBox")
	outline.Name = "Outline"
	outline.Adornee = bounds
	outline.LineThickness = 0.06
	outline.SurfaceTransparency = 1
	outline.Visible = false
	outline.Parent = model

	local pieces: { BasePart } = {}
	local visible = false
	local current: CFrame? = nil
	local shownKey: string? = nil

	local function setShape(shapeId: string, factionId: string?, size: Vector3?)
		local key = shapeId .. "|" .. (factionId or "") .. "|" .. (if size then tostring(size) else "")
		if key == shownKey then
			return
		end
		shownKey = key

		for _, piece in pieces do
			piece:Destroy()
		end
		table.clear(pieces)

		local shape = BuildConfig.Shapes[shapeId]
		local specs = BlockLibrary.getPieces(shapeId, factionId)
		if shape and size and not shape.prefab then
			-- Базовая форма своего размера (в том числе тонкая полоса резака): один бокс.
			bounds.Size = size
			specs = { { kind = "Block", role = "Main", size = size, cframe = CFrame.identity } }
		elseif shape then
			bounds.Size = shape.size
		end
		local base = bounds.CFrame
		for _, spec in specs do
			local part = BlockLibrary.makePart(spec)
			makeGhostPart(part)
			part.CFrame = base * spec.cframe
			part.Parent = model
			table.insert(pieces, part)
		end
		current = nil -- новая форма: сразу встаём на место, без полёта
		visible = false
	end

	local function update(target: CFrame, color: Color3, dt: number)
		-- Плавность: экспоненциальное сглаживание позиции и поворота, не зависит от FPS.
		local previous = current
		if previous == nil or not visible then
			current = target
		else
			local alpha = 1 - math.exp(-BuildConfig.GhostFollowSpeed * dt)
			current = previous:Lerp(target, alpha)
		end
		model:PivotTo(current :: CFrame) -- двигает все детали разом

		for _, piece in pieces do
			piece.Color = color
			piece.Transparency = BuildConfig.GhostTransparency
		end
		outline.Color3 = color
		outline.Visible = true
		visible = true
	end

	local function hide()
		if not visible then
			return
		end
		for _, piece in pieces do
			piece.Transparency = 1
		end
		outline.Visible = false
		visible = false
	end

	local function destroy()
		model:Destroy()
	end

	return {
		setShape = setShape,
		update = update,
		hide = hide,
		destroy = destroy,
	}
end

return GhostPreview
]]></string></Properties></Item>
<Item class="ModuleScript" referent="39"><Properties><string name="Name">BuildSettingsController</string><string name="Source"><![CDATA[--!strict
-- BuildSettingsController: состояние и логика мини-панели «Точность».
--   * шаг сетки: 4 / 1 / 0.25 студа или 0 (свободное перемещение без сетки);
--   * шаг поворота: 90° / 45° / 15° / 5° (используют клавиши R, T, Y);
--   * «Магнит к центру» — призрак прилипает к центру грани блока под курсором;
--   * показ текущих углов, кнопка «Сброс» и короткие сообщения (notify).
-- Панель создаётся один раз; настройки сохраняются, пока игрок в игре.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildSize = require(ReplicatedStorage.Shared.BuildSize)
local BuildSettingsView = require(script.Parent.BuildSettingsView)
local ScaleSettings = require(script.Parent.ScaleSettings)
local Theme = require(script.Parent.Theme)

export type Settings = {
	gridStep: number, -- студы; 0 = без сетки
	rotationStep: number, -- градусы
	snapToCenter: boolean,
	cutterShape: string, -- id из BuildConfig.CutterShapes
	size: Vector3?, -- свой размер блока / резака; nil = размер недоступен (составной блок и т. п.)
}

export type Angles = {
	yaw: number,
	pitch: number,
	roll: number,
}

local BuildSettingsController = {}

local gridIndex = BuildConfig.DefaultGridIndex
local rotationIndex = BuildConfig.DefaultRotationIndex
local snapToCenter = false
local cutterShape = BuildConfig.CutterCubeId
local carveMode = false

-- Размеры запоминаются отдельно для каждой формы и для полосы резака.
local sizes: { [string]: Vector3 } = {}
local sizeKey: string? = nil
local sizeDefault: Vector3? = nil
local sizeLockZ = false

local AXIS_NAMES = { "Ширина X", "Высота Y", "Длина Z" }
local LOCKED_AXIS_NAME = "Толщина Z"

local function axisOf(size: Vector3, axis: number): number
	return if axis == 1 then size.X elseif axis == 2 then size.Y else size.Z
end

-- Текущие значения (одна таблица на всю игру: get() вызывается каждый кадр).
local current: Settings = {
	gridStep = 0,
	rotationStep = 0,
	snapToCenter = false,
	cutterShape = BuildConfig.CutterCubeId,
	size = nil,
}

local changed = Instance.new("BindableEvent")
local resetRequested = Instance.new("BindableEvent")

-- Сигналы: настройки изменились / нажата кнопка «Сброс» (обнулить поворот).
BuildSettingsController.Changed = changed.Event
BuildSettingsController.ResetRotationRequested = resetRequested.Event

local view: BuildSettingsView.View? = nil
local visible = false
local noticeToken = 0

-- Выбранный вариант выделяем обводкой (фон кнопок занят hover-эффектом UIFactory).
local function setSelected(button: TextButton, selected: boolean)
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if selected then Theme.SelectedStroke else Theme.PanelStroke
		stroke.Thickness = if selected then Theme.StrokeThickness + 2 else Theme.StrokeThickness
	end
end

local function refresh()
	local grid = BuildConfig.GridOptions[gridIndex]
	current.gridStep = grid.step
	current.rotationStep = BuildConfig.RotationSteps[rotationIndex]
	current.snapToCenter = snapToCenter
	current.cutterShape = cutterShape
	local stored = if sizeKey then sizes[sizeKey] or sizeDefault else nil
	current.size = if stored and sizeLockZ then BuildSize.blade(stored) else stored

	local v = view
	if not v then
		return
	end

	v.gridLabel.Text = string.format("Шаг сетки (студы): %s — %s", grid.label, grid.hint)
	for index, button in v.gridButtons do
		setSelected(button, index == gridIndex)
	end

	v.rotationLabel.Text = string.format("Шаг поворота: %d°", current.rotationStep)
	for index, button in v.rotationButtons do
		setSelected(button, index == rotationIndex)
	end

	v.snapButton.Text = if snapToCenter then "Магнит к центру: ВКЛ" else "Магнит к центру: выкл"
	setSelected(v.snapButton, snapToCenter)

	for index, button in v.cutterButtons do
		setSelected(button, BuildConfig.CutterShapes[index].id == cutterShape)
	end
	v.cutterRow.Visible = carveMode

	local size = current.size
	v.sizeLabel.Text = if size then "Размер (студы)" else "Размер: выберите базовую форму или резак"
	v.sizeResetButton.Visible = size ~= nil
	for axis, row in v.sizeRows do
		local locked = axis == 3 and sizeLockZ
		row.frame.Visible = size ~= nil
		row.label.Text = if locked then LOCKED_AXIS_NAME else AXIS_NAMES[axis]
		row.box.Text = if size then BuildSize.format(axisOf(size, axis)) else ""
		row.box.TextEditable = not locked
		row.minus.Visible = not locked
		row.plus.Visible = not locked
	end
end

-- Новое значение одной оси (1 = X, 2 = Y, 3 = Z) редактируемого размера.
local function setAxis(axis: number, value: number)
	local key, size = sizeKey, current.size
	if not key or not size or (axis == 3 and sizeLockZ) then
		refresh()
		return
	end
	local clamped = BuildSize.clamp(value, BuildConfig.MinBlockSize)
	sizes[key] = Vector3.new(
		if axis == 1 then clamped else size.X,
		if axis == 2 then clamped else size.Y,
		if axis == 3 then clamped else size.Z
	)
	refresh()
	changed:Fire()
end

-- Кнопки «−» / «+»: шаг равен текущему шагу сетки.
local function nudgeAxis(axis: number, direction: number)
	local size = current.size
	if size then
		setAxis(axis, BuildSize.nudge(axisOf(size, axis), current.gridStep, direction, BuildConfig.MinBlockSize))
	end
end

-- Создаёт панель при первом показе и подключает кнопки.
local function ensureView(): BuildSettingsView.View
	local existing = view
	if existing then
		return existing
	end

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
	local created = BuildSettingsView.build(playerGui)
	view = created

	-- Масштаб как у меню и нижней панели (ScaleSettings).
	created.uiScale.Scale = ScaleSettings.get()
	ScaleSettings.Changed:Connect(function(scale: number, instant: boolean)
		if instant then
			created.uiScale.Scale = scale
		else
			TweenService:Create(created.uiScale, Theme.TweenInfo, { Scale = scale }):Play()
		end
	end)

	for index, button in created.gridButtons do
		button.Activated:Connect(function()
			gridIndex = index
			refresh()
			changed:Fire()
		end)
	end

	for index, button in created.rotationButtons do
		button.Activated:Connect(function()
			rotationIndex = index
			refresh()
			changed:Fire()
		end)
	end

	created.snapButton.Activated:Connect(function()
		snapToCenter = not snapToCenter
		refresh()
		changed:Fire()
	end)

	for index, button in created.cutterButtons do
		button.Activated:Connect(function()
			cutterShape = BuildConfig.CutterShapes[index].id
			refresh()
			changed:Fire()
		end)
	end

	for axis, row in created.sizeRows do
		row.minus.Activated:Connect(function()
			nudgeAxis(axis, -1)
		end)
		row.plus.Activated:Connect(function()
			nudgeAxis(axis, 1)
		end)
		row.box.FocusLost:Connect(function()
			local value = BuildSize.parse(row.box.Text)
			if value then
				setAxis(axis, value)
			else
				refresh() -- не число: возвращаем прежнее значение
			end
		end)
	end

	created.sizeResetButton.Activated:Connect(function()
		if sizeKey then
			sizes[sizeKey] = nil
			refresh()
			changed:Fire()
		end
	end)

	created.resetButton.Activated:Connect(function()
		resetRequested:Fire()
	end)

	refresh()
	return created
end

-- Текущие настройки (только чтение).
function BuildSettingsController.get(): Settings
	return current
end

-- Показать текущие углы поворота призрака.
function BuildSettingsController.setAngles(angles: Angles)
	local v = view
	if v then
		v.anglesLabel.Text = string.format("Y %d°  ·  X %d°  ·  Z %d°", angles.yaw, angles.pitch, angles.roll)
	end
end

-- Подпись текущего режима (установка / резак / снос).
function BuildSettingsController.setMode(text: string)
	local v = view
	if v then
		v.modeLabel.Text = text
	end
end

-- Короткое сообщение внизу панели; само скрывается через NoticeDuration секунд.
function BuildSettingsController.notify(text: string)
	local v = view
	if not v then
		return
	end
	noticeToken += 1
	local token = noticeToken
	v.noticeLabel.Text = text
	v.noticeLabel.Visible = true
	task.delay(BuildConfig.NoticeDuration, function()
		if noticeToken == token then
			v.noticeLabel.Visible = false
		end
	end)
end

-- Плавно выдвинуть панель (создаёт её при первом вызове).
-- Чей размер сейчас редактируется: key — id формы или полосы резака (у каждой свой запомненный
-- размер), defaultSize — размер по умолчанию, lockZ — ось Z фиксирована (толщина полосы).
-- key = nil — размер недоступен (составной блок, снос, перенос).
function BuildSettingsController.setSizeTarget(key: string?, defaultSize: Vector3?, lockZ: boolean?)
	sizeKey = key
	sizeDefault = defaultSize
	sizeLockZ = lockZ == true
	refresh()
end

-- Режим «Вырезать»: показывает переключатель формы резака.
function BuildSettingsController.setCarveMode(active: boolean)
	carveMode = active
	refresh()
end

function BuildSettingsController.show()
	local v = ensureView()
	visible = true
	v.panel.Position = BuildSettingsView.PanelHiddenPosition
	v.gui.Enabled = true
	TweenService:Create(v.panel, Theme.TweenInfo, { Position = BuildSettingsView.PanelShownPosition }):Play()
end

-- Плавно убрать панель.
function BuildSettingsController.hide()
	local v = view
	if not v then
		return
	end
	visible = false
	local tween = TweenService:Create(v.panel, Theme.TweenInfo, { Position = BuildSettingsView.PanelHiddenPosition })
	tween.Completed:Once(function()
		if not visible then
			v.gui.Enabled = false
		end
	end)
	tween:Play()
end

refresh()

return BuildSettingsController
]]></string></Properties></Item>
<Item class="ModuleScript" referent="40"><Properties><string name="Name">BuildSettingsView</string><string name="Source"><![CDATA[--!strict
-- BuildSettingsView: разметка мини-панели «Точность» (справа сверху).
-- Только разметка, без логики: состояние и клики обрабатывает BuildSettingsController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local Theme = require(script.Parent.Theme)
local UIFactory = require(script.Parent.UIFactory)

export type SizeRow = {
	frame: Frame,
	label: TextLabel,
	minus: TextButton,
	box: TextBox,
	plus: TextButton,
}

export type View = {
	gui: ScreenGui,
	uiScale: UIScale, -- масштаб панели (синхронизируется с настройками меню)
	panel: Frame,
	modeLabel: TextLabel, -- текущий режим: установка / резак / снос
	gridLabel: TextLabel,
	gridButtons: { TextButton }, -- по индексам BuildConfig.GridOptions
	rotationLabel: TextLabel,
	rotationButtons: { TextButton }, -- по индексам BuildConfig.RotationSteps
	anglesLabel: TextLabel,
	resetButton: TextButton,
	snapButton: TextButton,
	cutterRow: Frame, -- переключатель формы резака (виден только в режиме «Вырезать»)
	cutterButtons: { TextButton }, -- по индексам BuildConfig.CutterShapes
	sizeLabel: TextLabel,
	sizeResetButton: TextButton,
	sizeRows: { SizeRow }, -- оси X, Y, Z
	noticeLabel: TextLabel,
}

local PANEL_WIDTH = 300
local PANEL_PADDING = 6
local RIGHT_MARGIN = 16
local TOP_OFFSET = 64 -- ниже верхней панели Roblox (ScreenGui с IgnoreGuiInset)
local ROW_HEIGHT = 34
local SIZE_ROW_HEIGHT = 28
local SIZE_BUTTON_WIDTH = 32

local HINTS = {
	"R — вращать (Y) · T / Y — наклон (X / Z)",
	"X — удалить блок под курсором",
	"ЛКМ — поставить / вырезать / выбрать",
	"«Двигать»: тяните стрелки у блока",
	"ПКМ — вращение камеры",
}

local BuildSettingsView = {}

-- Положения панели для анимации: у правого края и за экраном.
BuildSettingsView.PanelShownPosition = UDim2.new(1, -RIGHT_MARGIN, 0, TOP_OFFSET)
BuildSettingsView.PanelHiddenPosition = UDim2.new(1, PANEL_WIDTH + 60, 0, TOP_OFFSET)

-- Ограничивает максимальный размер текста при TextScaled.
local function scaleToFit(label: TextLabel, maxTextSize: number)
	label.TextScaled = true
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label
end

-- Подпись секции (мелкий шрифт, по левому краю).
local function sectionLabel(name: string, parent: Instance, layoutOrder: number): TextLabel
	local label = UIFactory.label(name, "", 18, parent)
	label.Font = Theme.BodyFont
	label.TextColor3 = Theme.SubTextColor
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.new(1, 0, 0, 20)
	label.LayoutOrder = layoutOrder
	return label
end

-- Ряд одинаковых кнопок-вариантов (переключатель).
local function optionRow(name: string, texts: { string }, parent: Instance, layoutOrder: number): { TextButton }
	local row = Instance.new("Frame")
	row.Name = name
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	row.LayoutOrder = layoutOrder
	row.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = row

	local buttons: { TextButton } = {}
	for index, text in texts do
		local button = UIFactory.button(name .. index, text, Theme.SecondaryButtonColor, row)
		button.TextSize = 20
		button.Size = UDim2.new(1 / #texts, -5, 1, 0)
		button.LayoutOrder = index
		table.insert(buttons, button)
	end
	return buttons
end

-- Строка одной оси размера: подпись, «−», поле ввода, «+».
local function sizeRow(axis: number, parent: Instance): SizeRow
	local frame = Instance.new("Frame")
	frame.Name = "SizeAxis" .. axis
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, SIZE_ROW_HEIGHT)
	frame.LayoutOrder = axis
	frame.Parent = parent

	local label = UIFactory.label("Axis", "", 17, frame)
	label.Font = Theme.BodyFont
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Size = UDim2.new(0, 94, 1, 0)
	scaleToFit(label, 17)

	local minus = UIFactory.button("Minus", "−", Theme.SecondaryButtonColor, frame)
	minus.TextSize = 22
	minus.Position = UDim2.fromOffset(98, 0)
	minus.Size = UDim2.new(0, SIZE_BUTTON_WIDTH, 1, 0)

	local box = Instance.new("TextBox")
	box.Name = "Value"
	box.Text = ""
	box.ClearTextOnFocus = false
	box.Font = Theme.BodyFont
	box.TextSize = 18
	box.TextColor3 = Theme.TextColor
	box.BackgroundColor3 = Theme.BackgroundColor
	box.BorderSizePixel = 0
	box.Position = UDim2.fromOffset(98 + SIZE_BUTTON_WIDTH + 4, 0)
	box.Size = UDim2.new(1, -(98 + SIZE_BUTTON_WIDTH * 2 + 8), 1, 0)
	box.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius
	corner.Parent = box

	local plus = UIFactory.button("Plus", "+", Theme.SecondaryButtonColor, frame)
	plus.TextSize = 22
	plus.AnchorPoint = Vector2.new(1, 0)
	plus.Position = UDim2.new(1, 0, 0, 0)
	plus.Size = UDim2.new(0, SIZE_BUTTON_WIDTH, 1, 0)

	return { frame = frame, label = label, minus = minus, box = box, plus = plus }
end

function BuildSettingsView.build(playerGui: PlayerGui): View
	-- Шаг 1. Корневой ScreenGui (как у нижней панели: DisplayOrder ниже меню).
	local gui = Instance.new("ScreenGui")
	gui.Name = "BuildSettings"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	gui.Enabled = false

	local uiScale = Instance.new("UIScale")
	uiScale.Parent = gui

	-- Шаг 2. Панель справа сверху; высота подстраивается под содержимое.
	local panel = UIFactory.panel("Panel", UDim2.fromOffset(PANEL_WIDTH, 0), gui)
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = BuildSettingsView.PanelHiddenPosition
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.Active = true -- клики по фону панели не уходят в мир (не ставят блок)
	UIFactory.verticalList(panel, PANEL_PADDING)

	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end

	-- Шаг 3. Заголовок и текущий режим.
	local title = UIFactory.label("Title", "Точность", 26, panel)
	title.Size = UDim2.new(1, 0, 0, 30)
	title.LayoutOrder = nextOrder()

	local modeLabel = UIFactory.label("Mode", "", 18, panel)
	modeLabel.Font = Theme.BodyFont
	modeLabel.Size = UDim2.new(1, 0, 0, 0)
	modeLabel.AutomaticSize = Enum.AutomaticSize.Y
	modeLabel.LayoutOrder = nextOrder()

	-- Шаг 4. Шаг сетки: 4 / 1 / 0.25 / 0.
	local gridLabel = sectionLabel("GridLabel", panel, nextOrder())
	local gridTexts: { string } = {}
	for _, option in BuildConfig.GridOptions do
		table.insert(gridTexts, option.label)
	end
	local gridButtons = optionRow("GridOption", gridTexts, panel, nextOrder())

	-- Шаг 5. Шаг поворота: 90° / 45° / 15° / 5°.
	local rotationLabel = sectionLabel("RotationLabel", panel, nextOrder())
	local rotationTexts: { string } = {}
	for _, stepDegrees in BuildConfig.RotationSteps do
		table.insert(rotationTexts, tostring(stepDegrees) .. "°")
	end
	local rotationButtons = optionRow("RotationOption", rotationTexts, panel, nextOrder())

	-- Шаг 6. Текущие углы + кнопка сброса поворота.
	local anglesRow = Instance.new("Frame")
	anglesRow.Name = "AnglesRow"
	anglesRow.BackgroundTransparency = 1
	anglesRow.Size = UDim2.new(1, 0, 0, 34)
	anglesRow.LayoutOrder = nextOrder()
	anglesRow.Parent = panel

	local anglesLabel = UIFactory.label("Angles", "", 18, anglesRow)
	anglesLabel.Font = Theme.BodyFont
	anglesLabel.TextXAlignment = Enum.TextXAlignment.Left
	anglesLabel.Size = UDim2.new(1, -104, 1, 0)
	scaleToFit(anglesLabel, 18)

	local resetButton = UIFactory.button("ResetRotation", "Сброс", Theme.SecondaryButtonColor, anglesRow)
	resetButton.TextSize = 18
	resetButton.AnchorPoint = Vector2.new(1, 0.5)
	resetButton.Position = UDim2.new(1, 0, 0.5, 0)
	resetButton.Size = UDim2.fromOffset(96, 32)

	-- Шаг 7. «Магнит к центру» (переключатель).
	local snapButton = UIFactory.button("SnapToCenter", "", Theme.SecondaryButtonColor, panel)
	snapButton.TextSize = 20
	snapButton.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)
	snapButton.LayoutOrder = nextOrder()

	-- Форма резака («Куб» / «Полоса»): строка видна только в режиме «Вырезать».
	local cutterTexts: { string } = {}
	for _, option in BuildConfig.CutterShapes do
		table.insert(cutterTexts, option.label)
	end
	local cutterButtons = optionRow("CutterShape", cutterTexts, panel, nextOrder())
	local cutterRow = cutterButtons[1].Parent :: Frame
	cutterRow.Visible = false
	for _, button in cutterButtons do
		button.TextSize = 17
	end

	-- Размер блока / резака: заголовок со сбросом и по строке «− [поле] +» на каждую ось.
	local sizeSection = Instance.new("Frame")
	sizeSection.Name = "SizeSection"
	sizeSection.BackgroundTransparency = 1
	sizeSection.Size = UDim2.new(1, 0, 0, 0)
	sizeSection.AutomaticSize = Enum.AutomaticSize.Y
	sizeSection.LayoutOrder = nextOrder()
	sizeSection.Parent = panel

	local sizeLayout = Instance.new("UIListLayout")
	sizeLayout.FillDirection = Enum.FillDirection.Vertical
	sizeLayout.SortOrder = Enum.SortOrder.LayoutOrder
	sizeLayout.Padding = UDim.new(0, 4)
	sizeLayout.Parent = sizeSection

	local sizeHeader = Instance.new("Frame")
	sizeHeader.Name = "Header"
	sizeHeader.BackgroundTransparency = 1
	sizeHeader.Size = UDim2.new(1, 0, 0, 24)
	sizeHeader.LayoutOrder = 0
	sizeHeader.Parent = sizeSection

	local sizeLabel = UIFactory.label("SizeLabel", "", 18, sizeHeader)
	sizeLabel.Font = Theme.BodyFont
	sizeLabel.TextColor3 = Theme.SubTextColor
	sizeLabel.TextXAlignment = Enum.TextXAlignment.Left
	sizeLabel.Size = UDim2.new(1, -84, 1, 0)
	scaleToFit(sizeLabel, 18)

	local sizeResetButton = UIFactory.button("ResetSize", "Сброс", Theme.SecondaryButtonColor, sizeHeader)
	sizeResetButton.TextSize = 16
	sizeResetButton.AnchorPoint = Vector2.new(1, 0.5)
	sizeResetButton.Position = UDim2.new(1, 0, 0.5, 0)
	sizeResetButton.Size = UDim2.fromOffset(78, 24)

	local sizeRows: { SizeRow } = {}
	for axis = 1, 3 do
		table.insert(sizeRows, sizeRow(axis, sizeSection))
	end

	-- Шаг 8. Подсказка по клавишам.
	local hints = UIFactory.label("Hints", table.concat(HINTS, "\n"), 16, panel)
	hints.Font = Theme.BodyFont
	hints.TextColor3 = Theme.SubTextColor
	hints.TextXAlignment = Enum.TextXAlignment.Left
	hints.TextYAlignment = Enum.TextYAlignment.Top
	hints.Size = UDim2.new(1, 0, 0, 0)
	hints.AutomaticSize = Enum.AutomaticSize.Y
	hints.LayoutOrder = nextOrder()

	-- Шаг 9. Короткие сообщения (скрыты, пока нечего сказать).
	local noticeLabel = UIFactory.label("Notice", "", 16, panel)
	noticeLabel.Font = Theme.BodyFont
	noticeLabel.TextColor3 = Color3.fromRGB(255, 205, 130)
	noticeLabel.TextXAlignment = Enum.TextXAlignment.Left
	noticeLabel.Size = UDim2.new(1, 0, 0, 0)
	noticeLabel.AutomaticSize = Enum.AutomaticSize.Y
	noticeLabel.Visible = false
	noticeLabel.LayoutOrder = nextOrder()

	-- Шаг 10. Добавляем GUI в PlayerGui последним, когда иерархия уже собрана.
	gui.Parent = playerGui

	return {
		gui = gui,
		uiScale = uiScale,
		panel = panel,
		modeLabel = modeLabel,
		gridLabel = gridLabel,
		gridButtons = gridButtons,
		rotationLabel = rotationLabel,
		rotationButtons = rotationButtons,
		anglesLabel = anglesLabel,
		resetButton = resetButton,
		snapButton = snapButton,
		cutterRow = cutterRow,
		cutterButtons = cutterButtons,
		sizeLabel = sizeLabel,
		sizeResetButton = sizeResetButton,
		sizeRows = sizeRows,
		noticeLabel = noticeLabel,
	}
end

return BuildSettingsView
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD47"><Properties><string name="Name">MoveGizmo</string><string name="Source"><![CDATA[--!strict
-- MoveGizmo (клиент): 3D-стрелки перемещения (стандартные Roblox Handles) вокруг выбранного блока.
--   * стрелки идут вдоль осей X / Y / Z участка: Handles привязаны к невидимому боксу-габариту,
--     повёрнутому как плита, поэтому направления не зависят от поворота самого блока;
--   * во время перетаскивания двигается полупрозрачная копия блока (зелёная — можно, красная — нельзя),
--     смещение привязывается к текущему шагу сетки панели «Точность»;
--   * когда мышь отпущена, смещение уходит на сервер (commit) — он перепроверяет и двигает блок.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local BuildConfig = require(ReplicatedStorage.Shared.BuildConfig)
local BuildGrid = require(ReplicatedStorage.Shared.BuildGrid)

export type Callbacks = {
	getGridStep: () -> number, -- текущий шаг сетки (0 = свободно)
	commit: (block: Instance, localOffset: Vector3) -> (), -- отправить перенос на сервер
	notify: (text: string) -> (),
}

export type Gizmo = {
	select: (block: Instance?) -> (), -- показать стрелки вокруг блока (nil — убрать)
	getSelected: () -> Instance?,
	isBusy: () -> boolean, -- курсор на стрелке или идёт перетаскивание: клик не должен менять выбор
	update: (dt: number) -> (),
	destroy: () -> (),
}

type Drag = {
	block: PVInstance,
	startPivot: CFrame,
	center: Vector3, -- центр габарита в координатах участка до переноса
	extents: Vector3,
	offset: Vector3, -- целевое смещение (уже привязано к сетке)
	shown: Vector3, -- смещение копии: плавно догоняет offset
	valid: boolean,
	ghost: PVInstance?,
}

local PROXY_MARGIN = 0.1 -- стрелки чуть отступают от граней блока
local DIMMED = 0.8 -- прозрачность исходного блока, пока двигается копия

local MoveGizmo = {}

local function makeGhost(block: PVInstance, parent: Instance): PVInstance?
	local ok, clone = pcall(function()
		return block:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	for _, part in BuildGrid.blockParts(clone) do
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Transparency = BuildConfig.GhostTransparency
		if part:IsA("PartOperation") then
			part.UsePartColor = true
		end
	end
	clone.Parent = parent
	return clone
end

local function tint(ghost: PVInstance?, color: Color3)
	if ghost then
		for _, part in BuildGrid.blockParts(ghost) do
			part.Color = color
		end
	end
end

local function setDimmed(block: Instance, dimmed: boolean)
	for _, part in BuildGrid.blockParts(block) do
		part.LocalTransparencyModifier = if dimmed then DIMMED else 0
	end
end

function MoveGizmo.new(plot: BasePart, previewFolder: Instance, playerGui: Instance, callbacks: Callbacks): Gizmo
	local proxy = Instance.new("Part")
	proxy.Name = "MoveBounds"
	proxy.Anchored = true
	proxy.CanCollide = false
	proxy.CanQuery = false
	proxy.CanTouch = false
	proxy.CastShadow = false
	proxy.Transparency = 1
	proxy.Parent = previewFolder

	-- Handles получают события мыши, только когда лежат в PlayerGui.
	local handles = Instance.new("Handles")
	handles.Name = "MoveHandles"
	handles.Style = Enum.HandlesStyle.Movement
	handles.Faces = Faces.new(
		Enum.NormalId.Right,
		Enum.NormalId.Left,
		Enum.NormalId.Top,
		Enum.NormalId.Bottom,
		Enum.NormalId.Front,
		Enum.NormalId.Back
	)
	handles.Color3 = BuildConfig.MoveHandlesColor
	handles.Visible = false
	handles.Parent = playerGui

	local selected: PVInstance? = nil
	local drag: Drag? = nil
	local pending: Drag? = nil -- перенос отправлен, ждём, пока сервер сдвинет блок
	local pendingDeadline = 0
	local hovered: { [Enum.NormalId]: boolean } = {}
	local connections: { RBXScriptConnection } = {}

	local function placeProxy(center: Vector3, extents: Vector3)
		proxy.Size = extents + Vector3.one * PROXY_MARGIN
		proxy.CFrame = plot.CFrame * CFrame.new(center)
	end

	local function release(d: Drag)
		local ghost = d.ghost
		if ghost then
			ghost:Destroy()
		end
		setDimmed(d.block, false)
	end

	local function cancelActive()
		if drag then
			release(drag)
			drag = nil
		end
		if pending then
			release(pending)
			pending = nil
		end
	end

	local function select(block: Instance?)
		local target: PVInstance? = if block and block:IsA("PVInstance") then block else nil
		if target == selected then
			return
		end
		cancelActive()
		table.clear(hovered)
		selected = target
		handles.Adornee = if target then proxy else nil
		handles.Visible = target ~= nil
		if target then
			local center, extents = BuildGrid.getBlockBounds(plot, target)
			if center and extents then
				placeProxy(center, extents)
			end
		end
	end

	local function beginDrag()
		local block = selected
		if not block or drag then
			return
		end
		if pending then
			release(pending)
			pending = nil
		end
		local center, extents = BuildGrid.getBlockBounds(plot, block)
		if not center or not extents then
			return
		end
		local ghost = makeGhost(block, previewFolder)
		tint(ghost, BuildConfig.GhostValidColor)
		setDimmed(block, true)
		drag = {
			block = block,
			startPivot = block:GetPivot(),
			center = center,
			extents = extents,
			offset = Vector3.zero,
			shown = Vector3.zero,
			valid = true,
			ghost = ghost,
		}
	end

	-- distance — путь мыши вдоль стрелки от начала перетаскивания (в студах).
	local function onDrag(face: Enum.NormalId, distance: number)
		local d = drag
		if not d then
			return
		end
		local normal = Vector3.FromNormalId(face)
		local axis = if normal.X ~= 0 then 1 elseif normal.Y ~= 0 then 2 else 3
		local sign = normal.X + normal.Y + normal.Z
		local amount = BuildGrid.snapMove(plot, d.center, d.extents, axis, sign * distance, callbacks.getGridStep())
		local offset = normal * (sign * amount)
		if offset == d.offset then
			return
		end
		d.offset = offset
		d.valid = amount == 0
			or (
				BuildGrid.isInsideArea(plot, d.center + offset, d.extents)
				and not BuildGrid.isMoveBlocked(plot, d.block, offset)
			)
		tint(d.ghost, if d.valid then BuildConfig.GhostValidColor else BuildConfig.GhostInvalidColor)
	end

	local function finishDrag()
		local d = drag
		if not d then
			return
		end
		drag = nil
		if d.offset.Magnitude < 1e-3 then
			release(d)
		elseif not d.valid then
			callbacks.notify("Сюда передвинуть нельзя: блок выходит за плиту или задевает другой блок")
			release(d)
		else
			callbacks.commit(d.block, d.offset)
			d.shown = d.offset
			pending = d
			pendingDeadline = os.clock() + BuildConfig.MovePendingTimeout
		end
	end

	local function showAt(d: Drag)
		local ghost = d.ghost
		if ghost then
			local target = d.startPivot.Position + plot.CFrame:VectorToWorldSpace(d.shown)
			BuildGrid.shiftBlock(ghost, target - ghost:GetPivot().Position)
		end
		placeProxy(d.center + d.shown, d.extents)
	end

	local function update(dt: number)
		local block = selected
		if not block then
			return
		end
		if not block:IsDescendantOf(plot) then
			select(nil) -- блок снесли или заменили (резак)
			return
		end

		local d, p = drag, pending
		if d then
			local alpha = 1 - math.exp(-BuildConfig.GhostFollowSpeed * dt)
			d.shown = d.shown:Lerp(d.offset, alpha)
			showAt(d)
		elseif p then
			showAt(p)
			local moved = (block:GetPivot().Position - p.startPivot.Position).Magnitude > 1e-3
			if moved or os.clock() > pendingDeadline then
				release(p)
				pending = nil
			end
		else
			local center, extents = BuildGrid.getBlockBounds(plot, block)
			if center and extents then
				placeProxy(center, extents)
			end
		end
	end

	table.insert(
		connections,
		handles.MouseEnter:Connect(function(face: Enum.NormalId)
			hovered[face] = true
		end)
	)
	table.insert(
		connections,
		handles.MouseLeave:Connect(function(face: Enum.NormalId)
			hovered[face] = nil
		end)
	)
	table.insert(connections, handles.MouseButton1Down:Connect(beginDrag))
	table.insert(connections, handles.MouseDrag:Connect(onDrag))
	table.insert(connections, handles.MouseButton1Up:Connect(finishDrag))
	-- MouseButton1Up не приходит, если кнопку отпустили мимо стрелки.
	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input: InputObject)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				finishDrag()
			end
		end)
	)

	return {
		select = select,
		getSelected = function(): Instance?
			return selected
		end,
		isBusy = function(): boolean
			return drag ~= nil or next(hovered) ~= nil
		end,
		update = update,
		destroy = function()
			cancelActive()
			for _, connection in connections do
				connection:Disconnect()
			end
			handles:Destroy()
			proxy:Destroy()
		end,
	}
end

return MoveGizmo
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD51"><Properties><string name="Name">PaintMenuController</string><string name="Source"><![CDATA[--!strict
-- PaintMenuController: логика меню «Покраска / Скрижали».
--   * хранит «кисть» — что сделает ЛКМ по блоку: покрасить материалом, повесить скрижаль
--     или очистить грань от скрижалей;
--   * BuildHudController открывает и закрывает меню, BuildController читает кисть (getBrush)
--     и отправляет действие на сервер.
-- Как и BuildSettingsController, модуль один на клиента: кисть переживает закрытие меню.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)
local PaintMenuView = require(script.Parent.PaintMenuView)
local Theme = require(script.Parent.Theme)

export type BrushKind = "Material" | "Tablet" | "Erase"

export type Brush = {
	kind: BrushKind,
	id: string?, -- id материала или скрижали (у «Очистить грань» — nil)
}

local HINTS: { [string]: string } = {
	[PaintMenuView.MaterialsTabId] = "Выберите материал, затем ЛКМ по блоку или детали составного блока",
	[PaintMenuView.TabletsTabId] = "Выберите скрижаль, затем ЛКМ по грани блока. ★ — скрижаль вашей фракции",
}

local PaintMenuController = {}

local changed = Instance.new("BindableEvent")

-- Срабатывает при смене кисти.
PaintMenuController.Changed = changed.Event

local view: PaintMenuView.View? = nil
local opened = false
local tabId = PaintMenuView.MaterialsTabId
local brush: Brush? = nil
local factionId: string? = nil

local function setStroke(button: GuiObject, selected: boolean)
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = if selected then Theme.SelectedStroke else Theme.PanelStroke
		stroke.Thickness = if selected then Theme.StrokeThickness + 2 else Theme.StrokeThickness
	end
end

local function isBrush(kind: BrushKind, id: string?): boolean
	local b = brush
	return b ~= nil and b.kind == kind and b.id == id
end

local function refresh()
	local v = view
	if not v then
		return
	end
	for id, button in v.tabButtons do
		setStroke(button, id == tabId)
	end
	for id, page in v.pages do
		page.Visible = id == tabId
	end
	v.hintLabel.Text = HINTS[tabId] or ""

	for id, button in v.materialTiles do
		setStroke(button, isBrush("Material", id))
	end
	for _, tablet in PaintCatalog.Tablets do
		local tile = v.tabletTiles[tablet.id]
		if tile then
			local featured = tablet.factionId == factionId
			tile.star.Visible = featured
			tile.button.LayoutOrder = if featured then 0 else table.find(PaintCatalog.Tablets, tablet) or 1
			setStroke(tile.button, isBrush("Tablet", tablet.id))
		end
	end
	setStroke(v.eraseButton, isBrush("Erase", nil))
end

function PaintMenuController.close()
	opened = false
	local v = view
	if v then
		v.frame.Visible = false
	end
end

function PaintMenuController.open()
	local v = view
	if not v or opened then
		return
	end
	opened = true
	v.frame.Position = PaintMenuView.HiddenPosition
	v.frame.Visible = true
	TweenService:Create(v.frame, Theme.TweenInfo, { Position = PaintMenuView.ShownPosition }):Play()
end

function PaintMenuController.isOpen(): boolean
	return opened
end

function PaintMenuController.getBrush(): Brush?
	return brush
end

-- Отмечает ★ скрижаль фракции участка и ставит её первой.
function PaintMenuController.setFaction(value: string?)
	factionId = value
	refresh()
end

-- Выбор кисти закрывает меню: дальше игрок кликает по блокам.
local function pick(kind: BrushKind, id: string?)
	brush = { kind = kind, id = id }
	refresh()
	PaintMenuController.close()
	changed:Fire()
end

-- Создаёт окно внутри ScreenGui строительной панели (один раз).
function PaintMenuController.attach(gui: ScreenGui)
	if view then
		return
	end
	local created = PaintMenuView.build(gui)
	view = created

	for id, button in created.tabButtons do
		button.Activated:Connect(function()
			tabId = id
			refresh()
		end)
	end
	for id, button in created.materialTiles do
		button.Activated:Connect(function()
			pick("Material", id)
		end)
	end
	for id, tile in created.tabletTiles do
		tile.button.Activated:Connect(function()
			pick("Tablet", id)
		end)
	end
	created.eraseButton.Activated:Connect(function()
		pick("Erase", nil)
	end)
	created.closeButton.Activated:Connect(PaintMenuController.close)

	refresh()
end

return PaintMenuController
]]></string></Properties></Item>
<Item class="ModuleScript" referent="RBXBUILD52"><Properties><string name="Name">PaintMenuView</string><string name="Source"><![CDATA[--!strict
-- PaintMenuView: окно «Покраска / Скрижали» над строительной панелью.
-- Две вкладки: образцы материалов и карточки скрижалей (плюс «Очистить грань»).
-- Только создаёт GUI; выбор кисти и открытие/закрытие — в PaintMenuController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PaintCatalog = require(ReplicatedStorage.Shared.PaintCatalog)
local Theme = require(script.Parent.Theme)
local UIFactory = require(script.Parent.UIFactory)

export type TabletTile = {
	button: TextButton,
	star: TextLabel, -- ★ скрижаль фракции игрока
}

export type View = {
	frame: Frame,
	closeButton: TextButton,
	tabButtons: { [string]: TextButton }, -- id вкладки -> кнопка
	pages: { [string]: Frame }, -- id вкладки -> страница
	materialTiles: { [string]: TextButton }, -- id материала -> образец
	tabletTiles: { [string]: TabletTile }, -- id скрижали -> карточка
	eraseButton: TextButton,
	hintLabel: TextLabel,
}

local MENU_SIZE = Vector2.new(680, 330)
local TAB_SIZE = Vector2.new(210, 30)
local SWATCH_TILE = Vector2.new(100, 104)
local TABLET_TILE = Vector2.new(210, 150)
local GAP = 8
local PAGE_TOP = 44 + TAB_SIZE.Y + 10
local HINT_HEIGHT = 22

local PaintMenuView = {}

PaintMenuView.MaterialsTabId = "Materials"
PaintMenuView.TabletsTabId = "Tablets"

PaintMenuView.Tabs = {
	{ id = PaintMenuView.MaterialsTabId, label = "Материалы и Цвета" },
	{ id = PaintMenuView.TabletsTabId, label = "Древние Скрижали" },
}

-- Над нижней панелью, на месте каталога блоков (одновременно они не открываются).
PaintMenuView.ShownPosition = UDim2.new(0.5, 0, 1, -136)
PaintMenuView.HiddenPosition = UDim2.new(0.5, 0, 1, -116)

local function fitText(label: TextLabel, maxTextSize: number)
	label.TextScaled = true
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = maxTextSize
	constraint.Parent = label
end

local function horizontalRow(name: string, parent: Instance): Frame
	local row = Instance.new("Frame")
	row.Name = name
	row.BackgroundTransparency = 1
	row.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, GAP)
	layout.Parent = row
	return row
end

local function buildSwatch(material: PaintCatalog.Material, order: number, parent: Instance): TextButton
	local button = UIFactory.button(material.id .. "Swatch", "", Theme.SecondaryButtonColor, parent)
	button.Size = UDim2.fromOffset(SWATCH_TILE.X, SWATCH_TILE.Y)
	button.LayoutOrder = order

	local sample = Instance.new("Frame")
	sample.Name = "Sample"
	sample.Position = UDim2.fromOffset(10, 10)
	sample.Size = UDim2.new(1, -20, 0, 56)
	sample.BackgroundColor3 = material.color
	sample.BorderSizePixel = 0
	sample.Parent = button

	local corner = Instance.new("UICorner")
	corner.CornerRadius = Theme.CornerRadius
	corner.Parent = sample

	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.PanelStroke
	stroke.Thickness = 1
	stroke.Parent = sample

	local name = UIFactory.label("SwatchName", material.displayName, 18, button)
	name.Position = UDim2.fromOffset(6, 70)
	name.Size = UDim2.new(1, -12, 0, 26)
	fitText(name, 19)
	return button
end

local function buildTabletTile(tablet: PaintCatalog.Tablet, order: number, parent: Instance): TabletTile
	local button = UIFactory.button(tablet.id .. "Tablet", "", Theme.SecondaryButtonColor, parent)
	button.Size = UDim2.fromOffset(TABLET_TILE.X, TABLET_TILE.Y)
	button.LayoutOrder = order

	local title = UIFactory.label("TabletTitle", tablet.title, 18, button)
	title.Position = UDim2.fromOffset(8, 8)
	title.Size = UDim2.new(1, -16, 0, 26)
	fitText(title, 19)

	local faction = UIFactory.label("TabletFaction", tablet.factionName, 14, button)
	faction.Font = Theme.BodyFont
	faction.TextColor3 = Theme.PanelStroke
	faction.Position = UDim2.fromOffset(8, 34)
	faction.Size = UDim2.new(1, -16, 0, 18)

	local excerpt = UIFactory.label("TabletText", "«" .. tablet.text .. "»", 13, button)
	excerpt.Font = Theme.BodyFont
	excerpt.TextColor3 = Theme.SubTextColor
	excerpt.TextYAlignment = Enum.TextYAlignment.Top
	excerpt.Position = UDim2.fromOffset(8, 56)
	excerpt.Size = UDim2.new(1, -16, 1, -64)
	fitText(excerpt, 14)

	local star = UIFactory.label("Featured", "★", 16, button)
	star.AnchorPoint = Vector2.new(1, 0)
	star.Position = UDim2.new(1, -4, 0, 2)
	star.Size = UDim2.fromOffset(18, 18)
	star.TextColor3 = Theme.PanelStroke
	star.Visible = false

	return { button = button, star = star }
end

function PaintMenuView.build(gui: ScreenGui): View
	local frame = UIFactory.panel("PaintMenu", UDim2.fromOffset(MENU_SIZE.X, MENU_SIZE.Y), gui)
	frame.AnchorPoint = Vector2.new(0.5, 1)
	frame.Position = PaintMenuView.HiddenPosition
	frame.Active = true -- клики по фону меню не уходят в мир
	frame.Visible = false

	local title = UIFactory.label("Title", "Покраска и скрижали", 22, frame)
	title.Position = UDim2.fromOffset(14, 8)
	title.Size = UDim2.new(0.6, 0, 0, 28)
	title.TextXAlignment = Enum.TextXAlignment.Left

	local closeButton = UIFactory.button("Close", "✕", Theme.SecondaryButtonColor, frame)
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -10, 0, 8)
	closeButton.Size = UDim2.fromOffset(32, 30)

	-- Вкладки.
	local tabsRow = horizontalRow("Tabs", frame)
	tabsRow.Position = UDim2.fromOffset(12, 44)
	tabsRow.Size = UDim2.new(1, -24, 0, TAB_SIZE.Y)
	local tabsLayout = tabsRow:FindFirstChildOfClass("UIListLayout")
	if tabsLayout then
		tabsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end

	local tabButtons: { [string]: TextButton } = {}
	local pages: { [string]: Frame } = {}
	for index, tab in PaintMenuView.Tabs do
		local button = UIFactory.button(tab.id .. "Tab", tab.label, Theme.SecondaryButtonColor, tabsRow)
		button.Size = UDim2.fromOffset(TAB_SIZE.X, TAB_SIZE.Y)
		button.LayoutOrder = index
		button.TextSize = 16
		tabButtons[tab.id] = button

		local page = Instance.new("Frame")
		page.Name = tab.id .. "Page"
		page.BackgroundTransparency = 1
		page.Position = UDim2.fromOffset(12, PAGE_TOP)
		page.Size = UDim2.new(1, -24, 1, -(PAGE_TOP + HINT_HEIGHT + 12))
		page.Visible = false
		page.Parent = frame
		pages[tab.id] = page
	end

	-- Страница материалов: ряд образцов.
	local swatchRow = horizontalRow("Swatches", pages[PaintMenuView.MaterialsTabId])
	swatchRow.Position = UDim2.fromOffset(0, 24)
	swatchRow.Size = UDim2.new(1, 0, 0, SWATCH_TILE.Y)

	local materialTiles: { [string]: TextButton } = {}
	for index, material in PaintCatalog.Materials do
		materialTiles[material.id] = buildSwatch(material, index, swatchRow)
	end

	-- Страница скрижалей: карточки и «Очистить грань» под ними.
	local tabletsPage = pages[PaintMenuView.TabletsTabId]
	local tabletRow = horizontalRow("Tablets", tabletsPage)
	tabletRow.Size = UDim2.new(1, 0, 0, TABLET_TILE.Y)

	local tabletTiles: { [string]: TabletTile } = {}
	for index, tablet in PaintCatalog.Tablets do
		tabletTiles[tablet.id] = buildTabletTile(tablet, index, tabletRow)
	end

	local eraseButton = UIFactory.button("ErasePlaque", "Очистить грань", Theme.PrimaryButtonColor, tabletsPage)
	eraseButton.TextSize = 18
	eraseButton.AnchorPoint = Vector2.new(0.5, 1)
	eraseButton.Position = UDim2.new(0.5, 0, 1, 0)
	eraseButton.Size = UDim2.fromOffset(240, 34)

	local hintLabel = UIFactory.label("Hint", "", 15, frame)
	hintLabel.Font = Theme.BodyFont
	hintLabel.TextColor3 = Theme.SubTextColor
	hintLabel.AnchorPoint = Vector2.new(0.5, 1)
	hintLabel.Position = UDim2.new(0.5, 0, 1, -8)
	hintLabel.Size = UDim2.new(1, -24, 0, HINT_HEIGHT)
	fitText(hintLabel, 15)

	return {
		frame = frame,
		closeButton = closeButton,
		tabButtons = tabButtons,
		pages = pages,
		materialTiles = materialTiles,
		tabletTiles = tabletTiles,
		eraseButton = eraseButton,
		hintLabel = hintLabel,
	}
end

return PaintMenuView
]]></string></Properties></Item>
</Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="14">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="SpawnLocation" referent="15">
      <Properties>
        <string name="Name">Lobby</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">5855585</Color3uint8>
        <int name="Duration">0</int>
        <token name="Material">800</token>
        <Vector3 name="Position">
          <X>0</X>
          <Y>0.5</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>24</X>
          <Y>1</Y>
          <Z>24</Z>
        </Vector3>
      </Properties>
    </Item>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">Platforms</string>
      </Properties>
      <Item class="Part" referent="17">
        <Properties>
          <string name="Name">EgyptPlatform</string>
          <bool name="Anchored">true</bool>
          <Color3uint8 name="Color3uint8">14400893</Color3uint8>
          <token name="Material">1296</token>
          <Vector3 name="Position">
            <X>200</X>
            <Y>1</Y>
            <Z>0</Z>
          </Vector3>
          <Vector3 name="size">
            <X>80</X>
            <Y>2</Y>
            <Z>80</Z>
          </Vector3>
        </Properties>
      </Item>
      <Item class="Part" referent="18">
        <Properties>
